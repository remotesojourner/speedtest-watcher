root = true

[*]
indent_style = space
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.IDE0161.severity = warning
dotnet_diagnostic.IDE0005.severity = warning
dotnet_diagnostic.IDE1006.severity = warning

dotnet_diagnostic.CA1716.severity = none
dotnet_diagnostic.CA1720.severity = none
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1859.severity = none
dotnet_diagnostic.CA1873.severity = none

dotnet_naming_rule.private_instance_fields_are_underscore_camel_case.symbols = private_instance_fields
dotnet_naming_rule.private_instance_fields_are_underscore_camel_case.style = underscore_camel_case
dotnet_naming_rule.private_instance_fields_are_underscore_camel_case.severity = warning

dotnet_naming_rule.private_static_and_constant_fields_are_pascal_case.symbols = private_static_and_constant_fields
dotnet_naming_rule.private_static_and_constant_fields_are_pascal_case.style = pascal_case
dotnet_naming_rule.private_static_and_constant_fields_are_pascal_case.severity = warning

dotnet_naming_symbols.private_instance_fields.applicable_kinds = field
dotnet_naming_symbols.private_instance_fields.applicable_accessibilities = private

dotnet_naming_symbols.private_static_and_constant_fields.applicable_kinds = field
dotnet_naming_symbols.private_static_and_constant_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_static_and_constant_fields.required_modifiers = static

dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _

dotnet_naming_style.pascal_case.capitalization = pascal_case

[tests/**/*.cs]
dotnet_diagnostic.CA1001.severity = none
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1816.severity = none

[src/SpeedtestWatcher.Application/Storage/Migrations/*.cs]
generated_code = true
