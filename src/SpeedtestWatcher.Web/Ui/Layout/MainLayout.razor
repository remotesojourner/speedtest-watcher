@inherits LayoutComponentBase
@using System.Data.Common
@inject PreferencesService PreferencesService
@inject CircuitAccess CircuitAccess
@inject SettingsState Settings
@inject StatusStateService StatusService
@inject RecentResults RecentResults
@inject PauseService Pause
@inject LiveUpdates LiveUpdates
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject BrowserInterop Browser
@inject ILogger<MainLayout> Logger
@implements IDisposable

<MudThemeProvider Theme="AppTheme.Theme" @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider FullWidth="true" MaxWidth="MaxWidth.Small" />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Dense="true" Class="px-3">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@(() => _drawerOpen = !_drawerOpen)" aria-label="Toggle navigation" />
        <a href="" class="d-flex align-center" style="color:inherit;text-decoration:none;">
            <img src="img/logo.svg" style="width:28px;height:28px;object-fit:contain;margin-left:8px;" alt="" />
            <MudText Typo="Typo.h6" Class="ml-2 font-weight-bold" Style="letter-spacing:-0.5px;">Speedtest Watcher</MudText>
        </a>

        <MudSpacer />

        <div class="d-flex align-center gap-1">
            @if (_state == AppState.Ready && FullAccess)
            {
                <UpdateNotice />
            }
            @if (StatusService.Connection.IsDown)
            {
                <MudChip T="string" Icon="@Icons.Material.Filled.CloudOff" Color="Color.Error" Size="Size.Small" Href="uptime">Offline</MudChip>
            }
            @if (StatusService.Paused)
            {
                <MudChip T="string" Icon="@Icons.Material.Filled.PauseCircle" Color="Color.Warning" Size="Size.Small">Paused</MudChip>
            }
            @if (_state == AppState.Ready && !FullAccess)
            {
                <MudButton Variant="Variant.Text" Color="Color.Inherit" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Login" OnClick="SignIn">
                    Sign in
                </MudButton>
            }
            else if (_state == AppState.Ready)
            {
                <RunTestButton />
            }

            @if (_state == AppState.Ready && _signedInAs != null)
            {
                <AccountMenu Name="@_signedInAs" />
            }

            <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                           Color="Color.Inherit"
                           OnClick="ToggleThemeAsync"
                           aria-label="Toggle theme" />
        </div>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="1" Variant="DrawerVariant.Responsive">
        <MudNavMenu Class="pa-2">
            <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>
            <MudNavLink Href="history" Icon="@Icons.Material.Filled.History">History</MudNavLink>
            <MudNavLink Href="uptime" Icon="@Icons.Material.Filled.MonitorHeart">Uptime</MudNavLink>
            <MudNavLink Href="settings" Icon="@Icons.Material.Filled.Settings">Settings</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent Class="px-4 px-lg-6 pb-4 pb-lg-6 pt-16">
        <div style="max-width:1400px;margin:0 auto;width:100%;">
            @switch (_state)
            {
                case AppState.Loading:
                    <StateView Loading="true" />
                    break;
                case AppState.SignInRequired:
                    <div class="d-flex justify-center mt-12">
                        <SurfaceCard Icon="@Icons.Material.Filled.Lock" Title="Sign in required" FullHeight="false" Class="sw-narrow-card"
                                     Description="This Speedtest Watcher instance is protected. Sign in to continue.">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                                       StartIcon="@Icons.Material.Filled.Login" OnClick="SignIn">
                                Sign in
                            </MudButton>
                        </SurfaceCard>
                    </div>
                    break;
                case AppState.LoadFailed:
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-4">
                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold">Couldn't load Speedtest Watcher</MudText>
                        <MudText Typo="Typo.body2">The settings and results couldn't be read. Please try again.</MudText>
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" Class="mt-3" OnClick="LoadAsync">Try again</MudButton>
                    </MudAlert>
                    break;
                default:
                    <ErrorBoundary @ref="_pageErrors">
                        <ChildContent>
                            @Body
                        </ChildContent>
                        <ErrorContent>
                            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-4">
                                <MudText Typo="Typo.subtitle2" Class="font-weight-bold">Something went wrong</MudText>
                                <MudText Typo="Typo.body2">This page couldn't finish what it was doing. Please try again.</MudText>
                                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" Class="mt-3" OnClick="RecoverPage">Try again</MudButton>
                            </MudAlert>
                        </ErrorContent>
                    </ErrorBoundary>
                    break;
            }
        </div>
    </MudMainContent>
</MudLayout>

@code {
    private enum AppState { Loading, SignInRequired, LoadFailed, Ready }

    private AppState _state = AppState.Loading;
    private ErrorBoundary? _pageErrors;
    private string? _signedInAs;
    private bool _drawerOpen = true;
    private bool _isDarkMode = true;
    private bool _disposed;

    private bool FullAccess => CircuitAccess.Level == Access.Full;

    protected override void OnInitialized()
    {
        StatusService.OnChange += OnStateChanged;
        Settings.OnChange += OnStateChanged;
        LiveUpdates.ResultArrived += OnResultArrived;
    }

    protected override void OnParametersSet() => _pageErrors?.Recover();

    private void RecoverPage() => _pageErrors?.Recover();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _disposed) return;

        _isDarkMode = await Browser.GetLocalStorageAsync("theme") != "light";
        await PreferencesService.InitializeAsync();

        await CircuitAccess.StartAsync();
        if (CircuitAccess.SignedIn) _signedInAs = SignedInUser.DisplayName(CircuitAccess.User);

        LiveUpdates.Start(InvokeAsync);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _state = AppState.Loading;
        StateHasChanged();

        _state = await LoadStateAsync();
        if (_state == AppState.Ready && Settings.Current.Provider.Selected == SpeedtestProvider.None && FullAccess)
        {
            Navigation.NavigateTo("/welcome");
        }

        if (!_disposed) StateHasChanged();
    }

    private async Task<AppState> LoadStateAsync()
    {
        if (CircuitAccess.Level == Access.None) return AppState.SignInRequired;

        try
        {
            await Settings.LoadAsync();
            var status = Pause.GetStatus();
            StatusService.UpdateStatus(status.Running, status.Paused);
            await RecentResults.ReloadAsync();
            return AppState.Ready;
        }
        catch (Exception ex) when (ex is DbException or InvalidOperationException)
        {
            Logger.LogError(ex, "The settings and results couldn't be loaded");
            return AppState.LoadFailed;
        }
    }

    private void OnStateChanged()
    {
        if (!_disposed) InvokeAsync(StateHasChanged);
    }

    private void OnResultArrived(SpeedtestDto test)
    {
        if (test.Status == TestStatus.Skipped)
            Snackbar.Add($"Speedtest skipped: {test.Error}", Severity.Info);
        else if (test.Status == TestStatus.Failed)
            Snackbar.Add(SpeedtestErrors.Describe(test.Error), Severity.Error);
        else
            Snackbar.Add($"Speedtest complete: ↓ {test.Download:F1} Mbps  ↑ {test.Upload:F1} Mbps", Severity.Success);
    }

    private void SignIn()
    {
        var returnUrl = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.NavigateTo($"/auth/login?returnUrl={Uri.EscapeDataString(returnUrl)}", forceLoad: true);
    }

    private async Task ToggleThemeAsync()
    {
        _isDarkMode = !_isDarkMode;
        await Browser.SetLocalStorageAsync("theme", _isDarkMode ? "dark" : "light");
    }

    public void Dispose()
    {
        _disposed = true;
        StatusService.OnChange -= OnStateChanged;
        Settings.OnChange -= OnStateChanged;
        LiveUpdates.ResultArrived -= OnResultArrived;
    }
}
