@if (Loading)
{
    <div class="text-center @(Compact ? "pa-4" : "pa-12")">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="@(Compact ? Size.Small : Size.Large)" />
    </div>
}
else if (ErrorMessage != null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
        <div class="d-flex flex-wrap align-center justify-space-between gap-3">
            <span>@ErrorMessage</span>
            @if (OnRetry.HasDelegate)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="OnRetry">
                    @WebStrings.TryAgain
                </MudButton>
            }
        </div>
    </MudAlert>
}
else if (Empty)
{
    <MudAlert Severity="@Severity" Variant="Variant.Outlined">
        @if (EmptyContent != null)
        {
            @EmptyContent
        }
        else
        {
            @EmptyMessage
        }
    </MudAlert>
}
else
{
    @ChildContent
}

@code {
    [Parameter] public bool Loading { get; set; }
    [Parameter] public bool Empty { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public EventCallback OnRetry { get; set; }
    [Parameter] public string EmptyMessage { get; set; } = WebStrings.StateViewNothingToShow;
    [Parameter] public RenderFragment? EmptyContent { get; set; }
    [Parameter] public Severity Severity { get; set; } = Severity.Info;
    [Parameter] public bool Compact { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
