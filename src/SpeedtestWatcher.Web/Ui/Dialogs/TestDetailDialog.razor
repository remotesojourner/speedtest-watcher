@inject ResultsService Results
@inject RecentResults RecentResults
@inject ICurrentAccess Access
@inject ISnackbar Snackbar
@inject PreferencesService PreferencesService

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@(IsSkipped ? Icons.Material.Filled.RemoveCircleOutline : IsFailed ? Icons.Material.Filled.ErrorOutline : Icons.Material.Filled.Speed)"
                     Color="@(IsSkipped ? Color.Default : IsFailed ? Color.Error : Color.Primary)" />
            <MudText Typo="Typo.h6">@(IsSkipped ? WebStrings.TestDetailSkippedTitle : IsFailed ? WebStrings.TestDetailFailedTitle : WebStrings.TestDetailTitle)</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        @if (Test != null)
        {
            @if (IsSkipped)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
                    <MudText Typo="Typo.body2" Class="font-weight-bold">@WebStrings.TestDetailSkipped</MudText>
                    <MudText Typo="Typo.caption" Class="d-block mt-1">@Test.Error</MudText>
                </MudAlert>
            }
            else if (IsFailed)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">
                    <MudText Typo="Typo.body2" Class="font-weight-bold">@SpeedtestErrors.Describe(Test.Error)</MudText>
                    <MudText Typo="Typo.caption" Class="d-block mt-1">@WebStrings.TestDetailFailedHint</MudText>
                </MudAlert>
                <DataRow Label="@WebStrings.TestDetailErrorDetails">
                    <MudText Typo="Typo.caption" Class="sw-muted text-end" Style="max-width:70%;word-break:break-word;">@Test.Error</MudText>
                </DataRow>
            }
            else
            {
                <div class="d-flex flex-wrap align-end justify-space-between gap-6 mb-5">
                    <MetricDisplay Size="MetricSize.Hero" Dense="true" Color="@MetricStatus.Download(Test.Download, Test.ThresholdDownload)"
                                   Value="@($"{PreferencesService.ConvertSpeed(Test.Download):F1}")"
                                   Unit="@PreferencesService.SpeedUnit"
                                   Label="@WebStrings.DownloadSpeed" />

                    <div class="d-flex flex-wrap gap-5">
                        <MetricDisplay Size="MetricSize.Large" Dense="true" Color="@MetricStatus.Upload(Test.Upload, Test.ThresholdUpload)" Icon="@Icons.Material.Filled.Upload"
                                       Value="@($"{PreferencesService.ConvertSpeed(Test.Upload):F1}")"
                                       Label="@WebStrings.Format(WebStrings.UploadUnit, PreferencesService.SpeedUnit)" />

                        <MetricDisplay Size="MetricSize.Large" Dense="true" Color="@MetricStatus.Ping(Test.Ping, Test.ThresholdPing)" Icon="@Icons.Material.Filled.NetworkPing"
                                       Value="@($"{Test.Ping}")"
                                       Label="@(Test.Jitter.HasValue ? WebStrings.Format(WebStrings.PingMsWithJitter, Test.Jitter) : WebStrings.PingMs)" />

                        <MetricDisplay Size="MetricSize.Large" Dense="true" Icon="@Icons.Material.Filled.Timer"
                                       Value="@($"{Test.Time}")"
                                       Label="@WebStrings.TestDetailDuration" />
                    </div>
                </div>
                <MudDivider Class="mb-3" />
            }

            @if (Test.PacketLoss is { } packetLoss)
            {
                <DataRow Label="@WebStrings.PacketLoss">
                    <MudText Typo="Typo.body2" Color="@MetricStatus.PacketLoss(packetLoss, Test.ThresholdPacketLoss)">@($"{packetLoss:F2}%")</MudText>
                </DataRow>
            }
            @if (Test.Bufferbloat is { } bufferbloat)
            {
                <DataRow Label="@WebStrings.Bufferbloat">
                    <MudText Typo="Typo.body2" Color="@MetricStatus.Bufferbloat(bufferbloat, Test.ThresholdBufferbloat)">
                        @($"+{bufferbloat:F0} ms")
                    </MudText>
                    <MudText Typo="Typo.caption" Class="sw-muted ml-2">@BufferbloatDetail</MudText>
                </DataRow>
            }
            @if (Test.DownloadBytes + Test.UploadBytes is { } dataUsed)
            {
                <DataRow Label="@WebStrings.TestDetailDataUsed" Value="@ByteSize.Describe(dataUsed)" />
            }
            @if (Access.HasFullAccess && !string.IsNullOrEmpty(Test.PublicIp))
            {
                <DataRow Label="@WebStrings.TestDetailPublicIp" Value="@Test.PublicIp" />
            }
            @if (MissedTargets.Count > 0)
            {
                <DataRow Label="@WebStrings.TestDetailMissedTargets" Value="@MissedTargetsText" />
            }
            <DataRow Label="@WebStrings.TestDetailTime" Value="@PreferencesService.FormatDateTime(PreferencesService.ToLocal(Test.Created))" />
            <DataRow Label="@WebStrings.TestDetailStarted">
                <MudChip T="string" Size="Size.Small" Color="@(IsManual ? Color.Info : Color.Default)">
                    @(IsManual ? WebStrings.TestDetailStartedManually : WebStrings.TestDetailStartedAutomatically)
                </MudChip>
            </DataRow>
            @if (!string.IsNullOrEmpty(Test.ServerName))
            {
                <DataRow Label="@WebStrings.Server" Value="@Test.ServerName" />
            }
            @if (!string.IsNullOrEmpty(Test.ResultId))
            {
                <DataRow Label="@WebStrings.TestDetailResult">
                    <MudLink Href="@($"https://www.speedtest.net/result/c/{Test.ResultId}")" Target="_blank">@WebStrings.TestDetailViewOnSpeedtestNet</MudLink>
                </DataRow>
            }
        }
    </DialogContent>
    <DialogActions>
        @if (Test != null && Access.HasFullAccess)
        {
            <MudButton Color="Color.Error" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Delete"
                       Disabled="_deleting" OnClick="DeleteTestAsync">
                @WebStrings.TestDetailDelete
            </MudButton>
        }
        <MudSpacer />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => MudDialog.Close())">@WebStrings.Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public SpeedtestDto? Test { get; set; }

    private bool _deleting;

    private string BufferbloatDetail
    {
        get
        {
            if (Test is not { } test) return "";

            List<string> parts = [];
            if (test.BufferbloatDown is { } down) parts.Add(WebStrings.Format(WebStrings.TestDetailBufferbloatDown, down));
            if (test.BufferbloatUp is { } up) parts.Add(WebStrings.Format(WebStrings.TestDetailBufferbloatUp, up));
            if (test.LatencyIdle is { } idle && test.LatencyLoaded is { } loaded) parts.Add(WebStrings.Format(WebStrings.TestDetailLatencyIdleToLoaded, idle, loaded));
            if (test.LatencyLoadedTail is { } tail) parts.Add(WebStrings.Format(WebStrings.TestDetailLatencyWorst, tail));
            return string.Join(", ", parts);
        }
    }

    private bool IsManual => Test?.Type == TestType.Custom;

    private bool IsSkipped => Test?.Status == TestStatus.Skipped;

    private bool IsFailed => !IsSkipped && !string.IsNullOrEmpty(Test?.Error);

    private IReadOnlyList<TargetKind> MissedTargets => Test is { Status: TestStatus.Completed } test
        ? new TargetSettings(test.ThresholdPing, test.ThresholdDownload, test.ThresholdUpload, test.ThresholdPacketLoss, test.ThresholdBufferbloat)
            .Missed(new Readings(test.Ping, test.Download, test.Upload, test.PacketLoss, test.Bufferbloat))
        : [];

    private string MissedTargetsText => TargetSettings.Describe(MissedTargets) is { Length: > 0 } text
        ? char.ToUpperInvariant(text[0]) + text[1..]
        : "";

    private async Task DeleteTestAsync()
    {
        if (Test == null) return;

        _deleting = true;
        var result = await Results.DeleteAsync(Test.Id);
        _deleting = false;

        if (!result.Succeeded)
        {
            Snackbar.Add(WebStrings.TestDetailDeleteFailed, Severity.Error);
            return;
        }

        RecentResults.Remove(Test.Id);
        Snackbar.Add(WebStrings.TestDetailDeleted, Severity.Success);
        MudDialog.Close(DialogResult.Ok(true));
    }
}
