@inject ProviderOptionsService ProviderOptions
@inject SpeedtestRunService Runs
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="sw-muted mb-3">
            @WebStrings.RunWithServerIntro
        </MudText>

        <MudSelect T="string" @bind-Value="_serverId" Label="@WebStrings.Server" Variant="Variant.Outlined" Margin="Margin.Dense"
                   Disabled="_loading" HelperText="@ServerListHelp">
            @foreach (var server in _servers)
            {
                <MudSelectItem T="string" Value="@server.Id">@server.OptionLabel</MudSelectItem>
            }
        </MudSelect>

        <MudTextField T="string" @bind-Value="_serverId" Label="@WebStrings.ServerId" Placeholder="@WebStrings.ServerIdPlaceholder"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Class="mt-3"
                      Error="@(!ServerIdValid)" ErrorText="@WebStrings.ServerIdInvalid"
                      HelperText="@WebStrings.RunWithServerServerIdHelp" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@WebStrings.Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!CanRun)" OnClick="RunAsync">@WebStrings.RunWithServerRun</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public SpeedtestProvider Provider { get; set; } = SpeedtestProvider.Ookla;

    private sealed record ServerOption(string Id, string OptionLabel);

    private List<ServerOption> _servers = [];
    private string _serverId = "";
    private bool _loading = true;
    private bool _running;
    private bool _serversUnavailable;

    private string ServerListHelp => _loading
        ? WebStrings.LoadingServers
        : _serversUnavailable ? WebStrings.RunWithServerListFailed : WebStrings.NearestServersFirst;

    private bool ServerIdValid => string.IsNullOrWhiteSpace(_serverId) || _serverId.Trim().All(char.IsDigit);

    private bool CanRun => !_running && !string.IsNullOrWhiteSpace(_serverId) && ServerIdValid;

    protected override async Task OnInitializedAsync()
    {
        var result = await ProviderOptions.GetServersAsync(Provider.ToName());
        _serversUnavailable = result.Value == null;
        _servers = ServerLabels.NearestFirst(result.Value ?? []).Select(server => new ServerOption(server.Id, ServerLabels.For(server))).ToList();
        _loading = false;
    }

    private async Task RunAsync()
    {
        _running = true;
        var result = await Runs.StartManualRunAsync(_serverId.Trim());
        _running = false;

        if (!result.Succeeded)
        {
            Snackbar.Add(result.Message ?? WebStrings.RunWithServerFailed, Severity.Error);
            return;
        }

        Snackbar.Add(WebStrings.SpeedtestStarted, Severity.Success);
        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Cancel() => MudDialog.Cancel();
}
