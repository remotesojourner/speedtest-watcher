@using System.Data.Common
@inject ResultsService Results
@inject BrowserInterop Browser
@inject PreferencesService PreferencesService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="font-weight-bold mb-2">@WebStrings.ExportResults</MudText>
        <div class="sw-option-list mb-4">
            <OptionCard Title="@WebStrings.ExportShownResults" Description="@ShownDescription" Icon="@Icons.Material.Filled.FilterList"
                        Active="@(_scope == ExportScope.Shown)" OnClick="@(() => _scope = ExportScope.Shown)" />
            <OptionCard Title="@WebStrings.ExportSelectedResults" Description="@SelectedDescription" Icon="@Icons.Material.Filled.Checklist"
                        Active="@(_scope == ExportScope.Selected)" Disabled="@(SelectedIds.Count == 0)"
                        OnClick="@(() => _scope = ExportScope.Selected)" />
            <OptionCard Title="@WebStrings.AllResults" Description="@AllDescription" Icon="@Icons.Material.Filled.AllInclusive"
                        Active="@(_scope == ExportScope.All)" OnClick="@(() => _scope = ExportScope.All)" />
        </div>

        <MudText Typo="Typo.body2" Class="font-weight-bold mb-2">@WebStrings.ExportFormat</MudText>
        <div class="sw-option-grid">
            <OptionCard Title="CSV" Description="@WebStrings.ExportCsvDescription" Icon="@Icons.Material.Filled.TableChart"
                        Active="@(_format == "csv")" OnClick="@(() => _format = "csv")" />
            <OptionCard Title="JSON" Description="@WebStrings.ExportJsonDescription" Icon="@Icons.Material.Filled.DataObject"
                        Active="@(_format == "json")" OnClick="@(() => _format = "json")" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">@WebStrings.Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Download"
                   Disabled="@(_exporting || ExportCount == 0)" OnClick="ExportAsync">
            @(_exporting ? WebStrings.ExportExporting : WebStrings.ExportButton)
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private enum ExportScope { Shown, Selected, All }

    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public TestStatus? Status { get; set; }
    [Parameter] public TestType? Type { get; set; }
    [Parameter] public bool? Healthy { get; set; }
    [Parameter] public IReadOnlyCollection<int> SelectedIds { get; set; } = [];

    private ExportScope _scope = ExportScope.Shown;
    private string _format = "csv";
    private int? _shownCount;
    private int? _allCount;
    private bool _counting = true;
    private bool _exporting;

    private bool FiltersActive => Status != null || Type != null || Healthy != null;

    private string CountPlaceholder => _counting ? WebStrings.ExportCounting : WebStrings.ExportCountFailed;

    private string ShownDescription => _shownCount is not { } count
        ? CountPlaceholder
        : FiltersActive
            ? WebStrings.Format(WebStrings.ExportMatchingFilters, ResultCount(count))
            : WebStrings.Format(WebStrings.ExportNoFilters, ResultCount(count));

    private string SelectedDescription => SelectedIds.Count == 0
        ? WebStrings.ExportSelectFirst
        : WebStrings.Format(WebStrings.SelectedCount, SelectedIds.Count);

    private string AllDescription => _allCount is { } count ? ResultCount(count) : CountPlaceholder;

    private int? ExportCount => _scope switch
    {
        ExportScope.Selected => SelectedIds.Count,
        ExportScope.All => _allCount,
        _ => _shownCount
    };

    protected override async Task OnInitializedAsync()
    {
        if (SelectedIds.Count > 0) _scope = ExportScope.Selected;

        _shownCount = await CountAsync(Status, Type, Healthy);
        _allCount = FiltersActive ? await CountAsync(null, null, null) : _shownCount;
        _counting = false;
    }

    private async Task<int?> CountAsync(TestStatus? status, TestType? type, bool? healthy)
    {
        try
        {
            return await Results.CountAsync(status, type, healthy);
        }
        catch (Exception ex) when (ex is DbException or InvalidOperationException)
        {
            return null;
        }
    }

    private async Task ExportAsync()
    {
        var request = _scope switch
        {
            ExportScope.Selected => new ExportRequest { Format = _format, Ids = SelectedIds.ToList() },
            ExportScope.All => new ExportRequest { Format = _format },
            _ => new ExportRequest { Format = _format, Status = Status, Type = Type, Healthy = Healthy }
        };

        _exporting = true;
        var file = await Results.ExportAsync(request);
        var fileName = $"speedtests-{_scope.ToString().ToLowerInvariant()}-{PreferencesService.Now:yyyyMMdd-HHmm}.{_format}";
        var downloaded = await Browser.DownloadAsync(fileName, file.Content);
        _exporting = false;

        if (!downloaded)
        {
            Snackbar.Add(WebStrings.ExportFailed, Severity.Error);
            return;
        }

        Snackbar.Add(WebStrings.Format(WebStrings.Exported, ResultCount(ExportCount ?? 0)), Severity.Success);
        MudDialog.Close(DialogResult.Ok(true));
    }

    private static string ResultCount(int count) =>
        count == 1 ? WebStrings.ExportOneResult : WebStrings.Format(WebStrings.ExportResultCount, count);
}
