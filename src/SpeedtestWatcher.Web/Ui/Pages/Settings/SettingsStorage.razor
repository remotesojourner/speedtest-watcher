@using System.Globalization
@using System.Text
@using System.Text.Json
@inject StorageService Storage
@inject ResultsService Results
@inject SettingsBackupService Backup
@inject SettingsState Settings
@inject RecentResults RecentResults
@inject NavigationManager Navigation
@inject BrowserInterop Browser
@inject ILogger<SettingsStorage> Logger
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudGrid Spacing="4">
    <MudItem xs="12" md="6">
        <SurfaceCard Icon="@Icons.Material.Filled.Storage" Title="@WebStrings.StorageDatabase">
            @if (_storageInfo != null)
            {
                <DataRow Label="@WebStrings.StorageStoredTests" Value="@_storageInfo.TestCount.ToString("N0", CultureInfo.CurrentCulture)" />
                <DataRow Label="@WebStrings.StorageDatabaseSize" Value="@ByteSize.Describe(_storageInfo.Size)" />
            }
            else if (_storageInfoFailed)
            {
                <StateView ErrorMessage="@WebStrings.StorageInfoFailed" OnRetry="LoadStorageInfoAsync" />
            }
            else
            {
                <StateView Loading="true" Compact="true" />
            }
        </SurfaceCard>
    </MudItem>

    <MudItem xs="12" md="6">
        <SurfaceCard Icon="@Icons.Material.Filled.History" Title="@WebStrings.StorageRetentionTitle"
                     Description="@WebStrings.StorageRetentionDescription">
            <MudSelect T="string" @bind-Value="_retentionChoice" Label="@WebStrings.StorageKeepFor" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3">
                @foreach (var preset in RetentionPresets)
                {
                    <MudSelectItem T="string" Value="@preset.Days.ToString(CultureInfo.InvariantCulture)">@preset.Label</MudSelectItem>
                }
                <MudSelectItem T="string" Value="@CustomChoice">@WebStrings.StorageRetentionCustom</MudSelectItem>
            </MudSelect>
            @if (_retentionChoice == CustomChoice)
            {
                <MudNumericField T="int" @bind-Value="_customDays" Label="@WebStrings.StorageDays" Min="0" Max="10000" Variant="Variant.Outlined" Margin="Margin.Dense"
                                 Immediate="true" HelperText="@WebStrings.StorageDaysHelp"
                                 Error="@(SelectedRetentionDays == null)" ErrorText="@WebStrings.StorageDaysInvalid" Class="mb-3" />
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!RetentionDirty)" OnClick="SaveRetentionAsync">
                @WebStrings.StorageSaveRetention
            </MudButton>
        </SurfaceCard>
    </MudItem>

    <MudItem xs="12" md="6">
        <SurfaceCard Icon="@Icons.Material.Filled.Speed" Title="@WebStrings.StorageResultsTitle"
                     Description="@WebStrings.Format(WebStrings.StorageResultsDescription, ProjectInfo.Name)">
            <div class="d-flex flex-wrap gap-2">
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.TableChart" OnClick="@(() => ExportTestsAsync("csv"))">
                    @WebStrings.StorageExportCsv
                </MudButton>
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.DataObject" OnClick="@(() => ExportTestsAsync("json"))">
                    @WebStrings.StorageExportJson
                </MudButton>
                <MudFileUpload T="IBrowserFile" @ref="_testsUpload" Accept=".json" MaxFileSize="MaxImportBytes" FilesChanged="ImportTestsAsync">
                    <SelectedTemplate />
                    <CustomContent>
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.UploadFile" Disabled="_importing"
                                   OnClick="@(() => _testsUpload!.OpenFilePickerAsync())">
                            @WebStrings.StorageImportJson
                        </MudButton>
                    </CustomContent>
                </MudFileUpload>
            </div>
        </SurfaceCard>
    </MudItem>

    <MudItem xs="12" md="6">
        <SurfaceCard Icon="@Icons.Material.Filled.Backup" Title="@WebStrings.StorageBackupTitle"
                     Description="@WebStrings.StorageBackupDescription">
            <div class="d-flex flex-wrap gap-2">
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download" OnClick="ExportConfigAsync">
                    @WebStrings.StorageExportSettings
                </MudButton>
                <MudFileUpload T="IBrowserFile" @ref="_configUpload" Accept=".json" MaxFileSize="MaxImportBytes" FilesChanged="ImportConfigAsync">
                    <SelectedTemplate />
                    <CustomContent>
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.UploadFile" Disabled="_importing"
                                   OnClick="@(() => _configUpload!.OpenFilePickerAsync())">
                            @WebStrings.StorageImportSettings
                        </MudButton>
                    </CustomContent>
                </MudFileUpload>
            </div>
        </SurfaceCard>
    </MudItem>

    <MudItem xs="12">
        <SurfaceCard Icon="@Icons.Material.Filled.Warning" Title="@WebStrings.StorageDangerZone" Danger="true" FullHeight="false"
                     Description="@WebStrings.StorageDangerZoneDescription">
            <div class="d-flex flex-wrap gap-3">
                <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.DeleteForever" OnClick="ClearHistoryAsync">
                    @WebStrings.StorageClearHistory
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.RestartAlt" OnClick="FactoryResetAsync">
                    @WebStrings.StorageFactoryReset
                </MudButton>
            </div>
        </SurfaceCard>
    </MudItem>
</MudGrid>

@code {
    private const string CustomChoice = "custom";
    private const long MaxImportBytes = 50 * 1024 * 1024;

    private static (int Days, string Label)[] RetentionPresets =>
    [
        (7, WebStrings.SevenDays),
        (30, WebStrings.ThirtyDays),
        (90, WebStrings.StorageRetention90Days),
        (180, WebStrings.StorageRetention180Days),
        (365, WebStrings.StorageRetentionOneYear),
        (0, WebStrings.StorageRetentionForever)
    ];

    private static readonly JsonSerializerOptions _webJson = new(JsonSerializerDefaults.Web);

    private StorageInfoDto? _storageInfo;
    private bool _storageInfoFailed;
    private MudFileUpload<IBrowserFile>? _testsUpload;
    private MudFileUpload<IBrowserFile>? _configUpload;
    private string _retentionChoice = "365";
    private int _customDays = 365;
    private bool _importing;

    private int SavedRetentionDays => Settings.Current.RetentionDays;

    private int? SelectedRetentionDays => _retentionChoice == CustomChoice
        ? (_customDays is >= 0 and <= SettingDefinitions.MaxRetentionDays ? _customDays : null)
        : int.Parse(_retentionChoice, CultureInfo.InvariantCulture);

    private bool RetentionDirty => SelectedRetentionDays is { } days && days != SavedRetentionDays;

    protected override async Task OnInitializedAsync()
    {
        ResetRetentionFromSettings();
        await LoadStorageInfoAsync();
    }

    private void ResetRetentionFromSettings()
    {
        var days = SavedRetentionDays;
        _retentionChoice = RetentionPresets.Any(p => p.Days == days) ? days.ToString(CultureInfo.InvariantCulture) : CustomChoice;
        _customDays = days;
    }

    private async Task LoadStorageInfoAsync()
    {
        var result = await Storage.GetInfoAsync();
        _storageInfo = result.Value;
        _storageInfoFailed = !result.Succeeded;
    }

    private async Task SaveRetentionAsync()
    {
        if (SelectedRetentionDays is not { } days) return;

        var result = await Settings.SaveAsync(("retentionDays", days.ToString(CultureInfo.InvariantCulture)));
        if (result.Succeeded) Snackbar.Add(WebStrings.StorageRetentionSaved, Severity.Success);
        else Snackbar.Add(result.Message ?? SettingsState.SaveFailed, Severity.Error);
    }

    private async Task ExportTestsAsync(string format)
    {
        var result = await Storage.ExportResultsAsync(format);
        await DownloadAsync(result.Value?.FileName ?? $"speedtests.{format}", result.Value?.Content);
    }

    private async Task ExportConfigAsync()
    {
        var result = await Backup.ExportAsync();
        await DownloadAsync("speedtest-watcher-settings.json", result.Value is { } backup ? JsonSerializer.SerializeToUtf8Bytes(backup, _webJson) : null);
    }

    private async Task DownloadAsync(string fileName, byte[]? content)
    {
        if (content != null && await Browser.DownloadAsync(fileName, content))
            Snackbar.Add(WebStrings.Format(WebStrings.Exported, fileName), Severity.Success);
        else
            Snackbar.Add(WebStrings.StorageExportFailed, Severity.Error);
    }

    private async Task ImportTestsAsync(IBrowserFile? file)
    {
        var rows = Deserialize<List<SpeedtestImportRow>>(await ReadJsonAsync(file, JsonValueKind.Array));
        if (rows == null)
        {
            Snackbar.Add(WebStrings.Format(WebStrings.StorageNotATestExport, ProjectInfo.Name), Severity.Error);
            return;
        }

        var result = await Results.ImportAsync(rows);
        if (result.Value is not { } counts)
        {
            Snackbar.Add(result.Message ?? WebStrings.StorageTestImportFailed, Severity.Error);
            return;
        }

        Snackbar.Add(TestImportSummary(counts), counts.Imported > 0 ? Severity.Success : Severity.Info);
        await LoadStorageInfoAsync();
        await RecentResults.ReloadAsync();
    }

    private static string TestImportSummary(TestImportResultDto counts) => (counts.Imported, counts.Skipped) switch
    {
        (0, var skipped) => WebStrings.Format(WebStrings.StorageNothingNew, AlreadyStored(skipped)),
        (var imported, 0) => WebStrings.Format(WebStrings.StorageImported, ResultCount(imported)),
        var (imported, skipped) => WebStrings.Format(WebStrings.StorageImportedSomeStored, ResultCount(imported), AlreadyStored(skipped))
    };

    private static string ResultCount(int count) =>
        count == 1 ? WebStrings.StorageOneResult : WebStrings.Format(WebStrings.StorageResultCount, count);

    private static string AlreadyStored(int count) =>
        count == 1 ? WebStrings.StorageOneAlreadyStored : WebStrings.Format(WebStrings.StorageAlreadyStored, count);

    private async Task ImportConfigAsync(IBrowserFile? file)
    {
        var backup = Deserialize<SettingsBackupDto>(await ReadJsonAsync(file, JsonValueKind.Object));
        if (backup == null)
        {
            Snackbar.Add(WebStrings.Format(WebStrings.StorageNotASettingsExport, ProjectInfo.Name), Severity.Error);
            return;
        }

        var result = await Backup.ImportAsync(backup);
        if (result.Value is not { } counts)
        {
            Snackbar.Add(result.Message ?? WebStrings.StorageSettingsImportFailed, Severity.Error);
            return;
        }

        await Settings.LoadAsync();
        ResetRetentionFromSettings();
        Snackbar.Add(SettingsImportSummary(counts), counts.Skipped > 0 ? Severity.Warning : Severity.Success);
    }

    private static string SettingsImportSummary(SettingsImportResultDto counts)
    {
        var restored = new List<string>
        {
            counts.Settings == 1 ? WebStrings.StorageOneSetting : WebStrings.Format(WebStrings.StorageSettingCount, counts.Settings)
        };
        if (counts.Integrations > 0)
        {
            restored.Add(counts.Integrations == 1 ? WebStrings.StorageOneIntegration : WebStrings.Format(WebStrings.StorageIntegrationCount, counts.Integrations));
        }
        if (counts.Recommendations) restored.Add(WebStrings.StorageRecommendations);

        var list = restored.Count > 1
            ? WebStrings.Format(WebStrings.ListAnd, string.Join(", ", restored.SkipLast(1)), restored[^1])
            : restored[0];
        var summary = WebStrings.Format(WebStrings.StorageImportedList, list);
        if (counts.Skipped == 0) return summary;

        var skipped = counts.Skipped == 1 ? WebStrings.StorageOneSkipped : WebStrings.Format(WebStrings.StorageSkippedCount, counts.Skipped);
        return $"{summary} {skipped}";
    }

    private static T? Deserialize<T>(string? json) where T : class
    {
        if (json == null) return null;

        try
        {
            return JsonSerializer.Deserialize<T>(json, _webJson);
        }
        catch (JsonException)
        {
            return null;
        }
    }

    private async Task<string?> ReadJsonAsync(IBrowserFile? file, JsonValueKind expectedRoot)
    {
        if (file == null) return null;

        _importing = true;
        try
        {
            await using var stream = file.OpenReadStream(MaxImportBytes);
            using var reader = new StreamReader(stream, Encoding.UTF8);
            var text = await reader.ReadToEndAsync();
            using var document = JsonDocument.Parse(text);
            return document.RootElement.ValueKind == expectedRoot ? text : null;
        }
        catch (JsonException)
        {
            return null;
        }
        catch (IOException ex)
        {
            Logger.LogWarning(ex, "Could not read the uploaded file {FileName}", file.Name);
            return null;
        }
        finally
        {
            _importing = false;
        }
    }

    private async Task ClearHistoryAsync()
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            WebStrings.StorageClearHistory,
            WebStrings.StorageClearHistoryMessage,
            yesText: WebStrings.StorageDeleteAll, cancelText: WebStrings.Cancel);
        if (confirmed != true) return;

        if (!(await Storage.DeleteAllResultsAsync()).Succeeded)
        {
            Snackbar.Add(WebStrings.StorageClearHistoryFailed, Severity.Error);
            return;
        }

        RecentResults.Clear();
        await LoadStorageInfoAsync();
        Snackbar.Add(WebStrings.StorageHistoryCleared, Severity.Success);
    }

    private async Task FactoryResetAsync()
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            WebStrings.StorageFactoryReset,
            WebStrings.StorageFactoryResetMessage,
            yesText: WebStrings.StorageReset, cancelText: WebStrings.Cancel);
        if (confirmed != true) return;

        if (!(await Storage.FactoryResetAsync()).Succeeded)
        {
            Snackbar.Add(WebStrings.StorageFactoryResetFailed, Severity.Error);
            return;
        }

        Navigation.NavigateTo("/", forceLoad: true);
    }

}
