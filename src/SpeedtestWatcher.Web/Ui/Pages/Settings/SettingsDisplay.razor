@inject PreferencesService PreferencesService
@inject SettingsState Settings
@inject ISnackbar Snackbar

<SurfaceCard Icon="@Icons.Material.Filled.Tune" Title="@WebStrings.DisplayTitle" FullHeight="false"
             Description="@WebStrings.DisplayDescription">
    <MudGrid Spacing="4">
        <MudItem xs="12" md="6">
            <MudText Typo="Typo.body2" Class="font-weight-bold mb-2">@WebStrings.DisplayTimeFormat</MudText>
            <div class="sw-option-list">
                <OptionCard Title="@WebStrings.Display24Hour" Description="@WebStrings.Display24HourDescription" Icon="@Icons.Material.Filled.Schedule"
                            Active="@(PreferencesService.TimeFormat == "24h")"
                            OnClick="@(() => SavePreferencesAsync("24h", PreferencesService.SpeedUnit))" />
                <OptionCard Title="@WebStrings.Display12Hour" Description="@WebStrings.Display12HourDescription" Icon="@Icons.Material.Filled.Schedule"
                            Active="@(PreferencesService.TimeFormat == "12h")"
                            OnClick="@(() => SavePreferencesAsync("12h", PreferencesService.SpeedUnit))" />
            </div>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudText Typo="Typo.body2" Class="font-weight-bold mb-2">@WebStrings.DisplaySpeedUnit</MudText>
            <div class="sw-option-list">
                <OptionCard Title="Mbps" Description="@WebStrings.DisplayMbpsDescription" Icon="@Icons.Material.Filled.Speed"
                            Active="@(PreferencesService.SpeedUnit == "mbps")"
                            OnClick="@(() => SavePreferencesAsync(PreferencesService.TimeFormat, "mbps"))" />
                <OptionCard Title="MB/s" Description="@WebStrings.DisplayMBytesDescription" Icon="@Icons.Material.Filled.Speed"
                            Active="@(PreferencesService.SpeedUnit == "mbytes")"
                            OnClick="@(() => SavePreferencesAsync(PreferencesService.TimeFormat, "mbytes"))" />
            </div>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudText Typo="Typo.body2" Class="font-weight-bold mb-2">@WebStrings.DisplayDateFormat</MudText>
            <div class="sw-option-list">
                @foreach (var option in DateFormats)
                {
                    <OptionCard Title="@option.Title" Description="@Example(option.Id)" Icon="@Icons.Material.Filled.CalendarMonth"
                                Active="@(DateFormat == option.Id)" OnClick="@(() => SaveSettingAsync("dateFormat", option.Id, DateFormat))" />
                }
            </div>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudText Typo="Typo.body2" Class="font-weight-bold mb-2">@WebStrings.DisplayDashboardCharts</MudText>
            <div class="sw-option-list mb-3">
                @foreach (var option in ChartRanges)
                {
                    <OptionCard Title="@option.Title" Description="@option.Description" Icon="@Icons.Material.Filled.DateRange"
                                Active="@(ChartRange == option.Id)" OnClick="@(() => SaveSettingAsync("chartRange", option.Id, ChartRange))" />
                }
            </div>
            <div class="d-flex align-center justify-space-between">
                <div>
                    <MudText Typo="Typo.body2">@WebStrings.DisplayStartAtZero</MudText>
                    <MudText Typo="Typo.caption" Class="sw-muted">@WebStrings.DisplayStartAtZeroDescription</MudText>
                </div>
                <MudSwitch T="bool" Value="@BeginAtZero" ValueChanged="@(value => SaveSettingAsync("chartBeginAtZero", value ? "true" : "false", BeginAtZero ? "true" : "false"))"
                           Color="Color.Primary" />
            </div>
        </MudItem>
    </MudGrid>
</SurfaceCard>

@code {
    private static (string Id, string Title)[] DateFormats =>
    [
        ("dmy", WebStrings.DisplayDayFirst),
        ("mdy", WebStrings.DisplayMonthFirst),
        ("ymd", WebStrings.DisplayYearFirst)
    ];

    private static (string Id, string Title, string Description)[] ChartRanges =>
    [
        ("24h", WebStrings.DisplayLast24Hours, WebStrings.DisplayLast24HoursDescription),
        ("7d", WebStrings.DisplayLast7Days, WebStrings.DisplayLast7DaysDescription),
        ("30d", WebStrings.DisplayLast30Days, WebStrings.DisplayLast30DaysDescription)
    ];

    private string DateFormat => Settings.Current.Display.DateFormat;

    private string ChartRange => Settings.Current.Display.ChartRange;

    private bool BeginAtZero => Settings.Current.Display.ChartBeginAtZero;

    private static string Example(string dateFormat) =>
        DisplayFormat.FormatDate(new DateTime(2026, 9, 16), dateFormat);

    private async Task SavePreferencesAsync(string timeFormat, string speedUnit)
    {
        if (timeFormat == PreferencesService.TimeFormat && speedUnit == PreferencesService.SpeedUnit) return;

        await PreferencesService.SetPreferencesAsync(timeFormat, speedUnit);
        Snackbar.Add(WebStrings.DisplayPreferencesSaved, Severity.Success);
    }

    private async Task SaveSettingAsync(string key, string value, string saved)
    {
        if (value == saved) return;

        var result = await Settings.SaveAsync((key, value));
        if (result.Succeeded) Snackbar.Add(WebStrings.DisplaySettingsSaved, Severity.Success);
        else Snackbar.Add(result.Message ?? SettingsState.SaveFailed, Severity.Error);
    }
}
