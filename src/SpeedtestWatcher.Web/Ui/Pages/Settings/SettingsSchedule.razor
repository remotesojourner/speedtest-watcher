@using Cronos
@inject SettingsState Settings
@inject ResultsService Results
@inject PauseService Pausing
@inject StatusStateService StatusService
@inject PreferencesService PreferencesService
@inject ISnackbar Snackbar
@implements IDisposable

<MudGrid Spacing="4">
    <MudItem xs="12" md="6">
        <SurfaceCard Icon="@Icons.Material.Filled.Schedule" Title="Test Schedule"
                     Description="How often Speedtest Watcher runs a speedtest automatically. Cron expressions run in UTC.">
            <div class="sw-option-list mb-3">
                @foreach (var preset in _cronPresets)
                {
                    <OptionCard Title="@preset.Title" Description="@preset.Description" Icon="@preset.Icon"
                                Active="@(_cronMode == preset.Cron)" OnClick="@(() => SelectCron(preset.Cron))" />
                }
                <OptionCard Title="Custom" Description="Your own cron expression" Icon="@Icons.Material.Filled.Code"
                            Active="@(_cronMode == CustomMode)" OnClick="@(() => SelectCron(CustomMode))" />
            </div>

            @if (_cronMode == CustomMode)
            {
                <MudTextField @bind-Value="_customCron" Label="Cron expression" Placeholder="0 * * * *"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                              Error="@(NextRun == null)" ErrorText="Not a valid cron expression" Class="mb-2" />
            }

            <div class="d-flex flex-wrap align-center justify-space-between gap-2 mb-3">
                <MudText Typo="Typo.caption" Class="sw-muted">
                    @(NextRun != null ? $"Next test: {PreferencesService.FormatDateTime(NextRun.Value)}" : "")
                    @(_monthlyBytes is { } bytes ? $" · about {ByteSize.Describe(bytes)} a month at your recent speeds" : "")
                </MudText>
                <MudLink Href="https://crontab.guru/" Target="_blank" Typo="Typo.caption">Cron syntax help</MudLink>
            </div>

            <div class="d-flex align-center justify-space-between mb-4">
                <div>
                    <MudText Typo="Typo.body2">Offset schedule</MudText>
                    <MudText Typo="Typo.caption" Class="sw-muted">Starts each test a little late, by at most 5 minutes and never more than a quarter of the gap</MudText>
                </div>
                <MudSwitch @bind-Value="_scheduleOffset" Color="Color.Primary" />
            </div>

            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       Disabled="@(!ScheduleDirty || NextRun == null)" OnClick="SaveScheduleAsync">
                Save Schedule
            </MudButton>
        </SurfaceCard>
    </MudItem>

    <MudItem xs="12" md="6">
        <SurfaceCard Icon="@Icons.Material.Filled.NetworkCheck" Title="While Unhealthy"
                     Description="Test again sooner while the last completed test misses your targets. Off unless you choose a pace.">
            <div class="sw-option-list mb-3">
                <OptionCard Title="Off" Description="Always use the test schedule" Icon="@Icons.Material.Filled.DoNotDisturbOn"
                            Active="@(_unhealthyMode == OffMode)" OnClick="@(() => SelectUnhealthyCron(OffMode))" />
                @foreach (var preset in _unhealthyPresets)
                {
                    <OptionCard Title="@preset.Title" Description="@preset.Description" Icon="@preset.Icon"
                                Active="@(_unhealthyMode == preset.Cron)" OnClick="@(() => SelectUnhealthyCron(preset.Cron))" />
                }
                <OptionCard Title="Custom" Description="Your own cron expression" Icon="@Icons.Material.Filled.Code"
                            Active="@(_unhealthyMode == CustomMode)" OnClick="@(() => SelectUnhealthyCron(CustomMode))" />
            </div>

            @if (_unhealthyMode == CustomMode)
            {
                <MudTextField @bind-Value="_customUnhealthyCron" Label="Cron expression" Placeholder="*/5 * * * *"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                              Error="@(UnhealthyNextRun == null)" ErrorText="Not a valid cron expression" Class="mb-2" />
            }

            @if (UnhealthyNextRun is { } nextWhileUnhealthy)
            {
                <div class="d-flex flex-wrap align-center justify-space-between gap-2 mb-3">
                    <MudText Typo="Typo.caption" Class="sw-muted">
                        @($"First test after a miss: {PreferencesService.FormatDateTime(nextWhileUnhealthy)}")
                    </MudText>
                    <MudLink Href="https://crontab.guru/" Target="_blank" Typo="Typo.caption">Cron syntax help</MudLink>
                </div>
            }

            @if (_hourlyBytes is { } hourly)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mb-3">
                    @($"This pace uses about {ByteSize.Describe(hourly)} an hour at your recent speeds, until a test meets your targets again.")
                </MudAlert>
            }

            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       Disabled="@(!UnhealthyScheduleDirty || (_unhealthyMode != OffMode && UnhealthyNextRun == null))" OnClick="SaveUnhealthyScheduleAsync">
                Save
            </MudButton>
        </SurfaceCard>
    </MudItem>
    <MudItem xs="12" md="6">
        <SurfaceCard Icon="@Icons.Material.Filled.PauseCircle" Title="Pause Speedtests"
                     Description="Temporarily stop automatic tests.">
            @if (StatusService.Paused)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4">Speedtests are currently paused.</MudAlert>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="ResumeTests">
                    Resume Tests
                </MudButton>
            }
            else
            {
                <div class="sw-option-list mb-3">
                    @foreach (var preset in _pausePresets)
                    {
                        <OptionCard Title="@preset.Title" Description="@preset.Description" Icon="@preset.Icon"
                                    Active="@(_pauseMode == preset.Id)" OnClick="@(() => _pauseMode = preset.Id)" />
                    }
                    <OptionCard Title="Custom duration" Description="Pause for a number of hours" Icon="@Icons.Material.Filled.Tune"
                                Active="@(_pauseMode == CustomMode)" OnClick="@(() => _pauseMode = CustomMode)" />
                </div>

                @if (_pauseMode == CustomMode)
                {
                    <MudNumericField T="double?" @bind-Value="_customPauseHours" Label="Hours" Variant="Variant.Outlined"
                                     Margin="Margin.Dense" Min="0.1" Max="PauseService.MaxResumeInHours" Step="0.5" Immediate="true"
                                     Error="@(!CustomPauseValid)" ErrorText="@($"Enter more than 0 and at most {PauseService.MaxResumeInHours:0} hours")"
                                     HelperText="Up to 30 days. Pause indefinitely for longer." Class="mb-3" />
                }

                <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Pause"
                           Disabled="@(_pauseMode == CustomMode && !CustomPauseValid)" OnClick="PauseTests">
                    Pause Tests
                </MudButton>
            }
        </SurfaceCard>
    </MudItem>
</MudGrid>

@code {
    private const string CustomMode = "custom";

    private static readonly (string Cron, string Title, string Description, string Icon)[] _cronPresets =
    [
        ("* * * * *", "Continuous", "Every minute — high resource usage", Icons.Material.Filled.Bolt),
        ("0,30 * * * *", "Very often", "Every 30 minutes", Icons.Material.Filled.Speed),
        ("0 * * * *", "Default", "Every hour — recommended", Icons.Material.Filled.Schedule),
        ("0 0,3,6,9,12,15,18,21 * * *", "Rarely", "Every 3 hours", Icons.Material.Filled.Timer),
        ("0 0,6,12,18 * * *", "Very rarely", "Every 6 hours", Icons.Material.Filled.Spa)
    ];

    private static readonly (string Cron, string Title, string Description, string Icon)[] _unhealthyPresets =
    [
        ("*/5 * * * *", "Every 5 minutes", "The quickest look at a bad line", Icons.Material.Filled.Bolt),
        ("*/10 * * * *", "Every 10 minutes", "Often, without hammering the line", Icons.Material.Filled.Speed),
        ("*/15 * * * *", "Every 15 minutes", "A good middle ground", Icons.Material.Filled.Timer),
        ("0,30 * * * *", "Every 30 minutes", "Twice the usual hourly pace", Icons.Material.Filled.Schedule),
        ("0 * * * *", "Every hour", "Only useful with a slower schedule", Icons.Material.Filled.Spa)
    ];

    private static readonly (string Id, double? Hours, string Title, string Description, string Icon)[] _pausePresets =
    [
        ("manual", null, "Pause indefinitely", "Until you resume manually", Icons.Material.Filled.AllInclusive),
        ("short", 1, "Short break", "Pause for 1 hour", Icons.Material.Filled.Coffee),
        ("medium", 6, "Medium break", "Pause for 6 hours", Icons.Material.Filled.Schedule),
        ("long", 12, "Long break", "Pause for 12 hours", Icons.Material.Filled.Bedtime)
    ];

    private const string OffMode = "off";

    private string _cronMode = "0 * * * *";
    private string _customCron = "0 * * * *";
    private bool _scheduleOffset;

    private string _unhealthyMode = OffMode;
    private string _customUnhealthyCron = "*/5 * * * *";

    private string _pauseMode = "manual";
    private double? _customPauseHours;

    private string EffectiveCron => (_cronMode == CustomMode ? _customCron : _cronMode).Trim();

    private string? EffectiveUnhealthyCron => _unhealthyMode switch
    {
        OffMode => null,
        CustomMode => _customUnhealthyCron.Trim(),
        _ => _unhealthyMode
    };

    private DateTime? NextRun => NextRunOf(EffectiveCron);

    private DateTime? UnhealthyNextRun => EffectiveUnhealthyCron is { } cron ? NextRunOf(cron) : null;

    private DateTime? NextRunOf(string cron)
    {
        try
        {
            var next = CronExpression.Parse(cron, CronFormat.Standard).GetNextOccurrence(DateTime.UtcNow, TimeZoneInfo.Utc);
            return next is { } utc ? PreferencesService.ToLocal(utc) : null;
        }
        catch (CronFormatException)
        {
            return null;
        }
    }

    private bool ScheduleDirty =>
        EffectiveCron != Settings.Current.Schedule.Cron
        || _scheduleOffset != Settings.Current.Schedule.RandomOffset;

    private bool UnhealthyScheduleDirty => EffectiveUnhealthyCron != Settings.Current.Schedule.UnhealthyCron;

    private bool CustomPauseValid => _customPauseHours is > 0 and <= PauseService.MaxResumeInHours;

    private long? _monthlyBytes;
    private long? _hourlyBytes;
    private string _estimatedFor = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var estimateFor = $"{EffectiveCron}|{EffectiveUnhealthyCron}";
        if (_estimatedFor == estimateFor) return;

        _estimatedFor = estimateFor;
        _monthlyBytes = await Results.EstimateBytesAsync(new ScheduleSettings(EffectiveCron, RandomOffset: false), TimeSpan.FromDays(30));
        _hourlyBytes = EffectiveUnhealthyCron is { } cron
            ? await Results.EstimateBytesAsync(new ScheduleSettings(cron, RandomOffset: false), TimeSpan.FromHours(1))
            : null;
        StateHasChanged();
    }

    protected override void OnInitialized()
    {
        StatusService.OnChange += OnStatusChanged;

        var cron = Settings.Current.Schedule.Cron;
        _cronMode = _cronPresets.Any(p => p.Cron == cron) ? cron : CustomMode;
        _customCron = cron;
        _scheduleOffset = Settings.Current.Schedule.RandomOffset;

        if (Settings.Current.Schedule.UnhealthyCron is { } unhealthyCron)
        {
            _unhealthyMode = _unhealthyPresets.Any(p => p.Cron == unhealthyCron) ? unhealthyCron : CustomMode;
            _customUnhealthyCron = unhealthyCron;
        }
    }

    private void SelectCron(string mode)
    {
        _cronMode = mode;
        if (mode != CustomMode) _customCron = mode;
    }

    private void SelectUnhealthyCron(string mode)
    {
        _unhealthyMode = mode;
        if (mode is not (CustomMode or OffMode)) _customUnhealthyCron = mode;
    }

    private async Task SaveScheduleAsync()
    {
        var result = await Settings.SaveAsync(("cron", EffectiveCron), ("scheduleOffset", _scheduleOffset ? "true" : "false"));
        if (result.Succeeded) Snackbar.Add("Schedule saved", Severity.Success);
        else Snackbar.Add(result.Message ?? SettingsState.SaveFailed, Severity.Error);
    }

    private async Task SaveUnhealthyScheduleAsync()
    {
        var result = await Settings.SaveAsync(("unhealthyCron", EffectiveUnhealthyCron ?? SettingDefinitions.Unset));
        if (result.Succeeded) Snackbar.Add(EffectiveUnhealthyCron == null ? "Unhealthy schedule turned off" : "Unhealthy schedule saved", Severity.Success);
        else Snackbar.Add(result.Message ?? SettingsState.SaveFailed, Severity.Error);
    }

    private void PauseTests()
    {
        var hours = _pauseMode == CustomMode ? _customPauseHours : _pausePresets.First(p => p.Id == _pauseMode).Hours;
        var result = Pausing.Pause(hours);
        if (!result.Succeeded)
        {
            Snackbar.Add(result.Message ?? "Could not pause speedtests", Severity.Error);
            return;
        }

        StatusService.UpdateStatus(StatusService.Running, true);
        Snackbar.Add("Speedtests paused", Severity.Warning);
    }

    private void ResumeTests()
    {
        if (!Pausing.Resume().Succeeded)
        {
            Snackbar.Add("Could not resume speedtests", Severity.Error);
            return;
        }

        StatusService.UpdateStatus(StatusService.Running, false);
        Snackbar.Add("Speedtests resumed", Severity.Success);
    }

    private void OnStatusChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => StatusService.OnChange -= OnStatusChanged;
}
