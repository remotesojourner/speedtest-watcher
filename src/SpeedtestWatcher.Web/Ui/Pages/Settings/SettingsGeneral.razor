@using System.Data.Common
@using System.Globalization
@inject RecommendationService Recommendations
@inject SettingsState Settings
@inject ISnackbar Snackbar

<MudGrid Spacing="4">
    <MudItem xs="12" md="6">
        <SurfaceCard Icon="@Icons.Material.Filled.TrendingUp" Title="Optimal Values"
                     Description="Your contracted speeds. Results are colour-coded against these, marked healthy or not, and integrations can alert you when a test misses them.">
            <MudNumericField T="double" @bind-Value="_optPing" Label="Ping (ms)" Variant="Variant.Outlined" Margin="Margin.Dense"
                             Min="0" Immediate="true" HelperText="@RecommendedHint(_recommendation?.Ping, "ms")" Class="mb-3" />
            <MudNumericField T="double" @bind-Value="_optDownload" Label="Download (Mbps)" Variant="Variant.Outlined" Margin="Margin.Dense"
                             Min="0" Immediate="true" HelperText="@RecommendedHint(_recommendation?.Download, "Mbps")" Class="mb-3" />
            <MudNumericField T="double" @bind-Value="_optUpload" Label="Upload (Mbps)" Variant="Variant.Outlined" Margin="Margin.Dense"
                             Min="0" Immediate="true" HelperText="@RecommendedHint(_recommendation?.Upload, "Mbps")" Class="mb-4" />

            <MudText Typo="Typo.body2" Class="font-weight-bold mb-1">Optional maximums</MudText>
            <MudText Typo="Typo.caption" Class="sw-muted d-block mb-3">
                Judged only when a test measured the figure, so a provider that doesn't report one can never miss it. Leave empty for no target.
            </MudText>

            <MudNumericField T="double?" @bind-Value="_maxPacketLoss" Label="Packet loss (%)" Variant="Variant.Outlined" Margin="Margin.Dense"
                             Min="0" Max="100" Immediate="true" Clearable="true"
                             HelperText="Only Ookla measures packet loss" Class="mb-3" />
            <MudNumericField T="double?" @bind-Value="_maxBufferbloat" Label="Bufferbloat (ms)" Variant="Variant.Outlined" Margin="Margin.Dense"
                             Min="0" Immediate="true" Clearable="true"
                             HelperText="Added latency under load. Under 30 ms is good" Class="mb-4" />

            <div class="d-flex flex-wrap gap-2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!OptimalDirty)" OnClick="SaveOptimalValuesAsync">
                    Save Values
                </MudButton>
                @if (_recommendation != null)
                {
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.AutoFixHigh" OnClick="UseRecommended">
                        Use recommended
                    </MudButton>
                }
            </div>
            @if (_recommendationUnavailable)
            {
                <MudText Typo="Typo.caption" Color="Color.Error" Class="d-block mt-3">Couldn't load recommendations.</MudText>
            }
            else if (_recommendation == null)
            {
                <MudText Typo="Typo.caption" Class="sw-muted d-block mt-3">Recommendations appear after at least 10 tests.</MudText>
            }
        </SurfaceCard>
    </MudItem>

    <MudItem xs="12" md="6">
        <SurfaceCard Icon="@Icons.Material.Filled.NetworkCheck" Title="Before Each Test"
                     Description="Checks that run before a speedtest starts. A test that doesn't run is recorded as skipped.">
            <div class="d-flex align-center justify-space-between mb-3">
                <div>
                    <MudText Typo="Typo.body2">Check the connection first</MudText>
                    <MudText Typo="Typo.caption" Class="sw-muted">Skips the test instead of recording a failure when the line is down</MudText>
                </div>
                <MudSwitch @bind-Value="_internetCheck" Color="Color.Primary" />
            </div>

            <MudTextField @bind-Value="_internetCheckUrl" Label="Check URL" Placeholder="https://icanhazip.com"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                          Error="@(!CheckUrlValid)" ErrorText="Enter a full http(s) URL"
                          HelperText="Must return your public IP address, which the skip list below is compared against" Class="mb-3" />

            <MudTextField @bind-Value="_skipIps" Label="Skip tests when the public IP is" Placeholder="203.0.113.10, 198.51.100.4"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                          HelperText="Comma separated. Useful while a VPN or backup line is up. Leave empty to always test." Class="mb-4" />

            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!ChecksDirty || !CheckUrlValid)" OnClick="SaveChecksAsync">
                Save Checks
            </MudButton>
        </SurfaceCard>
    </MudItem>
    <MudItem xs="12" md="6">
        <SurfaceCard Icon="@Icons.Material.Filled.Router" Title="Probe Targets"
                     Description="The hosts Speedtest Watcher opens a TCP connection to. Connection monitoring uses them to tell whether the line is up, and every speedtest uses them to measure bufferbloat.">
            <MudTextField @bind-Value="_probeTargets" Label="Probe targets" Placeholder="@MonitoringSettings.DefaultTargets"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                          Error="@(!ProbeTargetsValid)" ErrorText="Each target needs to look like host:port"
                          HelperText="Comma separated. Three or more is best: with one, a single slow answer looks like an outage." Class="mb-2" />

            <div class="d-flex flex-wrap justify-space-between align-center gap-2">
                <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.Restore"
                           Disabled="@(_probeTargets == MonitoringSettings.DefaultTargets)"
                           OnClick="@(() => _probeTargets = MonitoringSettings.DefaultTargets)">
                    Reset to defaults
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           Disabled="@(!ProbeTargetsDirty || !ProbeTargetsValid)" OnClick="SaveProbeTargetsAsync">
                    Save Targets
                </MudButton>
            </div>
        </SurfaceCard>
    </MudItem>

</MudGrid>

@code {
    private double _optPing;
    private double _optDownload;
    private double _optUpload;
    private double? _maxPacketLoss;
    private double? _maxBufferbloat;
    private Recommendation? _recommendation;
    private bool _recommendationUnavailable;

    private bool _internetCheck = true;
    private string _internetCheckUrl = "https://icanhazip.com";
    private string _skipIps = "";
    private string _probeTargets = MonitoringSettings.DefaultTargets;

    private TargetSettings Targets => Settings.Current.Targets;

    private PreTestCheckSettings Checks => Settings.Current.PreTestChecks;

    private bool OptimalDirty =>
        Differs(_optPing, Targets.Ping)
        || Differs(_optDownload, Targets.Download)
        || Differs(_optUpload, Targets.Upload)
        || _maxPacketLoss != Targets.PacketLoss
        || _maxBufferbloat != Targets.Bufferbloat;

    private bool CheckUrlValid => WebAddress.IsHttp(_internetCheckUrl);

    private List<string> SkipIpList => _skipIps.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();

    private IReadOnlyList<string> ProbeTargetList =>
        [.. _probeTargets.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)];

    private bool ProbeTargetsValid => ProbeTargetList.Count > 0 && ProbeTargetList.All(target => ProbeTarget.Parse(target) != null);

    private bool ProbeTargetsDirty => _probeTargets != string.Join(", ", Settings.Current.Monitoring.Targets);

    private bool ChecksDirty =>
        _internetCheck != Checks.InternetCheckEnabled
        || _internetCheckUrl.Trim() != Checks.InternetCheckUrl
        || !SkipIpList.SequenceEqual(Checks.SkipIps);

    protected override async Task OnInitializedAsync()
    {
        ResetOptimalValues();
        _internetCheck = Checks.InternetCheckEnabled;
        _internetCheckUrl = Checks.InternetCheckUrl;
        _skipIps = string.Join(", ", Checks.SkipIps);
        _probeTargets = string.Join(", ", Settings.Current.Monitoring.Targets);

        try
        {
            _recommendation = (await Recommendations.GetAsync()).Value;
        }
        catch (Exception ex) when (ex is DbException or InvalidOperationException)
        {
            _recommendationUnavailable = true;
        }
    }

    private void ResetOptimalValues()
    {
        _optPing = Targets.Ping ?? 0;
        _optDownload = Targets.Download ?? 0;
        _optUpload = Targets.Upload ?? 0;
        _maxPacketLoss = Targets.PacketLoss;
        _maxBufferbloat = Targets.Bufferbloat;
    }

    private void UseRecommended()
    {
        if (_recommendation == null) return;
        _optPing = _recommendation.Ping;
        _optDownload = _recommendation.Download;
        _optUpload = _recommendation.Upload;
    }

    private async Task SaveOptimalValuesAsync()
    {
        var changes = new List<(string Key, string Value)>();
        if (Differs(_optPing, Targets.Ping)) changes.Add(("ping", SettingNumber.Format(_optPing)));
        if (Differs(_optDownload, Targets.Download)) changes.Add(("download", SettingNumber.Format(_optDownload)));
        if (Differs(_optUpload, Targets.Upload)) changes.Add(("upload", SettingNumber.Format(_optUpload)));
        if (_maxPacketLoss != Targets.PacketLoss) changes.Add(("maxPacketLoss", Maximum(_maxPacketLoss)));
        if (_maxBufferbloat != Targets.Bufferbloat) changes.Add(("maxBufferbloat", Maximum(_maxBufferbloat)));

        var result = await Settings.SaveAsync([.. changes]);
        if (result.Succeeded) ResetOptimalValues();
        ShowSaveResult(result, "Optimal values saved");
    }

    private async Task SaveChecksAsync()
    {
        var skipIps = SkipIpList;
        var result = await Settings.SaveAsync(
            ("internetCheckEnabled", _internetCheck ? "true" : "false"),
            ("internetCheckUrl", _internetCheckUrl.Trim()),
            ("skipIps", skipIps.Count > 0 ? string.Join(", ", skipIps) : SettingDefinitions.Unset));
        ShowSaveResult(result, "Pre-test checks saved");
    }

    private async Task SaveProbeTargetsAsync()
    {
        var result = await Settings.SaveAsync(("monitoringTargets", string.Join(",", ProbeTargetList)));
        ShowSaveResult(result, "Probe targets saved");
    }

    private void ShowSaveResult(OperationResult result, string successMessage)
    {
        if (result.Succeeded) Snackbar.Add(successMessage, Severity.Success);
        else Snackbar.Add(result.Message ?? SettingsState.SaveFailed, Severity.Error);
    }

    private static string Maximum(double? value) => value is { } figure ? SettingNumber.Format(figure) : SettingDefinitions.Unset;

    private static bool Differs(double value, double? saved) => Math.Abs(value - (saved ?? 0)) > 0.0000001;

    private static string? RecommendedHint(double? value, string unit) =>
        value.HasValue ? $"Recommended: {value.Value.ToString(CultureInfo.InvariantCulture)} {unit}" : null;
}
