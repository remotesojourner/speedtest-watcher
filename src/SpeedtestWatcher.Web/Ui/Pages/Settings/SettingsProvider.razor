@using System.Net.NetworkInformation
@inject ProviderOptionsService ProviderOptions
@inject IEnumerable<ISpeedtestTool> Tools
@inject SettingsState Settings
@inject ISnackbar Snackbar

<SurfaceCard Icon="@Icons.Material.Filled.Speed" Title="@WebStrings.ProviderTitle" FullHeight="false"
             Description="@WebStrings.ProviderDescription">
    <div class="sw-option-grid mb-5">
        @foreach (var tool in Tools)
        {
            <OptionCard Title="@tool.Title" Description="@tool.Description" Image="@tool.ImagePath()"
                        Active="@(_provider == tool.Provider)" OnClick="@(() => SelectProviderAsync(tool.Provider))" />
        }
    </div>

    <MudGrid Spacing="3" Class="mb-2">
        <MudItem xs="12" md="6">
            <MudSelect T="string" @bind-Value="_interface" Label="@WebStrings.ProviderInterface" Variant="Variant.Outlined" Margin="Margin.Dense"
                       HelperText="@(_interfacesUnavailable ? WebStrings.ProviderInterfacesFailed : WebStrings.ProviderInterfaceHelp)">
                <MudSelectItem T="string" Value="@SettingDefinitions.Unset">@WebStrings.ProviderDefaultRoute</MudSelectItem>
                @foreach (var option in _interfaceOptions)
                {
                    <MudSelectItem T="string" Value="@option.Value">@option.Label</MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        @if (_provider == SpeedtestProvider.Libre)
        {
            <MudItem xs="12" md="6">
                <MudTextField T="string" Value="_libreUrl" ValueChanged="SetLibreUrl" Label="@WebStrings.ProviderLibreUrl"
                              Placeholder="https://speed.test/backend/" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                              Error="@(!LibreUrlValid)" ErrorText="@WebStrings.EnterHttpUrl"
                              HelperText="@WebStrings.ProviderLibreUrlHelp" />
            </MudItem>
        }
    </MudGrid>

    @if (SupportsServerChoice)
    {
        <MudText Typo="Typo.body2" Class="font-weight-bold mb-2">@WebStrings.ProviderServerChoice</MudText>
        <div class="sw-option-list mb-4">
            <OptionCard Title="@WebStrings.ProviderServerAuto" Description="@WebStrings.Format(WebStrings.ProviderServerAutoDescription, ProviderTitle)" Icon="@Icons.Material.Filled.AutoAwesome"
                        Active="@(_serverMode == ServerMode.Auto)" OnClick="@(() => _serverMode = ServerMode.Auto)" />
            <OptionCard Title="@WebStrings.ProviderServerRandom" Description="@WebStrings.ProviderServerRandomDescription" Icon="@Icons.Material.Filled.Shuffle"
                        Active="@(_serverMode == ServerMode.Random)" OnClick="@(() => _serverMode = ServerMode.Random)" />
            <OptionCard Title="@WebStrings.ProviderServerSingle" Description="@WebStrings.ProviderServerSingleDescription" Icon="@Icons.Material.Filled.PushPin"
                        Active="@(_serverMode == ServerMode.Pinned)" OnClick="@(() => _serverMode = ServerMode.Pinned)" />
        </div>

        @if (_serverMode == ServerMode.Pinned)
        {
            <MudGrid Spacing="3" Class="mb-2">
                <MudItem xs="12" md="6">
                    <MudSelect T="string" Value="@(_serverId == SettingDefinitions.Unset ? null : _serverId)" ValueChanged="SetServerId" Label="@WebStrings.Server"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" RequiredError="@WebStrings.ProviderChooseServer"
                               Disabled="_serversLoading" HelperText="@ServerListHelp">
                        @foreach (var server in CurrentServers)
                        {
                            <MudSelectItem T="string" Value="@server.Id">@server.Label</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField T="string" Value="@(_serverId == SettingDefinitions.Unset ? "" : _serverId)" ValueChanged="SetServerId"
                                  Label="@WebStrings.ServerId" Placeholder="@WebStrings.ServerIdPlaceholder" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                                  Required="true" RequiredError="@WebStrings.ProviderEnterOrChooseServer"
                                  Error="@(!ServerIdValid)" ErrorText="@WebStrings.ServerIdInvalid"
                                  HelperText="@WebStrings.ProviderServerIdHelp" />
                </MudItem>
            </MudGrid>
        }
        else if (_serverMode == ServerMode.Random)
        {
            <div class="sw-option-list mb-3">
                <OptionCard Title="@WebStrings.ProviderAllowList" Description="@WebStrings.ProviderAllowListDescription" Icon="@Icons.Material.Filled.PlaylistAddCheck"
                            Active="@(_listMode == ServerListMode.Allow)" OnClick="@(() => _listMode = ServerListMode.Allow)" />
                <OptionCard Title="@WebStrings.ProviderDenyList" Description="@WebStrings.ProviderDenyListDescription" Icon="@Icons.Material.Filled.Block"
                            Active="@(_listMode == ServerListMode.Deny)" OnClick="@(() => _listMode = ServerListMode.Deny)" />
            </div>

            <MudGrid Spacing="3" Class="mb-2">
                <MudItem xs="12" md="6">
                    <MudSelect T="string" Label="@WebStrings.ProviderServers" MultiSelection="true" SelectedValues="SelectedIds" SelectedValuesChanged="SetSelectedIds"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="_serversLoading"
                               MultiSelectionTextFunc="@(selected => WebStrings.Format(WebStrings.SelectedCount, selected?.Count ?? 0))"
                               HelperText="@ServerListHelp">
                        @foreach (var server in CurrentServers)
                        {
                            <MudSelectItem T="string" Value="@server.Id">@server.Label</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField T="string" @bind-Value="_customId" Label="@WebStrings.ProviderAddServerId" Placeholder="@WebStrings.ServerIdPlaceholder"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                                  Error="@(!CustomIdValid)" ErrorText="@WebStrings.ServerIdInvalid"
                                  HelperText="@WebStrings.ProviderAddServerIdHelp"
                                  Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Add"
                                  AdornmentAriaLabel="@WebStrings.ProviderAddServerIdLabel" OnAdornmentClick="AddCustomId"
                                  OnKeyDown="@(e => { if (e.Key == "Enter") AddCustomId(); })" />
                </MudItem>
            </MudGrid>

            @if (SelectedIdList.Count > 0)
            {
                <div class="d-flex flex-wrap gap-2 mb-2">
                    @foreach (var id in SelectedIdList)
                    {
                        <MudChip T="string" Size="Size.Small" OnClose="@(() => RemoveId(id))" CloseIcon="@Icons.Material.Filled.Close">
                            @ServerLabel(id)
                        </MudChip>
                    }
                </div>
            }
            else
            {
                <MudText Typo="Typo.caption" Class="sw-muted d-block mb-2">
                    @(_listMode == ServerListMode.Deny
                        ? WebStrings.ProviderNothingExcluded
                        : WebStrings.ProviderNothingChosen)
                </MudText>
            }
        }
    }

    @if (_provider == SpeedtestProvider.Ookla)
    {
        <div class="d-flex align-center mt-4">
            <MudCheckBox T="bool" @bind-Value="_acceptedOokla" Color="Color.Primary" Dense="true" />
            <MudText Typo="Typo.body2">
                <FormattedText Format="@WebStrings.ProviderAcceptOoklaTerms" Arguments="@([OoklaEulaLink, OoklaPrivacyPolicyLink, OoklaTermsOfServiceLink])" />
            </MudText>
        </div>
    }

    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" Disabled="@(!CanSave)" OnClick="SaveAsync">
        @(_saving ? WebStrings.Saving : WebStrings.Save)
    </MudButton>
</SurfaceCard>

@code {
    private sealed record ServerOption(string Id, string Label);
    private sealed record InterfaceOption(string Value, string Label);

    private static RenderFragment OoklaEulaLink => @<MudLink Href="@OoklaTerms.EulaUrl" Target="_blank">@WebStrings.ProviderEula</MudLink>;

    private static RenderFragment OoklaPrivacyPolicyLink => @<MudLink Href="@OoklaTerms.PrivacyPolicyUrl" Target="_blank">@WebStrings.ProviderPrivacyPolicy</MudLink>;

    private static RenderFragment OoklaTermsOfServiceLink => @<MudLink Href="@OoklaTerms.TermsOfServiceUrl" Target="_blank">@WebStrings.ProviderTermsOfService</MudLink>;

    private SpeedtestProvider _provider = SpeedtestProvider.Ookla;
    private string _interface = SettingDefinitions.Unset;
    private ServerMode _serverMode = ServerMode.Auto;
    private ServerListMode _listMode = ServerListMode.Allow;
    private string _serverId = SettingDefinitions.Unset;
    private string _customId = "";
    private string _libreUrl = "";
    private bool _acceptedOokla;
    private bool _serversLoading;
    private bool _interfacesUnavailable;
    private readonly HashSet<SpeedtestProvider> _serverListsUnavailable = [];
    private bool _saving;
    private List<InterfaceOption> _interfaceOptions = [];
    private readonly Dictionary<SpeedtestProvider, List<ServerOption>> _servers = new();
    private readonly Dictionary<SpeedtestProvider, List<string>> _serverIds = new();

    private IReadOnlyList<ServerOption> CurrentServers => _servers.TryGetValue(_provider, out var list) ? list : [];

    private string ServerListHelp => _serversLoading
        ? WebStrings.LoadingServers
        : _serverListsUnavailable.Contains(_provider)
            ? WebStrings.ProviderServerListFailed
            : WebStrings.NearestServersFirst;

    private List<string> SelectedIdList => _serverIds.TryGetValue(_provider, out var ids) ? ids : [];

    private IReadOnlyCollection<string> SelectedIds => SelectedIdList;

    private ISpeedtestTool CurrentTool => Tools.First(tool => tool.Provider == _provider);

    private string ProviderTitle => CurrentTool.Title;

    private bool SupportsServerChoice => CurrentTool.SupportsServerChoice() && !UsingCustomUrl;

    private bool UsingCustomUrl => _provider == SpeedtestProvider.Libre && !string.IsNullOrWhiteSpace(_libreUrl);

    private bool ServerIdValid => _serverId == SettingDefinitions.Unset || _serverId.All(char.IsDigit);

    private bool CustomIdValid => string.IsNullOrWhiteSpace(_customId) || _customId.Trim().All(char.IsDigit);

    private bool LibreUrlValid => string.IsNullOrWhiteSpace(_libreUrl) || WebAddress.IsHttp(_libreUrl);

    private bool PinnedServerChosen => !(SupportsServerChoice && _serverMode == ServerMode.Pinned) || _serverId != SettingDefinitions.Unset;

    private bool CanSave => !_saving && ServerIdValid && PinnedServerChosen && CustomIdValid && LibreUrlValid && (_provider != SpeedtestProvider.Ookla || _acceptedOokla);

    private ProviderSettings Saved => Settings.Current.Provider;

    protected override async Task OnInitializedAsync()
    {
        _provider = Saved.Selected == SpeedtestProvider.None ? SpeedtestProvider.Ookla : Saved.Selected;
        _acceptedOokla = Saved.Selected == SpeedtestProvider.Ookla;
        _interface = Saved.Interface ?? SettingDefinitions.Unset;
        _libreUrl = Saved.LibreUrl ?? "";
        _serverMode = Saved.ServerMode;
        _listMode = Saved.ServerListMode;
        _serverId = ConfiguredServerId(_provider);
        _serverIds[SpeedtestProvider.Ookla] = Saved.Ookla.ListedIds.ToList();
        _serverIds[SpeedtestProvider.Libre] = Saved.Libre.ListedIds.ToList();

        await Task.WhenAll(LoadInterfacesAsync(), LoadServersAsync(_provider));
    }

    private string ConfiguredServerId(SpeedtestProvider provider) =>
        Saved.ServersFor(provider)?.PinnedId ?? SettingDefinitions.Unset;

    private string ConfiguredServerIds(SpeedtestProvider provider) =>
        Saved.ServersFor(provider) is { ListedIds.Count: > 0 } servers ? string.Join(",", servers.ListedIds) : SettingDefinitions.Unset;

    private async Task SelectProviderAsync(SpeedtestProvider provider)
    {
        if (_provider == provider) return;
        _provider = provider;
        _serverId = ConfiguredServerId(provider);
        await LoadServersAsync(provider);
    }

    private void SetServerId(string? value)
    {
        _serverId = string.IsNullOrWhiteSpace(value) ? SettingDefinitions.Unset : value.Trim();
        if (_serverId != SettingDefinitions.Unset) _libreUrl = "";
    }

    private void SetSelectedIds(IReadOnlyCollection<string?>? values)
    {
        _serverIds[_provider] = values?
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .Select(value => value!.Trim())
            .ToList() ?? [];
    }

    private void AddCustomId()
    {
        var id = _customId.Trim();
        if (string.IsNullOrEmpty(id) || !CustomIdValid) return;

        var ids = _serverIds.TryGetValue(_provider, out var list) ? list : _serverIds[_provider] = [];
        if (!ids.Contains(id)) ids.Add(id);
        _customId = "";
    }

    private void RemoveId(string id)
    {
        if (_serverIds.TryGetValue(_provider, out var ids)) ids.Remove(id);
    }

    private string ServerLabel(string id) =>
        CurrentServers.FirstOrDefault(s => s.Id == id)?.Label ?? WebStrings.Format(WebStrings.ProviderServerFallback, id);

    private void SetLibreUrl(string? value)
    {
        _libreUrl = value ?? "";
        if (!string.IsNullOrWhiteSpace(_libreUrl)) _serverId = SettingDefinitions.Unset;
    }

    private async Task LoadInterfacesAsync()
    {
        var interfaces = new Dictionary<string, List<string>>();
        try
        {
            interfaces = await ProviderOptions.GetInterfacesAsync();
        }
        catch (NetworkInformationException)
        {
            _interfacesUnavailable = true;
        }

        _interfaceOptions = interfaces
            .SelectMany(entry => entry.Value.Select(ip => new InterfaceOption(ip, $"{entry.Key} — {ip}")))
            .ToList();

        if (_interface != SettingDefinitions.Unset && _interfaceOptions.All(o => o.Value != _interface))
        {
            _interfaceOptions.Insert(0, new InterfaceOption(_interface, WebStrings.Format(WebStrings.ProviderInterfaceSaved, _interface)));
        }
    }

    private async Task LoadServersAsync(SpeedtestProvider provider)
    {
        if (!Tools.Any(tool => tool.Provider == provider && tool.SupportsServerChoice()) || _servers.ContainsKey(provider)) return;

        _serversLoading = true;
        StateHasChanged();

        var result = await ProviderOptions.GetServersAsync(provider.ToName());
        if (result.Value is { } servers)
        {
            _servers[provider] = ServerLabels.NearestFirst(servers).Select(server => new ServerOption(server.Id, ServerLabels.For(server))).ToList();
            _serverListsUnavailable.Remove(provider);
        }
        else
        {
            _serverListsUnavailable.Add(provider);
        }

        _serversLoading = false;
        StateHasChanged();
    }

    private async Task SaveAsync()
    {
        _saving = true;
        var changes = new List<(string Key, string Value)>();

        void AddIfChanged(string key, string value, string? current)
        {
            if (value != current) changes.Add((key, value));
        }

        AddIfChanged("provider", _provider.ToName(), Saved.Selected.ToName());
        AddIfChanged("serverMode", _serverMode.ToName(), Saved.ServerMode.ToName());
        if (_serverMode == ServerMode.Random)
        {
            AddIfChanged("serverListMode", _listMode.ToName(), Saved.ServerListMode.ToName());
        }
        if (SupportsServerChoice && _serverMode == ServerMode.Pinned)
        {
            AddIfChanged(_provider == SpeedtestProvider.Libre ? "libreId" : "ooklaId", _serverId, ConfiguredServerId(_provider));
        }
        if (SupportsServerChoice && _serverMode == ServerMode.Random)
        {
            var ids = SelectedIdList.Count > 0 ? string.Join(",", SelectedIdList) : SettingDefinitions.Unset;
            AddIfChanged(_provider == SpeedtestProvider.Libre ? "libreServerIds" : "ooklaServerIds", ids, ConfiguredServerIds(_provider));
        }
        if (_provider == SpeedtestProvider.Libre)
        {
            AddIfChanged("libreUrl", string.IsNullOrWhiteSpace(_libreUrl) ? SettingDefinitions.Unset : _libreUrl.Trim(), Saved.LibreUrl ?? SettingDefinitions.Unset);
        }
        AddIfChanged("interface", _interface, Saved.Interface ?? SettingDefinitions.Unset);

        var result = await Settings.SaveAsync([.. changes]);
        _saving = false;
        if (result.Succeeded) Snackbar.Add(WebStrings.ProviderSaved, Severity.Success);
        else Snackbar.Add(result.Message ?? SettingsState.SaveFailed, Severity.Error);
    }
}
