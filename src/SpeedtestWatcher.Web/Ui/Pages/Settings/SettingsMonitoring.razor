@using System.Globalization
@inject SettingsState Settings
@inject ISnackbar Snackbar

<MudGrid Spacing="4">
    <MudItem xs="12" md="6">
        <SurfaceCard Icon="@Icons.Material.Filled.MonitorHeart" Title="@WebStrings.MonitoringTitle"
                     Description="@WebStrings.MonitoringDescription">
            <div class="d-flex align-center justify-space-between mb-4">
                <div>
                    <MudText Typo="Typo.body2">@WebStrings.MonitoringWatch</MudText>
                    <MudText Typo="Typo.caption" Class="sw-muted">@WebStrings.MonitoringWatchDescription</MudText>
                </div>
                <MudSwitch @bind-Value="_enabled" Color="Color.Primary" />
            </div>

            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-3">
                <FormattedText Format="@WebStrings.MonitoringProbing" Arguments="@([TargetSummary, GeneralSettingsLink])" />
            </MudAlert>

            <MudNumericField T="int" @bind-Value="_interval" Label="@WebStrings.MonitoringInterval" Variant="Variant.Outlined" Margin="Margin.Dense"
                             Min="MonitoringSettings.ShortestInterval" Max="MonitoringSettings.LongestInterval" Immediate="true"
                             HelperText="@WebStrings.Format(WebStrings.MonitoringIntervalHelp, MonitoringSettings.ShortestInterval, MonitoringSettings.LongestInterval)" Class="mb-3" />

            <MudNumericField T="int" @bind-Value="_roundsDown" Label="@WebStrings.MonitoringRoundsDown" Variant="Variant.Outlined" Margin="Margin.Dense"
                             Min="1" Max="MonitoringSettings.MostRounds" Immediate="true"
                             HelperText="@DownHint" Class="mb-3" />

            <MudNumericField T="int" @bind-Value="_roundsUp" Label="@WebStrings.MonitoringRoundsUp" Variant="Variant.Outlined" Margin="Margin.Dense"
                             Min="1" Max="MonitoringSettings.MostRounds" Immediate="true" Class="mb-4" />

            <div class="d-flex align-center justify-space-between mb-4">
                <div>
                    <MudText Typo="Typo.body2">@WebStrings.MonitoringTestAfterReconnect</MudText>
                    <MudText Typo="Typo.caption" Class="sw-muted">@WebStrings.MonitoringTestAfterReconnectDescription</MudText>
                </div>
                <MudSwitch @bind-Value="_testAfterReconnect" Color="Color.Primary" />
            </div>

            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!Dirty || !Valid)" OnClick="SaveAsync">
                @WebStrings.MonitoringSave
            </MudButton>
        </SurfaceCard>
    </MudItem>

    <MudItem xs="12" md="6">
        <SurfaceCard Icon="@Icons.Material.Filled.Insights" Title="@WebStrings.MonitoringStoredTitle"
                     Description="@WebStrings.MonitoringStoredDescription">
            <DataRow Label="@WebStrings.MonitoringRoundPassesLabel" Value="@WebStrings.MonitoringRoundPasses" />
            <DataRow Label="@WebStrings.MonitoringRoundsDuringTestLabel" Value="@WebStrings.MonitoringRoundsDuringTest" />
            <DataRow Label="@WebStrings.MonitoringUptimeCountsLabel" Value="@WebStrings.MonitoringUptimeCounts" />
            <DataRow Label="@WebStrings.Bufferbloat" Value="@WebStrings.MonitoringBufferbloatSampled" />
            <MudText Typo="Typo.caption" Class="sw-muted d-block mt-3">
                @WebStrings.MonitoringRestartNote
            </MudText>
            <MudLink Href="uptime" Class="d-block mt-3">@WebStrings.MonitoringSeeUptime</MudLink>
        </SurfaceCard>
    </MudItem>
</MudGrid>

@code {
    private bool _enabled;
    private int _interval = 15;
    private int _roundsDown = 3;
    private int _roundsUp = 2;
    private bool _testAfterReconnect;

    private MonitoringSettings Saved => Settings.Current.Monitoring;

    private static RenderFragment GeneralSettingsLink => @<MudLink Href="settings/general">@WebStrings.MonitoringTargetsLink</MudLink>;

    private string TargetSummary => Saved.Targets.Count switch
    {
        0 => WebStrings.MonitoringNoTargets,
        1 => Saved.Targets[0].ToString(),
        _ => string.Join(", ", Saved.Targets)
    };

    private bool Valid =>
        _interval is >= MonitoringSettings.ShortestInterval and <= MonitoringSettings.LongestInterval
        && _roundsDown is >= 1 and <= MonitoringSettings.MostRounds
        && _roundsUp is >= 1 and <= MonitoringSettings.MostRounds;

    private bool Dirty =>
        _enabled != Saved.Enabled
        || _interval != Saved.IntervalSeconds
        || _roundsDown != Saved.RoundsToGoDown
        || _roundsUp != Saved.RoundsToGoUp
        || _testAfterReconnect != Saved.TestAfterReconnect;

    private string DownHint => WebStrings.Format(WebStrings.MonitoringDownHint, Duration.Describe(TimeSpan.FromSeconds(_interval * Math.Max(_roundsDown - 1, 0))));

    protected override void OnInitialized()
    {
        _enabled = Saved.Enabled;
        _interval = Saved.IntervalSeconds;
        _roundsDown = Saved.RoundsToGoDown;
        _roundsUp = Saved.RoundsToGoUp;
        _testAfterReconnect = Saved.TestAfterReconnect;
    }

    private async Task SaveAsync()
    {
        var result = await Settings.SaveAsync(
            ("monitoringEnabled", _enabled ? "true" : "false"),
            ("monitoringInterval", _interval.ToString(CultureInfo.InvariantCulture)),
            ("monitoringRoundsDown", _roundsDown.ToString(CultureInfo.InvariantCulture)),
            ("monitoringRoundsUp", _roundsUp.ToString(CultureInfo.InvariantCulture)),
            ("monitoringTestAfterReconnect", _testAfterReconnect ? "true" : "false"));

        if (result.Succeeded) Snackbar.Add(WebStrings.MonitoringSaved, Severity.Success);
        else Snackbar.Add(result.Message ?? SettingsState.SaveFailed, Severity.Error);
    }
}
