@using System.Globalization
@inject SettingsState Settings
@inject ISnackbar Snackbar

<MudGrid Spacing="4">
    <MudItem xs="12" md="6">
        <SurfaceCard Icon="@Icons.Material.Filled.MonitorHeart" Title="Connection Monitoring"
                     Description="Opens a TCP connection to each target on a short interval, so outages are recorded with their start and end even when no speedtest is running. The same targets measure bufferbloat around every test.">
            <div class="d-flex align-center justify-space-between mb-4">
                <div>
                    <MudText Typo="Typo.body2">Watch the connection</MudText>
                    <MudText Typo="Typo.caption" Class="sw-muted">Off means no outages and no uptime. Bufferbloat still uses the targets below.</MudText>
                </div>
                <MudSwitch @bind-Value="_enabled" Color="Color.Primary" />
            </div>

            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-3">
                Probing @TargetSummary. The targets are under
                <MudLink Href="settings/general">Settings → General</MudLink>, because bufferbloat uses them too.
            </MudAlert>

            <MudNumericField T="int" @bind-Value="_interval" Label="Probe interval (seconds)" Variant="Variant.Outlined" Margin="Margin.Dense"
                             Min="MonitoringSettings.ShortestInterval" Max="MonitoringSettings.LongestInterval" Immediate="true"
                             HelperText="@($"Between {MonitoringSettings.ShortestInterval} and {MonitoringSettings.LongestInterval} seconds")" Class="mb-3" />

            <MudNumericField T="int" @bind-Value="_roundsDown" Label="Failed rounds before down" Variant="Variant.Outlined" Margin="Margin.Dense"
                             Min="1" Max="MonitoringSettings.MostRounds" Immediate="true"
                             HelperText="@DownHint" Class="mb-3" />

            <MudNumericField T="int" @bind-Value="_roundsUp" Label="Good rounds before up again" Variant="Variant.Outlined" Margin="Margin.Dense"
                             Min="1" Max="MonitoringSettings.MostRounds" Immediate="true" Class="mb-4" />

            <div class="d-flex align-center justify-space-between mb-4">
                <div>
                    <MudText Typo="Typo.body2">Test after a reconnect</MudText>
                    <MudText Typo="Typo.caption" Class="sw-muted">Runs a speedtest when the line comes back, at most once an hour</MudText>
                </div>
                <MudSwitch @bind-Value="_testAfterReconnect" Color="Color.Primary" />
            </div>

            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!Dirty || !Valid)" OnClick="SaveAsync">
                Save Monitoring
            </MudButton>
        </SurfaceCard>
    </MudItem>

    <MudItem xs="12" md="6">
        <SurfaceCard Icon="@Icons.Material.Filled.Insights" Title="What Gets Stored"
                     Description="Every round is kept for 30 days for the latency history. Outages are kept as long as your results.">
            <DataRow Label="A round passes when" Value="most targets answer within 2 seconds" />
            <DataRow Label="Rounds during a speedtest" Value="count for latency, never start an outage" />
            <DataRow Label="Uptime counts" Value="only the time the app was watching" />
            <DataRow Label="Bufferbloat" Value="sampled around every test, watching or not" />
            <MudText Typo="Typo.caption" Class="sw-muted d-block mt-3">
                A restart or a stopped container is neither uptime nor downtime, so a week away doesn't show as a week offline.
            </MudText>
            <MudLink Href="uptime" Class="d-block mt-3">See the Uptime page</MudLink>
        </SurfaceCard>
    </MudItem>
</MudGrid>

@code {
    private bool _enabled;
    private int _interval = 15;
    private int _roundsDown = 3;
    private int _roundsUp = 2;
    private bool _testAfterReconnect;

    private MonitoringSettings Saved => Settings.Current.Monitoring;

    private string TargetSummary => Saved.Targets.Count switch
    {
        0 => "nothing, because no targets are set",
        1 => Saved.Targets[0].ToString(),
        _ => string.Join(", ", Saved.Targets)
    };

    private bool Valid =>
        _interval is >= MonitoringSettings.ShortestInterval and <= MonitoringSettings.LongestInterval
        && _roundsDown is >= 1 and <= MonitoringSettings.MostRounds
        && _roundsUp is >= 1 and <= MonitoringSettings.MostRounds;

    private bool Dirty =>
        _enabled != Saved.Enabled
        || _interval != Saved.IntervalSeconds
        || _roundsDown != Saved.RoundsToGoDown
        || _roundsUp != Saved.RoundsToGoUp
        || _testAfterReconnect != Saved.TestAfterReconnect;

    private string DownHint => $"About {Duration.Describe(TimeSpan.FromSeconds(_interval * Math.Max(_roundsDown - 1, 0)))} of silence before an outage starts";

    protected override void OnInitialized()
    {
        _enabled = Saved.Enabled;
        _interval = Saved.IntervalSeconds;
        _roundsDown = Saved.RoundsToGoDown;
        _roundsUp = Saved.RoundsToGoUp;
        _testAfterReconnect = Saved.TestAfterReconnect;
    }

    private async Task SaveAsync()
    {
        var result = await Settings.SaveAsync(
            ("monitoringEnabled", _enabled ? "true" : "false"),
            ("monitoringInterval", _interval.ToString(CultureInfo.InvariantCulture)),
            ("monitoringRoundsDown", _roundsDown.ToString(CultureInfo.InvariantCulture)),
            ("monitoringRoundsUp", _roundsUp.ToString(CultureInfo.InvariantCulture)),
            ("monitoringTestAfterReconnect", _testAfterReconnect ? "true" : "false"));

        if (result.Succeeded) Snackbar.Add("Monitoring saved", Severity.Success);
        else Snackbar.Add(result.Message ?? SettingsState.SaveFailed, Severity.Error);
    }
}
