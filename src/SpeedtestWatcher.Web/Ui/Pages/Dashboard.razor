@page "/"
@using System.Data.Common
@using System.Globalization
@inject StatisticsService Statistics
@inject MonitoringService Monitoring
@inject PauseService Pause
@inject ICurrentAccess Access
@inject PreferencesService PreferencesService
@inject SettingsState Settings
@inject RecentResults RecentResults
@inject StatusStateService StatusService
@inject ISnackbar Snackbar
@implements IDisposable

<PageTitle>@ProjectInfo.Name - @WebStrings.DashboardTitle</PageTitle>

<PageHeader Title="@WebStrings.DashboardTitle" Subtitle="@RangeSubtitle">
    <Actions>
        @if (_range == CustomRange)
        {
            <MudDateRangePicker DateRange="@(new DateRange(_from, _to))" DateRangeChanged="SetCustomRangeAsync"
                                PlaceholderStart="@WebStrings.DashboardFrom" PlaceholderEnd="@WebStrings.DashboardTo" AutoClose="true"
                                DateFormat="@DisplayFormat.DatePattern(Settings.Current.Display.DateFormat)"
                                Variant="Variant.Outlined" Margin="Margin.Dense" Class="sw-range-picker" />
        }
        <MudToggleGroup T="string" Value="_range" ValueChanged="SelectRangeAsync!" SelectionMode="SelectionMode.SingleSelection"
                        Color="Color.Primary" Size="Size.Small" Outlined="true" Delimiters="true" CheckMark="false"
                        SelectedClass="sw-range-selected" Class="sw-range-toggle">
            @foreach (var option in RangeOptions)
            {
                <MudToggleItem Value="@option.Id" Text="@option.Title" />
            }
        </MudToggleGroup>
    </Actions>
</PageHeader>

@if (StatusService.Paused)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="mb-4">
        <div class="d-flex flex-wrap align-center justify-space-between gap-3">
            <span>@WebStrings.PausedNotice</span>
            @if (Access.HasFullAccess)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Inherit" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="Resume">
                    @WebStrings.Resume
                </MudButton>
            }
        </div>
    </MudAlert>
}

<StateView Loading="_loading" Empty="@(_stats == null || _stats.Tests.Total == 0)"
           EmptyMessage="@WebStrings.DashboardNoTests"
           ErrorMessage="@(_loadFailed ? WebStrings.DashboardLoadFailed : null)" OnRetry="LoadStatisticsAsync">
    <ChildContent>
        @if (_stats != null)
        {
            <MudGrid Spacing="4" Class="mb-4">
                <MudItem xs="12" md="4">
                    <StatTile Icon="@Icons.Material.Filled.Download" Title="@WebStrings.Download"
                              Value="@SpeedValue(_stats.Download?.Avg)" Unit="@PreferencesService.SpeedUnit" Label="@WebStrings.DashboardAverage"
                              Color="@MetricStatus.Download(_stats.Download?.Avg, Targets.Download)">
                        <DataRow Label="@WebStrings.DashboardRange" Value="@SpeedRange(_stats.Download)" />
                        <DataRow Label="@WebStrings.DashboardConsistency">
                            <MudText Typo="Typo.body2" Color="@ConsistencyColor(_stats.Download, _stats.Consistency.Download)">@SpeedConsistency(_stats.Download, _stats.Consistency.Download)</MudText>
                        </DataRow>
                    </StatTile>
                </MudItem>

                <MudItem xs="12" md="4">
                    <StatTile Icon="@Icons.Material.Filled.Upload" Title="@WebStrings.Upload"
                              Value="@SpeedValue(_stats.Upload?.Avg)" Unit="@PreferencesService.SpeedUnit" Label="@WebStrings.DashboardAverage"
                              Color="@MetricStatus.Upload(_stats.Upload?.Avg, Targets.Upload)">
                        <DataRow Label="@WebStrings.DashboardRange" Value="@SpeedRange(_stats.Upload)" />
                        <DataRow Label="@WebStrings.DashboardConsistency">
                            <MudText Typo="Typo.body2" Color="@ConsistencyColor(_stats.Upload, _stats.Consistency.Upload)">@SpeedConsistency(_stats.Upload, _stats.Consistency.Upload)</MudText>
                        </DataRow>
                    </StatTile>
                </MudItem>

                <MudItem xs="12" md="4">
                    <StatTile Icon="@Icons.Material.Filled.NetworkPing" Title="@WebStrings.DashboardLatency"
                              Value="@(_stats.Ping?.Avg.ToString(CultureInfo.CurrentCulture) ?? NoValue)" Unit="ms" Label="@PingLabel"
                              Color="@MetricStatus.Ping(_stats.Ping?.Avg, Targets.Ping)">
                        <DataRow Label="@WebStrings.DashboardRange" Value="@PingRange" />
                        <DataRow Label="@WebStrings.DashboardConsistency" Value="@PingConsistency" />
                    </StatTile>
                </MudItem>

                <MudItem xs="12" lg="4">
                    <SurfaceCard Icon="@Icons.Material.Filled.Waves" Title="@WebStrings.DashboardUnderLoad" Description="@WebStrings.DashboardUnderLoadDescription">
                        <div class="sw-metric-columns">
                            <MetricDisplay Size="MetricSize.Small" Icon="@Icons.Material.Filled.Download"
                                           Color="@MetricStatus.Bufferbloat(_stats.BufferbloatDown?.Avg, Targets.Bufferbloat)"
                                           Value="@Bloat(_stats.BufferbloatDown?.Avg)" Label="@WebStrings.DashboardUnderLoadDownload"
                                           Detail="@BloatMax(_stats.BufferbloatDown)" />
                            <MetricDisplay Size="MetricSize.Small" Icon="@Icons.Material.Filled.Upload"
                                           Color="@MetricStatus.Bufferbloat(_stats.BufferbloatUp?.Avg, Targets.Bufferbloat)"
                                           Value="@Bloat(_stats.BufferbloatUp?.Avg)" Label="@WebStrings.DashboardUnderLoadUpload"
                                           Detail="@BloatMax(_stats.BufferbloatUp)" />
                            @if (_stats.PacketLoss is { } packetLoss)
                            {
                                <MetricDisplay Size="MetricSize.Small" Icon="@Icons.Material.Filled.CallSplit"
                                               Color="@MetricStatus.PacketLoss(packetLoss.Avg, Targets.PacketLoss)"
                                               Value="@($"{packetLoss.Avg:F2}%")" Label="@WebStrings.DashboardPacketLoss"
                                               Detail="@WebStrings.Format(WebStrings.DashboardMaxDetail, $"{packetLoss.Max:F2}%")" />
                            }
                        </div>
                    </SurfaceCard>
                </MudItem>

                <MudItem xs="12" lg="4">
                    <SurfaceCard Icon="@Icons.Material.Filled.Schedule" Title="@WebStrings.DashboardLatestTest"
                                 Class="@(StatusService.Running ? "sw-running" : null)" Description="@LatestDescription">
                        @if (Latest == null)
                        {
                            <MudText Typo="Typo.body2" Class="sw-muted">@WebStrings.DashboardNoTestsYet</MudText>
                        }
                        else if (Latest.Status == TestStatus.Skipped)
                        {
                            <MudText Typo="Typo.body2" Class="sw-muted" Style="overflow-wrap:anywhere;">@WebStrings.Format(WebStrings.DashboardLatestSkipped, Latest.Error)</MudText>
                        }
                        else if (!string.IsNullOrEmpty(Latest.Error))
                        {
                            <MudText Typo="Typo.body2" Color="Color.Error">@SpeedtestErrors.Describe(Latest.Error)</MudText>
                        }
                        else
                        {
                            <div class="sw-metric-columns">
                                <MetricDisplay Size="MetricSize.Small" Icon="@Icons.Material.Filled.Download"
                                               Color="@MetricStatus.Download(Latest.Download, Targets.Download)"
                                               Value="@SpeedValue(Latest.Download)" Label="@PreferencesService.SpeedUnit" />
                                <MetricDisplay Size="MetricSize.Small" Icon="@Icons.Material.Filled.Upload"
                                               Color="@MetricStatus.Upload(Latest.Upload, Targets.Upload)"
                                               Value="@SpeedValue(Latest.Upload)" Label="@PreferencesService.SpeedUnit" />
                                <MetricDisplay Size="MetricSize.Small" Icon="@Icons.Material.Filled.NetworkPing"
                                               Color="@MetricStatus.Ping(Latest.Ping, Targets.Ping)"
                                               Value="@Latest.Ping.ToString(CultureInfo.CurrentCulture)"
                                               Label="@WebStrings.PingMs"
                                               Detail="@(Latest.Jitter is { } jitter ? WebStrings.Format(WebStrings.DashboardJitterDetail, jitter) : null)" />
                            </div>

                            @if (Latest.Healthy is { } healthy)
                            {
                                <div class="sw-chip-footer">
                                    <MudChip T="string" Size="Size.Small"
                                             Color="@(healthy ? Color.Success : Color.Warning)"
                                             Icon="@(healthy ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.TrendingDown)">
                                        @(healthy ? WebStrings.MetYourTargets : WebStrings.MissedYourTargets)
                                    </MudChip>
                                </div>
                            }
                        }
                    </SurfaceCard>
                </MudItem>

                <MudItem xs="12" lg="4">
                    <SurfaceCard Icon="@Icons.Material.Filled.Speed" Title="@WebStrings.DashboardTests" Description="@WebStrings.DashboardTestsDescription">
                        <div class="sw-metric-columns">
                            <MetricDisplay Size="MetricSize.Small" Icon="@Icons.Material.Filled.Speed"
                                           Value="@_stats.Tests.Total.ToString(CultureInfo.CurrentCulture)" Label="@WebStrings.DashboardTestsRun" />
                            <MetricDisplay Size="MetricSize.Small" Icon="@Icons.Material.Filled.Timer"
                                           Value="@(_stats.Time != null ? $"{_stats.Time.Avg} s" : NoValue)" Label="@WebStrings.DashboardPerTest" />
                            <MetricDisplay Size="MetricSize.Small" Icon="@Icons.Material.Filled.DataUsage"
                                           Value="@ByteSize.Describe(_stats.DataUsedBytes)" Label="@WebStrings.DashboardDataUsed" />
                        </div>

                        <div class="sw-chip-footer">
                            <MudChip T="string" Size="Size.Small"
                                     Color="@(_stats.Tests.Failed > 0 ? Color.Error : Color.Success)"
                                     Icon="@(_stats.Tests.Failed > 0 ? Icons.Material.Filled.ErrorOutline : Icons.Material.Filled.CheckCircle)">
                                @(_stats.Tests.Failed > 0 ? WebStrings.Format(WebStrings.DashboardFailedCount, _stats.Tests.Failed) : WebStrings.DashboardNoneFailed)
                            </MudChip>
                            @if (_uptimePercent is { } uptime)
                            {
                                <MudChip T="string" Size="Size.Small" Href="uptime"
                                         Color="@(uptime >= 99.9 ? Color.Success : Color.Warning)" Icon="@Icons.Material.Filled.MonitorHeart">
                                    @WebStrings.Format(WebStrings.DashboardUptimePercent, uptime)
                                </MudChip>
                            }
                        </div>
                    </SurfaceCard>
                </MudItem>
            </MudGrid>

            <MudBreakpointProvider OnBreakpointChanged="OnBreakpointChanged">
                @if (_charts.Labels.Length > 0)
                {
                    <MudGrid Spacing="4" Class="mb-4">
                        <MudItem xs="12" md="6" lg="@ChartColumns">
                            <ChartCard Title="@WebStrings.DashboardDownloadChart" ValueText="@PreferencesService.SpeedUnit" Class="sw-chart sw-chart-average"
                                       ChartType="ChartType.Line" ChartSeries="@_charts.Download" ChartLabels="@_charts.Labels" ChartOptions="@_downloadOptions"
                                       MaxLabels="2" Expandable="@(!_compact)" />
                        </MudItem>
                        <MudItem xs="12" md="6" lg="@ChartColumns">
                            <ChartCard Title="@WebStrings.DashboardUploadChart" ValueText="@PreferencesService.SpeedUnit" Class="sw-chart sw-chart-average"
                                       ChartType="ChartType.Line" ChartSeries="@_charts.Upload" ChartLabels="@_charts.Labels" ChartOptions="@_uploadOptions"
                                       MaxLabels="2" Expandable="@(!_compact)" />
                        </MudItem>
                        <MudItem xs="12" md="@(_charts.HasBufferbloat ? 6 : 12)" lg="@ChartColumns">
                            <ChartCard Title="@WebStrings.DashboardLatency" ValueText="ms" Class="sw-chart sw-chart-average"
                                       ChartType="ChartType.Line" ChartSeries="@_charts.Ping" ChartLabels="@_charts.Labels" ChartOptions="@_pingOptions"
                                       MaxLabels="2" Expandable="@(!_compact)" />
                        </MudItem>
                        @if (_charts.HasBufferbloat)
                        {
                            <MudItem xs="12" md="6" lg="@ChartColumns">
                                <ChartCard Title="@WebStrings.Bufferbloat" ValueText="ms" Class="sw-chart"
                                           ChartType="ChartType.Line" ChartSeries="@_charts.Bufferbloat" ChartLabels="@_charts.BufferbloatLabels" ChartOptions="@_bufferbloatOptions"
                                           MaxLabels="2" Expandable="@(!_compact)" />
                            </MudItem>
                        }
                    </MudGrid>
                }

                @if (_stats.HourlyAverages.Any(h => h.Count > 0))
                {
                    <SurfaceCard Icon="@Icons.Material.Filled.AccessTime" Title="@WebStrings.DashboardByTimeOfDay" FullHeight="false" Class="mb-4"
                                 Description="@WebStrings.DashboardByTimeOfDayDescription">
                        <div class="sw-hourly-scroll">
                            <table class="sw-hourly-table">
                                <colgroup>
                                    <col class="sw-hourly-name-col" />
                                    @for (var hour = 0; hour < 24; hour++)
                                    {
                                        <col />
                                    }
                                </colgroup>
                                <thead>
                                    <tr>
                                        <th class="sw-hourly-name"></th>
                                        @foreach (var hour in _stats.HourlyAverages)
                                        {
                                            <th scope="col" title="@TestCount(hour.Count)">@HourHeader(hour.Hour)</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <th scope="row" class="sw-hourly-name">@WebStrings.Download <span class="sw-muted">@PreferencesService.SpeedUnit</span></th>
                                        @foreach (var hour in _stats.HourlyAverages)
                                        {
                                            <td style="@CellColor(MetricStatus.Download(hour.Download, Targets.Download))">@SpeedCell(hour.Download)</td>
                                        }
                                    </tr>
                                    <tr>
                                        <th scope="row" class="sw-hourly-name">@WebStrings.Upload <span class="sw-muted">@PreferencesService.SpeedUnit</span></th>
                                        @foreach (var hour in _stats.HourlyAverages)
                                        {
                                            <td style="@CellColor(MetricStatus.Upload(hour.Upload, Targets.Upload))">@SpeedCell(hour.Upload)</td>
                                        }
                                    </tr>
                                    <tr>
                                        <th scope="row" class="sw-hourly-name">@WebStrings.Ping <span class="sw-muted">ms</span></th>
                                        @foreach (var hour in _stats.HourlyAverages)
                                        {
                                            <td style="@CellColor(MetricStatus.Ping(hour.Ping, Targets.Ping))">@(hour.Ping?.ToString(CultureInfo.CurrentCulture) ?? "—")</td>
                                        }
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </SurfaceCard>
                }
            </MudBreakpointProvider>

            @if (_failures.Count > 0)
            {
                <SurfaceCard Icon="@Icons.Material.Filled.ErrorOutline" Title="@WebStrings.DashboardFailedTests" FullHeight="false"
                             Description="@WebStrings.Format(WebStrings.DashboardFailedInPeriod, _failures.Count)">
                    @foreach (var failure in _failures)
                    {
                        <DataRow Label="@failure.Time">
                            <MudText Typo="Typo.body2" Color="Color.Error" Class="text-end">@failure.Message</MudText>
                        </DataRow>
                    }
                </SurfaceCard>
            }
        }
    </ChildContent>
</StateView>

@code {
    private sealed record FailureRow(string Time, string Message);

    private const string CustomRange = "custom";
    private const string NoValue = "—";

    private static (string Id, string Title)[] RangeOptions =>
    [
        ("24h", WebStrings.DashboardRange24Hours),
        ("7d", WebStrings.SevenDays),
        ("30d", WebStrings.ThirtyDays),
        (CustomRange, WebStrings.Custom)
    ];

    private string _range = "7d";
    private DateTime? _from;
    private DateTime? _to;
    private SpeedtestStatistics? _stats;
    private double? _uptimePercent;
    private bool _loading;
    private bool _loadFailed;

    private DashboardCharts _charts = DashboardCharts.Empty;
    private List<FailureRow> _failures = [];
    private bool _compact;

    private readonly LineChartOptions _downloadOptions = new() { LineStrokeWidth = 2, YAxisLines = true, XAxisLines = false, ChartPalette = [MetricStatus.ChartDownload, MetricStatus.ChartAverage] };
    private readonly LineChartOptions _uploadOptions = new() { LineStrokeWidth = 2, YAxisLines = true, XAxisLines = false, ChartPalette = [MetricStatus.ChartUpload, MetricStatus.ChartAverage] };
    private readonly LineChartOptions _pingOptions = new() { LineStrokeWidth = 2, YAxisLines = true, XAxisLines = false, ChartPalette = [MetricStatus.ChartPing, MetricStatus.ChartJitter, MetricStatus.ChartAverage] };
    private readonly LineChartOptions _bufferbloatOptions = new() { LineStrokeWidth = 2, YAxisLines = true, XAxisLines = false, ChartPalette = [MetricStatus.ChartDownload, MetricStatus.ChartUpload] };

    private TargetSettings Targets => Settings.Current.Targets;

    private int ChartColumns => _charts.HasBufferbloat ? 3 : 4;

    private SpeedtestDto? Latest => RecentResults.Latest;

    private string RangeSubtitle =>
        $"{(_from ?? Today.AddDays(-7)).ToString("d MMM", CultureInfo.CurrentCulture)} – {(_to ?? Today).ToString("d MMM yyyy", CultureInfo.CurrentCulture)}";

    private DateTime Today => PreferencesService.Now.Date;

    private string? LatestDescription => Latest == null
        ? null
        : PreferencesService.FormatDateTime(PreferencesService.ToLocal(Latest.Created));

    protected override async Task OnInitializedAsync()
    {
        RecentResults.OnChange += OnStateChanged;
        StatusService.OnChange += OnStateChanged;
        Settings.OnChange += OnStateChanged;

        var configured = Settings.Current.Display.ChartRange;
        _range = RangeOptions.Any(option => option.Id == configured) ? configured : "7d";
        ApplyRange();

        await LoadStatisticsAsync();
    }

    private async Task SelectRangeAsync(string range)
    {
        _range = range;
        ApplyRange();
        await LoadStatisticsAsync();
    }

    private async Task SetCustomRangeAsync(DateRange? range)
    {
        if (range?.Start == null || range.End == null) return;

        _from = range.Start;
        _to = range.End;
        await LoadStatisticsAsync();
    }

    private void ApplyRange()
    {
        var now = PreferencesService.Now;
        switch (_range)
        {
            case "24h":
                _from = now.AddDays(-1);
                _to = now;
                break;
            case "30d":
                _from = now.AddDays(-30);
                _to = now;
                break;
            case "7d":
                _from = now.AddDays(-7);
                _to = now;
                break;
        }
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    private async Task LoadStatisticsAsync()
    {
        _loading = true;
        StateHasChanged();

        var pattern = _range == CustomRange ? "yyyy-MM-dd" : "s";
        var from = (_from ?? Today.AddDays(-7)).ToString(pattern, CultureInfo.InvariantCulture);
        var to = (_to ?? Today).ToString(pattern, CultureInfo.InvariantCulture);
        try
        {
            var result = await Statistics.GetAsync(from, to, PreferencesService.TimeZone.Id);
            _loadFailed = !result.Succeeded;
            if (result.Value is { } statistics)
            {
                _stats = statistics;
                BuildCharts(statistics);
                _uptimePercent = (await Monitoring.UptimeAsync(statistics.DateRange.FromUtc, statistics.DateRange.ToUtc)).Percent;
            }
        }
        catch (Exception ex) when (ex is DbException or InvalidOperationException)
        {
            _loadFailed = true;
        }

        _loading = false;
        StateHasChanged();
    }

    private void BuildCharts(SpeedtestStatistics statistics)
    {
        var beginAtZero = Settings.Current.Display.ChartBeginAtZero;
        _charts = DashboardCharts.Build(statistics.ChartPoints, value => PreferencesService.ConvertSpeed(value), ChartLabel, beginAtZero);

        _downloadOptions.YAxisTicks = _charts.TickSteps.Download;
        _uploadOptions.YAxisTicks = _charts.TickSteps.Upload;
        _pingOptions.YAxisTicks = _charts.TickSteps.Ping;
        _bufferbloatOptions.YAxisTicks = _charts.TickSteps.Bufferbloat;

        _downloadOptions.YAxisRequireZeroPoint = beginAtZero;
        _uploadOptions.YAxisRequireZeroPoint = beginAtZero;
        _pingOptions.YAxisRequireZeroPoint = beginAtZero;
        _bufferbloatOptions.YAxisRequireZeroPoint = beginAtZero;

        _downloadOptions.ShowDataMarkers = _charts.ShowMarkers;
        _uploadOptions.ShowDataMarkers = _charts.ShowMarkers;
        _pingOptions.ShowDataMarkers = _charts.ShowMarkers;
        _bufferbloatOptions.ShowDataMarkers = _charts.ShowBufferbloatMarkers;

        _failures = _charts.Failures
            .Select(point => new FailureRow(PreferencesService.FormatDateTime(PreferencesService.ToLocal(point.Time)), SpeedtestErrors.Describe(point.Error)))
            .ToList();
    }

    private string ChartLabel(DateTime utc)
    {
        var local = PreferencesService.ToLocal(utc);
        var time = local.ToString(PreferencesService.TimeFormat == "12h" ? "h:mm tt" : "HH:mm", CultureInfo.InvariantCulture);
        return $"{local.ToString(DisplayFormat.DayAndMonthPattern(PreferencesService.DateFormat), CultureInfo.InvariantCulture)} {time}";
    }

    private string HourHeader(int hour) => PreferencesService.TimeFormat == "12h"
        ? WebStrings.Format(hour < 12 ? WebStrings.DashboardHourAm : WebStrings.DashboardHourPm, hour % 12 == 0 ? 12 : hour % 12)
        : $"{hour:D2}";

    private static string TestCount(int count) =>
        count == 1 ? WebStrings.DashboardOneTest : WebStrings.Format(WebStrings.DashboardTestCount, count);

    private string SpeedCell(double? mbps) => mbps is { } value ? $"{PreferencesService.ConvertSpeed(value):F0}" : NoValue;

    private static string CellColor(Color color) => color == Color.Default ? "" : $"color: {MetricStatus.CssVar(color)}";

    private void OnBreakpointChanged(Breakpoint breakpoint) => _compact = breakpoint is Breakpoint.Xs or Breakpoint.Sm;

    private string SpeedValue(double? mbps) => mbps is { } value ? $"{PreferencesService.ConvertSpeed(value):F1}" : NoValue;

    private string SpeedRange(MetricStatsDto<double>? stats) =>
        stats is null ? NoValue : WebStrings.Format(WebStrings.DashboardRangeValue, SpeedValue(stats.Min), SpeedValue(stats.Max));

    private string SpeedConsistency(MetricStatsDto<double>? stats, ConsistencyItemDto consistency) => stats is null
        ? NoValue
        : WebStrings.Format(WebStrings.DashboardConsistencyValue, consistency.Consistency, SpeedValue(consistency.StdDev));

    private static Color ConsistencyColor(MetricStatsDto<double>? stats, ConsistencyItemDto consistency) => stats is null
        ? Color.Default
        : consistency.Consistency >= 90 ? Color.Success : consistency.Consistency >= 70 ? Color.Warning : Color.Error;

    private string PingLabel => _stats?.Jitter is { } jitter
        ? WebStrings.Format(WebStrings.DashboardAveragePingWithJitter, jitter.Avg)
        : WebStrings.DashboardAveragePing;

    private string PingRange => _stats?.Ping is { } ping ? WebStrings.Format(WebStrings.DashboardRangeValue, ping.Min, ping.Max) : NoValue;

    private string PingConsistency => _stats?.Ping != null ? $"±{_stats.Consistency.Ping.StdDev:F1}" : NoValue;

    private static string Bloat(double? milliseconds) => milliseconds is { } value ? $"+{value:F0} ms" : NoValue;

    private static string? BloatMax(MetricStatsDto<double>? stats) =>
        stats is null ? null : WebStrings.Format(WebStrings.DashboardMaxDetail, $"{stats.Max:F0} ms");

    private void Resume()
    {
        if (!Pause.Resume().Succeeded)
        {
            Snackbar.Add(WebStrings.ResumeFailed, Severity.Error);
            return;
        }

        Snackbar.Add(WebStrings.Resumed, Severity.Success);
    }

    public void Dispose()
    {
        RecentResults.OnChange -= OnStateChanged;
        StatusService.OnChange -= OnStateChanged;
        Settings.OnChange -= OnStateChanged;
    }
}
