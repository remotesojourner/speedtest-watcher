@page "/uptime"
@using System.Globalization
@inject MonitoringService Monitoring
@inject ICurrentAccess Access
@inject SettingsState Settings
@inject PreferencesService PreferencesService
@inject StatusStateService StatusService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@implements IDisposable

<PageTitle>@ProjectInfo.Name - @WebStrings.UptimeTitle</PageTitle>

<PageHeader Title="@WebStrings.UptimeTitle" Subtitle="@WebStrings.UptimeSubtitle" />

<StateView Loading="@(_status == null)">
    @if (_status is { } status)
    {
        @if (!status.Watching)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-6">
                @WebStrings.UptimeMonitoringOff
            </MudAlert>
        }

        <MudGrid Spacing="4" Class="mb-4">
            <MudItem xs="12" lg="6">
                <SurfaceCard Icon="@Icons.Material.Filled.MonitorHeart" Title="@WebStrings.UptimeConnection"
                             Description="@WebStrings.Format(WebStrings.UptimeConnectionDescription, Duration.Describe(TimeSpan.FromSeconds(Interval)))">
                    <MudText Typo="Typo.h4" Class="sw-hero-value font-weight-bold" Color="@StateColor(status.Health)">@StateText(status.Health)</MudText>
                    <MudText Typo="Typo.caption" Class="sw-muted d-block mt-1 mb-4">@SinceLabel(status)</MudText>
                    <div class="sw-metric-columns">
                        @foreach (var (label, uptime) in Periods(status))
                        {
                            <MetricDisplay Size="MetricSize.Large" Dense="true" Color="@UptimeColor(uptime)"
                                           Value="@Percent(uptime)" Label="@label" />
                        }
                    </div>
                    <MudDivider Class="my-3" />
                    <div class="sw-row-columns">
                        <DataRow Label="@WebStrings.UptimeAnswerTime" Value="@(status.FastestMilliseconds is { } fastest ? $"{fastest:F0} ms" : NoValue)" />
                        <DataRow Label="@WebStrings.UptimeDownLast30Days" Value="@Duration.Describe(TimeSpan.FromSeconds(status.Last30Days.DownSeconds))" />
                        <DataRow Label="@WebStrings.UptimeLastOutage" Value="@LastOutage" />
                        <DataRow Label="@WebStrings.UptimeOutagesLast30Days" Value="@status.Last30Days.Outages.ToString(CultureInfo.InvariantCulture)" />
                    </div>
                    @if (status.CurrentOutage is { } current)
                    {
                        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mt-3">
                            @WebStrings.Format(WebStrings.UptimeDownFor, Duration.Describe(TimeSpan.FromSeconds(current.Seconds ?? 0)), PreferencesService.FormatDateTime(PreferencesService.ToLocal(current.StartedAt)))
                        </MudAlert>
                    }
                </SurfaceCard>
            </MudItem>

            <MudItem xs="12" lg="6">
                <SurfaceCard Icon="@Icons.Material.Filled.CalendarMonth" Title="@WebStrings.UptimeLastYear">
                    <div class="sw-uptime-calendar">
                        @foreach (var month in Months())
                        {
                            <MudText Typo="Typo.caption" Class="sw-muted sw-uptime-month">@month.Label</MudText>
                            @foreach (var day in month.Days)
                            {
                                if (day is { } known)
                                {
                                    <MudTooltip Text="@DayText(known)" Placement="Placement.Top">
                                        <div class="@DayClass(known)"></div>
                                    </MudTooltip>
                                }
                                else
                                {
                                    <div class="sw-uptime-day sw-uptime-empty"></div>
                                }
                            }
                        }
                    </div>
                    <div class="d-flex align-center gap-2 mt-3">
                        <MudText Typo="Typo.caption" Class="sw-muted">@WebStrings.UptimeKeyNoOutage</MudText>
                        <div class="sw-uptime-day sw-uptime-none"></div>
                        <div class="sw-uptime-day sw-uptime-brief"></div>
                        <div class="sw-uptime-day sw-uptime-short"></div>
                        <div class="sw-uptime-day sw-uptime-long"></div>
                        <MudText Typo="Typo.caption" Class="sw-muted">@WebStrings.UptimeKeyHoursDown</MudText>
                    </div>
                </SurfaceCard>
            </MudItem>
        </MudGrid>

        <SurfaceCard Icon="@Icons.Material.Filled.Timeline" Title="@WebStrings.UptimeLatency"
                     Description="@WebStrings.UptimeLatencyDescription"
                     Class="mb-6">
            <div class="d-flex flex-wrap align-center justify-space-between gap-2 mb-3">
                <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small" OverrideStyles="false">
                    @foreach (var range in MonitoringService.LatencyRanges)
                    {
                        <MudButton Color="@(range.Id == _latencyRange ? Color.Primary : Color.Default)"
                                   Variant="@(range.Id == _latencyRange ? Variant.Filled : Variant.Outlined)"
                                   OnClick="@(() => SelectRangeAsync(range.Id))">
                            @range.Title
                        </MudButton>
                    }
                </MudButtonGroup>
                <MudText Typo="Typo.caption" Class="sw-muted">@LatencySummary</MudText>
            </div>

            <StateView Empty="@(_readings.Count == 0)" EmptyMessage="@WebStrings.UptimeNoRounds" Compact="true">
                <ChartCard Title="@WebStrings.UptimeAnswerTime" ValueText="ms" ChartType="ChartType.Line"
                           ChartSeries="@_latencySeries" ChartLabels="@_latencyLabels" ChartOptions="@_latencyOptions"
                           MaxLabels="2" Height="220px" />

                <div class="sw-latency-strip mt-3" style="@($"grid-template-columns:repeat({_latency.Count},minmax(0,1fr));")">
                    @foreach (var point in _latency)
                    {
                        <MudTooltip Text="@SlotText(point)" Placement="Placement.Top">
                            <div class="@SlotClass(point)"></div>
                        </MudTooltip>
                    }
                </div>
                <div class="d-flex flex-wrap align-center gap-2 mt-2">
                    <div class="sw-latency-slot sw-latency-key sw-latency-answered"></div>
                    <MudText Typo="Typo.caption" Class="sw-muted">@WebStrings.UptimeKeyAnswered</MudText>
                    <div class="sw-latency-slot sw-latency-key sw-latency-partly"></div>
                    <MudText Typo="Typo.caption" Class="sw-muted">@WebStrings.UptimeKeySomeFailed</MudText>
                    <div class="sw-latency-slot sw-latency-key sw-latency-silent"></div>
                    <MudText Typo="Typo.caption" Class="sw-muted">@WebStrings.UptimeKeyNoAnswer</MudText>
                    <div class="sw-latency-slot sw-latency-key sw-latency-testing"></div>
                    <MudText Typo="Typo.caption" Class="sw-muted">@WebStrings.UptimeKeyTesting</MudText>
                </div>
            </StateView>
        </SurfaceCard>

        <MudText Typo="Typo.h6" Class="font-weight-bold mb-3">@WebStrings.UptimeOutages</MudText>
        <StateView Empty="@(_outages.Count == 0)" EmptyMessage="@WebStrings.UptimeNoOutages">
            <MudPaper Elevation="1" Class="sw-surface">
                <MudSimpleTable Dense="true" Hover="true" Class="sw-table">
                    <thead>
                        <tr>
                            <th>@WebStrings.UptimeStarted</th>
                            <th>@WebStrings.UptimeEnded</th>
                            <th>@WebStrings.UptimeDownForColumn</th>
                            @if (FullAccess)
                            {
                                <th class="text-right">@WebStrings.UptimeRemove</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var outage in _outages)
                        {
                            <tr>
                                <td>@PreferencesService.FormatDateTime(PreferencesService.ToLocal(outage.StartedAt))</td>
                                <td>@(outage.EndedAt is { } ended ? PreferencesService.FormatDateTime(PreferencesService.ToLocal(ended)) : WebStrings.UptimeStillDown)</td>
                                <td>@Duration.Describe(TimeSpan.FromSeconds(outage.Seconds ?? 0))</td>
                                @if (FullAccess)
                                {
                                    <td class="text-right">
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                       aria-label="@WebStrings.Format(WebStrings.UptimeDeleteOutageLabel, outage.StartedAt)"
                                                       OnClick="@(() => DeleteAsync(outage))" />
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </MudPaper>
        </StateView>
    }
</StateView>

@code {
    private const int DaysInLongestMonth = 31;
    private const string NoValue = "—";

    private MonitoringStatusDto? _status;
    private IReadOnlyList<LatencyPointDto> _latency = [];
    private string _latencyRange = "24h";
    private List<ChartSeries<double>> _latencySeries = [];
    private string[] _latencyLabels = [];

    private readonly LineChartOptions _latencyOptions = new() { LineStrokeWidth = 2, YAxisLines = true, XAxisLines = false, ChartPalette = [MetricStatus.ChartPing] };
    private IReadOnlyList<OutageDto> _outages = [];
    private IReadOnlyList<UptimeDayDto> _days = [];

    private bool FullAccess => Access.HasFullAccess;

    private int Interval => Settings.Current.Monitoring.IntervalSeconds;

    protected override async Task OnInitializedAsync()
    {
        StatusService.OnChange += OnConnectionChanged;
        await LoadAsync();
    }

    public void Dispose() => StatusService.OnChange -= OnConnectionChanged;

    private void OnConnectionChanged() => InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    private async Task LoadAsync()
    {
        _status = await Monitoring.StatusAsync();
        _outages = await Monitoring.OutagesAsync(50);
        _days = await Monitoring.DaysAsync(PreferencesService.TimeZone.Id);
        await LoadLatencyAsync();
    }

    private async Task LoadLatencyAsync()
    {
        _latency = await Monitoring.LatencyAsync(_latencyRange);
        var answers = _readings.Select(point => point.Milliseconds!.Value).ToArray();
        _latencySeries = [new ChartSeries<double> { Name = WebStrings.UptimeAnswerTime, Data = answers }];
        _latencyLabels = [.. _readings.Select(point => LatencyLabel(point.At))];
        _latencyOptions.YAxisTicks = ChartAxisHelper.TickStep(answers);
        _latencyOptions.ShowDataMarkers = ChartAxisHelper.HasRoomForMarkers(answers.Length);
    }

    private async Task SelectRangeAsync(string range)
    {
        _latencyRange = range;
        await LoadLatencyAsync();
    }

    private IReadOnlyList<LatencyPointDto> _readings => [.. _latency.Where(point => point.Milliseconds.HasValue)];

    private string LatencySummary
    {
        get
        {
            if (_readings.Count == 0) return "";

            var failed = _latency.Sum(point => point.Failed);
            var median = _readings.Select(point => point.Milliseconds!.Value).Order().ElementAt(_readings.Count / 2);
            var typical = WebStrings.Format(WebStrings.UptimeTypical, median);
            return failed == 0
                ? typical
                : $"{typical} · {WebStrings.Format(failed == 1 ? WebStrings.UptimeFailedRound : WebStrings.UptimeFailedRounds, failed)}";
        }
    }

    private string LatencyLabel(DateTime at) =>
        MonitoringService.RangeFor(_latencyRange).Window >= TimeSpan.FromHours(24)
            ? PreferencesService.ToLocal(at).ToString("d MMM HH:mm", CultureInfo.CurrentCulture)
            : PreferencesService.ToLocal(at).ToString("HH:mm", CultureInfo.CurrentCulture);

    private string SlotClass(LatencyPointDto point) => point switch
    {
        { Rounds: > 0, Failed: 0 } when point.DuringTest > 0 => "sw-latency-slot sw-latency-testing",
        { Failed: 0 } => "sw-latency-slot sw-latency-answered",
        _ when point.Failed == point.Rounds => "sw-latency-slot sw-latency-silent",
        _ => "sw-latency-slot sw-latency-partly"
    };

    private string SlotText(LatencyPointDto point)
    {
        var when = PreferencesService.FormatDateTime(PreferencesService.ToLocal(point.At));
        var answer = point.Milliseconds is { } milliseconds ? $"{milliseconds:F1} ms" : WebStrings.UptimeSlotNoAnswer;
        var rounds = WebStrings.Format(point.Rounds == 1 ? WebStrings.UptimeSlotRound : WebStrings.UptimeSlotRounds, point.Rounds);
        var failed = WebStrings.Format(WebStrings.UptimeSlotFailed, point.Failed);
        var testing = point.DuringTest > 0 ? $", {WebStrings.Format(WebStrings.UptimeSlotDuringTest, point.DuringTest)}" : "";
        return $"{when} · {rounds}, {failed}{testing} · {answer}";
    }

    private IEnumerable<(string Label, UptimeDto Uptime)> Periods(MonitoringStatusDto status) =>
    [
        (WebStrings.Uptime24Hours, status.Last24Hours),
        (WebStrings.SevenDays, status.Last7Days),
        (WebStrings.ThirtyDays, status.Last30Days)
    ];

    private static string Percent(UptimeDto uptime) =>
        uptime.Percent is { } percent ? $"{percent:F2}%" : "—";

    private static Color UptimeColor(UptimeDto uptime) => uptime.Percent switch
    {
        null => Color.Default,
        >= 99.9 => Color.Success,
        >= 99 => Color.Warning,
        _ => Color.Error
    };

    private static string StateText(ConnectionHealth health) => health switch
    {
        ConnectionHealth.Up => WebStrings.UptimeOnline,
        ConnectionHealth.Down => WebStrings.Offline,
        _ => WebStrings.UptimeUnknown
    };

    private static Color StateColor(ConnectionHealth health) => health switch
    {
        ConnectionHealth.Up => Color.Success,
        ConnectionHealth.Down => Color.Error,
        _ => Color.Default
    };

    private string LastOutage => _outages.FirstOrDefault(outage => outage.EndedAt != null) is { EndedAt: { } ended }
        ? DisplayFormat.ToRelativeTime(ended)
        : WebStrings.UptimeNoOutageInAYear;

    private string SinceLabel(MonitoringStatusDto status) =>
        status.Since is { } since
            ? WebStrings.Format(WebStrings.UptimeSince, PreferencesService.FormatDateTime(PreferencesService.ToLocal(since)))
            : WebStrings.UptimeNoRoundsYet;

    private IEnumerable<(string Label, UptimeDayDto?[] Days)> Months()
    {
        foreach (var month in _days.GroupBy(day => (day.Date.Year, day.Date.Month)))
        {
            var days = new UptimeDayDto?[DaysInLongestMonth];
            foreach (var day in month) days[day.Date.Day - 1] = day;
            yield return (new DateTime(month.Key.Year, month.Key.Month, 1).ToString("MMM", CultureInfo.CurrentCulture), days);
        }
    }

    private string DayClass(UptimeDayDto day) => day.DownSeconds switch
    {
        0 => "sw-uptime-day sw-uptime-none",
        < 300 => "sw-uptime-day sw-uptime-brief",
        < 3600 => "sw-uptime-day sw-uptime-short",
        _ => "sw-uptime-day sw-uptime-long"
    };

    private string DayText(UptimeDayDto day) =>
        day.Outages == 0
            ? WebStrings.Format(WebStrings.UptimeDayNoOutages, day.Date)
            : WebStrings.Format(day.Outages == 1 ? WebStrings.UptimeDayOneOutage : WebStrings.UptimeDayOutages,
                day.Date, day.Outages, Duration.Describe(TimeSpan.FromSeconds(day.DownSeconds)));

    private async Task DeleteAsync(OutageDto outage)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            WebStrings.UptimeDeleteTitle,
            WebStrings.UptimeDeleteMessage,
            yesText: WebStrings.Delete, cancelText: WebStrings.Cancel);
        if (confirmed != true) return;

        var result = await Monitoring.DeleteOutageAsync(outage.Id);
        if (!result.Succeeded)
        {
            Snackbar.Add(result.Message ?? WebStrings.UptimeDeleteFailed, Severity.Error);
            return;
        }

        Snackbar.Add(WebStrings.UptimeDeleted, Severity.Success);
        await LoadAsync();
    }
}
