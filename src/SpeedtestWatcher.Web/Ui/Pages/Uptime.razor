@page "/uptime"
@using System.Globalization
@inject MonitoringService Monitoring
@inject ICurrentAccess Access
@inject SettingsState Settings
@inject PreferencesService PreferencesService
@inject StatusStateService StatusService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@implements IDisposable

<PageTitle>Speedtest Watcher - Uptime</PageTitle>

<PageHeader Title="Uptime" Subtitle="How often your line was down, as the connection monitor saw it." />

<StateView Loading="@(_status == null)">
    @if (_status is { } status)
    {
        @if (!status.Watching)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-6">
                Connection monitoring is off, so nothing is being watched. Turn it on under Settings → Monitoring.
            </MudAlert>
        }

        <MudGrid Spacing="4" Class="mb-2">
            <MudItem xs="12" md="6">
                <SurfaceCard Icon="@Icons.Material.Filled.MonitorHeart" Title="Right Now"
                             Description="@($"The monitor probes every {Duration.Describe(TimeSpan.FromSeconds(Interval))}.")">
                    <div class="d-flex flex-wrap align-center gap-6">
                        <MetricDisplay Size="MetricSize.Hero" Dense="true" Color="@StateColor(status.Health)"
                                       Value="@StateText(status.Health)" Label="@SinceLabel(status)" />
                        @if (status.FastestMilliseconds is { } fastest)
                        {
                            <MetricDisplay Size="MetricSize.Large" Icon="@Icons.Material.Filled.NetworkPing"
                                           Value="@($"{fastest:F0}")" Label="ms to answer" />
                        }
                    </div>
                    @if (status.CurrentOutage is { } current)
                    {
                        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mt-4">
                            Down for @Duration.Describe(TimeSpan.FromSeconds(current.Seconds ?? 0)), since @PreferencesService.FormatDateTime(PreferencesService.ToLocal(current.StartedAt)).
                        </MudAlert>
                    }
                </SurfaceCard>
            </MudItem>

            <MudItem xs="12" md="6">
                <SurfaceCard Icon="@Icons.Material.Filled.Percent" Title="Uptime"
                             Description="Only the time the app was watching counts, so a restart is neither uptime nor downtime.">
                    <div class="d-flex flex-wrap justify-space-between gap-4">
                        @foreach (var (label, uptime) in Periods(status))
                        {
                            <MetricDisplay Size="MetricSize.Large" Color="@UptimeColor(uptime)"
                                           Value="@Percent(uptime)" Label="@label" />
                        }
                    </div>
                    <MudDivider Class="my-3" />
                    <DataRow Label="Down in the last 30 days" Value="@Duration.Describe(TimeSpan.FromSeconds(status.Last30Days.DownSeconds))" />
                    <DataRow Label="Outages in the last 30 days" Value="@status.Last30Days.Outages.ToString(CultureInfo.InvariantCulture)" />
                </SurfaceCard>
            </MudItem>
        </MudGrid>

        <SurfaceCard Icon="@Icons.Material.Filled.Timeline" Title="Connection Latency"
                     Description="How long the quickest probe target took to answer. Rounds are averaged into slots, so a week is a few hundred points."
                     Class="mb-6">
            <div class="d-flex flex-wrap align-center justify-space-between gap-2 mb-3">
                <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small" OverrideStyles="false">
                    @foreach (var range in MonitoringService.LatencyRanges)
                    {
                        <MudButton Color="@(range.Id == _latencyRange ? Color.Primary : Color.Default)"
                                   Variant="@(range.Id == _latencyRange ? Variant.Filled : Variant.Outlined)"
                                   OnClick="@(() => SelectRangeAsync(range.Id))">
                            @range.Title
                        </MudButton>
                    }
                </MudButtonGroup>
                <MudText Typo="Typo.caption" Class="sw-muted">@LatencySummary</MudText>
            </div>

            <StateView Empty="@(_readings.Count == 0)" EmptyMessage="No probe rounds in this period yet." Compact="true">
                <ChartCard Title="Answer time" ValueText="ms" ChartType="ChartType.Line"
                           ChartSeries="@_latencySeries" ChartLabels="@_latencyLabels" ChartOptions="@_latencyOptions"
                           MaxLabels="2" Height="220px" />

                <div class="sw-latency-strip mt-3" style="@($"grid-template-columns:repeat({_latency.Count},minmax(0,1fr));")">
                    @foreach (var point in _latency)
                    {
                        <MudTooltip Text="@SlotText(point)" Placement="Placement.Top">
                            <div class="@SlotClass(point)"></div>
                        </MudTooltip>
                    }
                </div>
                <div class="d-flex flex-wrap align-center gap-2 mt-2">
                    <div class="sw-latency-slot sw-latency-key sw-latency-answered"></div>
                    <MudText Typo="Typo.caption" Class="sw-muted">Answered</MudText>
                    <div class="sw-latency-slot sw-latency-key sw-latency-partly"></div>
                    <MudText Typo="Typo.caption" Class="sw-muted">Some rounds failed</MudText>
                    <div class="sw-latency-slot sw-latency-key sw-latency-silent"></div>
                    <MudText Typo="Typo.caption" Class="sw-muted">No answer</MudText>
                    <div class="sw-latency-slot sw-latency-key sw-latency-testing"></div>
                    <MudText Typo="Typo.caption" Class="sw-muted">A speedtest was running</MudText>
                </div>
            </StateView>
        </SurfaceCard>

        <SurfaceCard Icon="@Icons.Material.Filled.CalendarMonth" Title="The Last Year"
                     Description="One square a day. The darker the square, the longer the line was down." Class="mb-6">
            <div class="sw-uptime-calendar">
                @foreach (var week in Weeks())
                {
                    <div class="sw-uptime-week">
                        @foreach (var day in week)
                        {
                            if (day is { } known)
                            {
                                <MudTooltip Text="@DayText(known)" Placement="Placement.Top">
                                    <div class="@DayClass(known)"></div>
                                </MudTooltip>
                            }
                            else
                            {
                                <div class="sw-uptime-day sw-uptime-empty"></div>
                            }
                        }
                    </div>
                }
            </div>
            <div class="d-flex align-center gap-2 mt-3">
                <MudText Typo="Typo.caption" Class="sw-muted">No outage</MudText>
                <div class="sw-uptime-day sw-uptime-none"></div>
                <div class="sw-uptime-day sw-uptime-brief"></div>
                <div class="sw-uptime-day sw-uptime-short"></div>
                <div class="sw-uptime-day sw-uptime-long"></div>
                <MudText Typo="Typo.caption" Class="sw-muted">Hours down</MudText>
            </div>
        </SurfaceCard>

        <MudText Typo="Typo.h6" Class="font-weight-bold mb-3">Outages</MudText>
        <StateView Empty="@(_outages.Count == 0)" EmptyMessage="No outages recorded yet.">
            <MudPaper Elevation="1" Class="sw-surface">
                <MudSimpleTable Dense="true" Hover="true" Class="sw-table">
                    <thead>
                        <tr>
                            <th>Started</th>
                            <th>Ended</th>
                            <th>Down for</th>
                            @if (FullAccess)
                            {
                                <th class="text-right">Remove</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var outage in _outages)
                        {
                            <tr>
                                <td>@PreferencesService.FormatDateTime(PreferencesService.ToLocal(outage.StartedAt))</td>
                                <td>@(outage.EndedAt is { } ended ? PreferencesService.FormatDateTime(PreferencesService.ToLocal(ended)) : "Still down")</td>
                                <td>@Duration.Describe(TimeSpan.FromSeconds(outage.Seconds ?? 0))</td>
                                @if (FullAccess)
                                {
                                    <td class="text-right">
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                       aria-label="@($"Delete the outage that started {outage.StartedAt:u}")"
                                                       OnClick="@(() => DeleteAsync(outage))" />
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </MudPaper>
        </StateView>
    }
</StateView>

@code {
    private MonitoringStatusDto? _status;
    private IReadOnlyList<LatencyPointDto> _latency = [];
    private string _latencyRange = "24h";
    private List<ChartSeries<double>> _latencySeries = [];
    private string[] _latencyLabels = [];

    private readonly LineChartOptions _latencyOptions = new() { LineStrokeWidth = 2, YAxisLines = true, XAxisLines = false, ChartPalette = [MetricStatus.ChartPing] };
    private IReadOnlyList<OutageDto> _outages = [];
    private IReadOnlyList<UptimeDayDto> _days = [];

    private bool FullAccess => Access.HasFullAccess;

    private int Interval => Settings.Current.Monitoring.IntervalSeconds;

    protected override async Task OnInitializedAsync()
    {
        StatusService.OnChange += OnConnectionChanged;
        await LoadAsync();
    }

    public void Dispose() => StatusService.OnChange -= OnConnectionChanged;

    private void OnConnectionChanged() => InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    private async Task LoadAsync()
    {
        _status = await Monitoring.StatusAsync();
        _outages = await Monitoring.OutagesAsync(50);
        _days = await Monitoring.DaysAsync(PreferencesService.TimeZone.Id);
        await LoadLatencyAsync();
    }

    private async Task LoadLatencyAsync()
    {
        _latency = await Monitoring.LatencyAsync(_latencyRange);
        var answers = _readings.Select(point => point.Milliseconds!.Value).ToArray();
        _latencySeries = [new ChartSeries<double> { Name = "Answer time", Data = answers }];
        _latencyLabels = [.. _readings.Select(point => LatencyLabel(point.At))];
        _latencyOptions.YAxisTicks = ChartAxisHelper.TickStep(answers);
        _latencyOptions.ShowDataMarkers = ChartAxisHelper.HasRoomForMarkers(answers.Length);
    }

    private async Task SelectRangeAsync(string range)
    {
        _latencyRange = range;
        await LoadLatencyAsync();
    }

    private IReadOnlyList<LatencyPointDto> _readings => [.. _latency.Where(point => point.Milliseconds.HasValue)];

    private string LatencySummary
    {
        get
        {
            if (_readings.Count == 0) return "";

            var failed = _latency.Sum(point => point.Failed);
            var median = _readings.Select(point => point.Milliseconds!.Value).Order().ElementAt(_readings.Count / 2);
            return failed == 0
                ? $"{median:F0} ms typical"
                : $"{median:F0} ms typical · {failed} failed round{(failed == 1 ? "" : "s")}";
        }
    }

    private string LatencyLabel(DateTime at) =>
        MonitoringService.RangeFor(_latencyRange).Window > TimeSpan.FromHours(24)
            ? PreferencesService.ToLocal(at).ToString("d MMM HH:mm", CultureInfo.CurrentCulture)
            : PreferencesService.ToLocal(at).ToString("HH:mm", CultureInfo.CurrentCulture);

    private string SlotClass(LatencyPointDto point) => point switch
    {
        { Rounds: > 0, Failed: 0 } when point.DuringTest > 0 => "sw-latency-slot sw-latency-testing",
        { Failed: 0 } => "sw-latency-slot sw-latency-answered",
        _ when point.Failed == point.Rounds => "sw-latency-slot sw-latency-silent",
        _ => "sw-latency-slot sw-latency-partly"
    };

    private string SlotText(LatencyPointDto point)
    {
        var when = PreferencesService.FormatDateTime(PreferencesService.ToLocal(point.At));
        var answer = point.Milliseconds is { } milliseconds ? $"{milliseconds:F1} ms" : "no answer";
        var testing = point.DuringTest > 0 ? $", {point.DuringTest} during a speedtest" : "";
        return $"{when} · {point.Rounds} round{(point.Rounds == 1 ? "" : "s")}, {point.Failed} failed{testing} · {answer}";
    }

    private IEnumerable<(string Label, UptimeDto Uptime)> Periods(MonitoringStatusDto status) =>
    [
        ("24 hours", status.Last24Hours),
        ("7 days", status.Last7Days),
        ("30 days", status.Last30Days)
    ];

    private static string Percent(UptimeDto uptime) =>
        uptime.Percent is { } percent ? $"{percent:F2}%" : "—";

    private static Color UptimeColor(UptimeDto uptime) => uptime.Percent switch
    {
        null => Color.Default,
        >= 99.9 => Color.Success,
        >= 99 => Color.Warning,
        _ => Color.Error
    };

    private static string StateText(ConnectionHealth health) => health switch
    {
        ConnectionHealth.Up => "Online",
        ConnectionHealth.Down => "Offline",
        _ => "Unknown"
    };

    private static Color StateColor(ConnectionHealth health) => health switch
    {
        ConnectionHealth.Up => Color.Success,
        ConnectionHealth.Down => Color.Error,
        _ => Color.Default
    };

    private string SinceLabel(MonitoringStatusDto status) =>
        status.Since is { } since ? $"since {PreferencesService.FormatDateTime(PreferencesService.ToLocal(since))}" : "no rounds yet";

    private IEnumerable<IReadOnlyList<UptimeDayDto?>> Weeks()
    {
        if (_days.Count == 0) yield break;

        List<UptimeDayDto?> squares = [.. Enumerable.Repeat<UptimeDayDto?>(null, DaysBeforeMonday(_days[0].Date)), .. _days];
        for (var start = 0; start < squares.Count; start += 7)
        {
            yield return squares.Skip(start).Take(7).ToList();
        }
    }

    private static int DaysBeforeMonday(DateOnly date) => ((int)date.DayOfWeek + 6) % 7;

    private string DayClass(UptimeDayDto day) => day.DownSeconds switch
    {
        0 => "sw-uptime-day sw-uptime-none",
        < 300 => "sw-uptime-day sw-uptime-brief",
        < 3600 => "sw-uptime-day sw-uptime-short",
        _ => "sw-uptime-day sw-uptime-long"
    };

    private string DayText(UptimeDayDto day) =>
        day.Outages == 0
            ? $"{day.Date:d MMM yyyy}: no outages"
            : $"{day.Date:d MMM yyyy}: {day.Outages} outage{(day.Outages == 1 ? "" : "s")}, {Duration.Describe(TimeSpan.FromSeconds(day.DownSeconds))} down";

    private async Task DeleteAsync(OutageDto outage)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete this outage?",
            "It stops counting against your uptime. This can't be undone.",
            yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true) return;

        var result = await Monitoring.DeleteOutageAsync(outage.Id);
        if (!result.Succeeded)
        {
            Snackbar.Add(result.Message ?? "Could not delete the outage", Severity.Error);
            return;
        }

        Snackbar.Add("Outage deleted", Severity.Success);
        await LoadAsync();
    }
}
