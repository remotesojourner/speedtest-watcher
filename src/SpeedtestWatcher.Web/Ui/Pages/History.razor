@page "/history"
@using System.Globalization
@inject RecentResults RecentResults
@inject ResultsService Results
@inject StatusStateService StatusService
@inject SettingsState Settings
@inject PreferencesService PreferencesService
@inject IDialogService DialogService
@implements IDisposable

<PageTitle>@ProjectInfo.Name - @WebStrings.HistoryTitle</PageTitle>

<MudPaper Elevation="1" Class="@($"{HeroClass()} pa-6 mb-6")">
    <div class="d-flex flex-wrap align-end justify-space-between gap-6">
        <MudTooltip Text="@WebStrings.HistoryDownloadTooltip"
                    Placement="Placement.Top">
            <MetricDisplay Size="MetricSize.Hero" Color="@DownloadColor"
                           Value="@(LatestReading != null ? $"{PreferencesService.ConvertSpeed(LatestReading.Download):F1}" : "—")"
                           Unit="@PreferencesService.SpeedUnit"
                           Label="@DownloadLabel()" />
        </MudTooltip>

        <div class="d-flex flex-wrap gap-6">
            <MudTooltip Text="@WebStrings.HistoryUploadTooltip"
                        Placement="Placement.Top">
                <MetricDisplay Size="MetricSize.Large" Color="@UploadColor" Icon="@Icons.Material.Filled.Upload"
                               Value="@(LatestReading != null ? $"{PreferencesService.ConvertSpeed(LatestReading.Upload):F1}" : "—")"
                               Label="@WebStrings.Format(WebStrings.UploadUnit, PreferencesService.SpeedUnit)" />
            </MudTooltip>

            <MudTooltip Text="@WebStrings.HistoryPingTooltip"
                        Placement="Placement.Top">
                <MetricDisplay Size="MetricSize.Large" Color="@PingColor" Icon="@Icons.Material.Filled.NetworkPing"
                               Value="@(LatestReading != null ? $"{LatestReading.Ping}" : "—")"
                               Label="@(LatestReading?.Jitter is { } jitter ? WebStrings.Format(WebStrings.PingMsWithJitter, jitter) : WebStrings.PingMs)" />
            </MudTooltip>
        </div>
    </div>

    <Sparkline Values="@_downloadHistory" Color="@DownloadColor" Class="mt-4" />
</MudPaper>

<div class="d-flex flex-wrap align-center justify-space-between gap-3 mb-3">
    <MudText Typo="Typo.h6" Class="font-weight-bold">@WebStrings.HistoryRecentTests</MudText>

    <div class="d-flex flex-wrap align-center gap-2">
        <MudSelect T="FilterChoice<TestStatus>" Value="_status" ValueChanged="SetStatusAsync!" ToStringFunc="@(choice => choice?.Label)"
                   Label="@WebStrings.HistoryFilterStatus" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="sw-filter">
            @foreach (var choice in StatusChoices)
            {
                <MudSelectItem T="FilterChoice<TestStatus>" Value="choice">@choice.Label</MudSelectItem>
            }
        </MudSelect>

        <MudSelect T="FilterChoice<TestType>" Value="_type" ValueChanged="SetTypeAsync!" ToStringFunc="@(choice => choice?.Label)"
                   Label="@WebStrings.HistoryFilterStartedBy" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="sw-filter">
            @foreach (var choice in TypeChoices)
            {
                <MudSelectItem T="FilterChoice<TestType>" Value="choice">@choice.Label</MudSelectItem>
            }
        </MudSelect>

        <MudSelect T="FilterChoice<bool>" Value="_healthy" ValueChanged="SetHealthAsync!" ToStringFunc="@(choice => choice?.Label)"
                   Label="@WebStrings.HistoryFilterTargets" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="sw-filter">
            @foreach (var choice in HealthChoices)
            {
                <MudSelectItem T="FilterChoice<bool>" Value="choice">@choice.Label</MudSelectItem>
            }
        </MudSelect>

        <MudTooltip Text="@(_selecting ? WebStrings.HistoryStopSelecting : WebStrings.HistorySelectResults)" Placement="Placement.Bottom">
            <MudIconButton Icon="@Icons.Material.Filled.Checklist" Color="@(_selecting ? Color.Primary : Color.Default)"
                           OnClick="ToggleSelecting" aria-label="@WebStrings.HistorySelectResults" />
        </MudTooltip>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download" OnClick="OpenExportAsync">@WebStrings.ExportButton</MudButton>
    </div>
</div>

@if (_selecting)
{
    <div class="d-flex flex-wrap align-center gap-3 mb-3">
        <MudText Typo="Typo.body2" Class="sw-muted">@WebStrings.Format(WebStrings.SelectedCount, _selected.Count)</MudText>
        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="SelectAllVisible">@WebStrings.HistorySelectAllShown</MudButton>
        <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="@(_selected.Count == 0)" OnClick="ClearSelection">@WebStrings.HistoryClearSelection</MudButton>
    </div>
}

<StateView Loading="@(_list.Loading && _list.Items.Count == 0)" Empty="@(_list.Items.Count == 0 && !_list.Loading)"
           ErrorMessage="@LoadError" OnRetry="RetryLoadAsync">
    <EmptyContent>
        @if (_list.Filter.IsActive)
        {
            <span>@WebStrings.HistoryNoMatches</span>
        }
        else
        {
            <span><FormattedText Format="@WebStrings.HistoryNoTests" Arguments="@([RunTestButtonName])" /></span>
        }
    </EmptyContent>
    <ChildContent>
        <MudList T="SpeedtestDto" Class="sw-card sw-surface mud-elevation-1 rounded-lg pa-1">
            @foreach (var group in TestGroups)
            {
                <MudListSubheader Class="sw-list-subheader">@group.Label</MudListSubheader>
                @foreach (var test in group.Tests)
                {
                    <MudListItem T="SpeedtestDto" OnClick="@(() => RowClicked(test))" Class="rounded-lg">
                        <MudGrid Spacing="2" Class="align-center">
                            <MudItem xs="6" sm="3">
                                <div class="d-flex align-center gap-2">
                                    @if (_selecting)
                                    {
                                        <MudCheckBox T="bool" Value="@_selected.Contains(test.Id)" Dense="true" Color="Color.Primary"
                                                     ValueChanged="@(value => ToggleSelected(test.Id, value))" />
                                    }
                                    <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Class="sw-muted" />
                                    <MudText Typo="Typo.body2">@PreferencesService.FormatTime(PreferencesService.ToLocal(test.Created))</MudText>
                                    @if (test.Healthy == false)
                                    {
                                        <MudTooltip Text="@TargetsTooltip(test)" Placement="Placement.Top">
                                            <MudIcon Icon="@Icons.Material.Filled.TrendingDown" Size="Size.Small" Color="Color.Warning" />
                                        </MudTooltip>
                                    }
                                </div>
                            </MudItem>

                            @if (test.Status == TestStatus.Skipped)
                            {
                                <MudItem xs="12" sm="9">
                                    <div class="d-flex align-center gap-2">
                                        <MudChip T="string" Color="Color.Default" Size="Size.Small">@WebStrings.StatusSkipped</MudChip>
                                        <MudText Typo="Typo.caption" Class="sw-muted">@test.Error</MudText>
                                    </div>
                                </MudItem>
                            }
                            else if (!string.IsNullOrEmpty(test.Error))
                            {
                                <MudItem xs="12" sm="9">
                                    <div class="d-flex align-center gap-2">
                                        <MudChip T="string" Color="Color.Error" Size="Size.Small">@WebStrings.StatusFailed</MudChip>
                                        <MudText Typo="Typo.caption" Color="Color.Error">@SpeedtestErrors.Describe(test.Error)</MudText>
                                    </div>
                                </MudItem>
                            }
                            else
                            {
                                <MudItem xs="6" sm="3">
                                    <div class="d-flex align-center gap-2">
                                        <MudIcon Icon="@Icons.Material.Filled.NetworkPing" Size="Size.Small" Color="@MetricStatus.Ping(test.Ping, Settings.Current.Targets.Ping)" />
                                        <MudText Typo="Typo.body2" Class="font-weight-medium">
                                            @test.Ping ms
                                            @if (test.Jitter is { } jitter)
                                            {
                                                <span class="sw-muted font-weight-regular" title="@WebStrings.Jitter">±@($"{jitter:F1}")</span>
                                            }
                                        </MudText>
                                    </div>
                                </MudItem>
                                <MudItem xs="6" sm="3">
                                    <div class="d-flex align-center gap-2">
                                        <MudIcon Icon="@Icons.Material.Filled.Download" Size="Size.Small" Color="@MetricStatus.Download(test.Download, Settings.Current.Targets.Download)" />
                                        <MudText Typo="Typo.body2" Class="font-weight-medium">
                                            @($"{PreferencesService.ConvertSpeed(test.Download):F1}") @PreferencesService.SpeedUnit
                                        </MudText>
                                    </div>
                                </MudItem>
                                <MudItem xs="6" sm="3">
                                    <div class="d-flex align-center gap-2">
                                        <MudIcon Icon="@Icons.Material.Filled.Upload" Size="Size.Small" Color="@MetricStatus.Upload(test.Upload, Settings.Current.Targets.Upload)" />
                                        <MudText Typo="Typo.body2" Class="font-weight-medium">
                                            @($"{PreferencesService.ConvertSpeed(test.Upload):F1}") @PreferencesService.SpeedUnit
                                        </MudText>
                                    </div>
                                </MudItem>
                            }
                        </MudGrid>
                    </MudListItem>
                }
            }
        </MudList>

        @if (_list.Loading)
        {
            <div class="text-center pa-4">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Small" />
            </div>
        }
        else if (_list.LoadMoreFailed)
        {
            <div class="d-flex flex-wrap align-center justify-center gap-3 pa-4">
                <MudText Typo="Typo.body2" Color="Color.Error">@WebStrings.HistoryLoadMoreFailed</MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="LoadMoreAsync">
                    @WebStrings.TryAgain
                </MudButton>
            </div>
        }
        else if (_list.HasMore)
        {
            <InfiniteScrollSentinel OnVisible="LoadMoreAsync" />
        }
        else
        {
            <MudText Typo="Typo.caption" Class="sw-muted text-center d-block pa-4">@WebStrings.HistoryNoMoreTests</MudText>
        }

        <MudScrollToTop TopOffset="400">
            <MudFab Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.ArrowUpward" aria-label="@WebStrings.HistoryBackToTop" />
        </MudScrollToTop>
    </ChildContent>
</StateView>

@code {
    private sealed record TestGroup(string Label, List<SpeedtestDto> Tests);

    private sealed record FilterChoice<TValue>(TValue? Value, string Label) where TValue : struct;

    private static FilterChoice<TestStatus>[] StatusChoices =>
    [
        new(null, WebStrings.AllResults),
        new(TestStatus.Completed, WebStrings.StatusCompleted),
        new(TestStatus.Failed, WebStrings.StatusFailed),
        new(TestStatus.Skipped, WebStrings.StatusSkipped)
    ];

    private static FilterChoice<TestType>[] TypeChoices =>
    [
        new(null, WebStrings.HistoryStartedByAnything),
        new(TestType.Auto, WebStrings.HistoryStartedBySchedule),
        new(TestType.Custom, WebStrings.HistoryStartedByHand)
    ];

    private static FilterChoice<bool>[] HealthChoices =>
    [
        new(null, WebStrings.HistoryTargetsAny),
        new(true, WebStrings.HistoryTargetsMet),
        new(false, WebStrings.HistoryTargetsMissed)
    ];

    private static RenderFragment RunTestButtonName => @<strong>@WebStrings.RunTestButton</strong>;

    private PagedTestList _list = null!;
    private Timer? _timer;
    private List<double> _downloadHistory = [];

    private FilterChoice<TestStatus> _status = StatusChoices[0];
    private FilterChoice<TestType> _type = TypeChoices[0];
    private FilterChoice<bool> _healthy = HealthChoices[0];

    private bool _selecting;
    private readonly HashSet<int> _selected = [];

    private SpeedtestDto? LatestReading => RecentResults.LatestCompleted;

    private string? LoadError => _list.LoadFailed
        ? (_list.Filter.IsActive ? WebStrings.HistoryFilteredLoadFailed : WebStrings.HistoryLoadFailed)
        : null;

    private Color PingColor => MetricStatus.Ping(LatestReading?.Ping, Settings.Current.Targets.Ping);
    private Color DownloadColor => MetricStatus.Download(LatestReading?.Download, Settings.Current.Targets.Download);
    private Color UploadColor => MetricStatus.Upload(LatestReading?.Upload, Settings.Current.Targets.Upload);

    private List<TestGroup> TestGroups => _list.Items
        .GroupBy(t => PreferencesService.ToLocal(t.Created).Date)
        .Select(g => new TestGroup(DayLabel(g.Key), g.ToList()))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        _list = new PagedTestList((filter, afterId, limit) => Results.ListAsync(afterId, limit, filter.Status, filter.Type, filter.Healthy));
        RecentResults.OnChange += OnRecentResultsChanged;
        RecentResults.ResultAdded += OnResultAdded;
        StatusService.OnChange += OnStateChanged;
        Settings.OnChange += OnStateChanged;
        _timer = new Timer(_ => InvokeAsync(StateHasChanged), null, 0, 10000);
        BuildDownloadHistory();

        await _list.ReloadAsync(TestFilter.None);
    }

    private void OnRecentResultsChanged()
    {
        BuildDownloadHistory();
        InvokeAsync(StateHasChanged);
    }

    private void OnResultAdded(SpeedtestDto test)
    {
        _list.Prepend(test);
        InvokeAsync(StateHasChanged);
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    private void BuildDownloadHistory()
    {
        _downloadHistory = RecentResults.Tests
            .Where(t => t.Status == TestStatus.Completed)
            .Take(20)
            .Reverse()
            .Select(t => t.Download)
            .ToList();
    }

    private Task SetStatusAsync(FilterChoice<TestStatus> value)
    {
        _status = value;
        return ReloadAsync();
    }

    private Task SetTypeAsync(FilterChoice<TestType> value)
    {
        _type = value;
        return ReloadAsync();
    }

    private Task SetHealthAsync(FilterChoice<bool> value)
    {
        _healthy = value;
        return ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _selected.Clear();
        var loading = _list.ReloadAsync(new TestFilter(_status.Value, _type.Value, _healthy.Value));
        StateHasChanged();
        await loading;
    }

    private Task RetryLoadAsync() => ReloadAsync();

    private async Task LoadMoreAsync()
    {
        var loading = _list.LoadMoreAsync();
        StateHasChanged();
        await loading;
        StateHasChanged();
    }

    private void ToggleSelecting()
    {
        _selecting = !_selecting;
        if (!_selecting) _selected.Clear();
    }

    private void ToggleSelected(int id, bool selected)
    {
        if (selected) _selected.Add(id);
        else _selected.Remove(id);
    }

    private void SelectAllVisible()
    {
        foreach (var test in _list.Items) _selected.Add(test.Id);
    }

    private void ClearSelection() => _selected.Clear();

    private async Task RowClicked(SpeedtestDto test)
    {
        if (_selecting)
        {
            ToggleSelected(test.Id, !_selected.Contains(test.Id));
            return;
        }

        await ShowTestDetail(test);
    }

    private async Task OpenExportAsync()
    {
        var parameters = new DialogParameters<ExportDialog>
        {
            { x => x.Status, _status.Value },
            { x => x.Type, _type.Value },
            { x => x.Healthy, _healthy.Value },
            { x => x.SelectedIds, _selected.ToList() }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall, FullWidth = true };
        await DialogService.ShowAsync<ExportDialog>(WebStrings.HistoryExportDialogTitle, parameters, options);
    }

    private string TargetsTooltip(SpeedtestDto test)
    {
        var parts = new List<string>();
        if (test.ThresholdPing is { } ping) parts.Add(WebStrings.Format(WebStrings.HistoryTargetPing, ping));
        if (test.ThresholdDownload is { } download) parts.Add(WebStrings.Format(WebStrings.HistoryTargetDownload, PreferencesService.ConvertSpeed(download), PreferencesService.SpeedUnit));
        if (test.ThresholdUpload is { } upload) parts.Add(WebStrings.Format(WebStrings.HistoryTargetUpload, PreferencesService.ConvertSpeed(upload), PreferencesService.SpeedUnit));
        return parts.Count > 0 ? WebStrings.Format(WebStrings.HistoryMissedTargetsList, string.Join(", ", parts)) : WebStrings.MissedYourTargets;
    }

    private string DownloadLabel() =>
        LatestReading != null
            ? WebStrings.Format(WebStrings.HistoryDownloadSpeedLastTest, DisplayFormat.ToRelativeTime(TimeZones.ParseUtcTimestamp(LatestReading.Created)))
            : WebStrings.DownloadSpeed;

    private string DayLabel(DateTime day)
    {
        var today = PreferencesService.Now.Date;
        if (day == today) return WebStrings.HistoryToday;
        if (day == today.AddDays(-1)) return WebStrings.HistoryYesterday;
        return day.ToString(day.Year == today.Year ? "dddd, d MMMM" : "dddd, d MMMM yyyy", CultureInfo.CurrentCulture);
    }

    private async Task ShowTestDetail(SpeedtestDto test)
    {
        var parameters = new DialogParameters<TestDetailDialog> { { x => x.Test, test } };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<TestDetailDialog>(WebStrings.HistoryTestDetailsDialogTitle, parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            _list.Remove(test.Id);
            _selected.Remove(test.Id);
        }
    }

    private string HeroClass() => StatusService.Running ? "sw-card sw-running" : "sw-card";

    public void Dispose()
    {
        RecentResults.OnChange -= OnRecentResultsChanged;
        RecentResults.ResultAdded -= OnResultAdded;
        StatusService.OnChange -= OnStateChanged;
        Settings.OnChange -= OnStateChanged;
        _timer?.Dispose();
    }
}
