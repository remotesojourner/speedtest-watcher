@page "/settings"
@page "/settings/{Section}"
@using SpeedtestWatcher.Web.Ui.Pages.Settings
@inject NavigationManager Navigation
@inject ICurrentAccess Access

<PageTitle>@ProjectInfo.Name - @WebStrings.SettingsTitle</PageTitle>

@if (!Access.HasFullAccess)
{
    <PageHeader Title="@WebStrings.SettingsTitle" Subtitle="@WebStrings.SettingsReadOnlySubtitle" />

    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-6">
        <div class="d-flex flex-wrap align-center justify-space-between gap-3">
            <span>@WebStrings.SettingsReadOnlySignIn</span>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Login" OnClick="SignIn">
                @WebStrings.SignIn
            </MudButton>
        </div>
    </MudAlert>

    <SettingsDisplay />
}
else
{
    <PageHeader Title="@WebStrings.SettingsTitle" Subtitle="@WebStrings.SettingsSubtitle" />

    <MudBreakpointProvider OnBreakpointChanged="OnBreakpointChanged">
        <MudTabs Position="@_tabPosition" Rounded="true" ApplyEffectsToContainer="true"
                 Class="sw-settings-tabs" TabPanelsClass="sw-settings-panels"
                 ActivePanelIndex="_activeIndex" ActivePanelIndexChanged="OnTabChanged">
            <MudTabPanel Text="@WebStrings.SettingsTabGeneral" Icon="@Icons.Material.Filled.Tune">
                <SettingsGeneral />
            </MudTabPanel>
            <MudTabPanel Text="@WebStrings.SettingsTabSchedule" Icon="@Icons.Material.Filled.Schedule">
                <SettingsSchedule />
            </MudTabPanel>
            <MudTabPanel Text="@WebStrings.SettingsTabProvider" Icon="@Icons.Material.Filled.Speed">
                <SettingsProvider />
            </MudTabPanel>
            <MudTabPanel Text="@WebStrings.SettingsTabDisplay" Icon="@Icons.Material.Filled.DisplaySettings">
                <SettingsDisplay />
            </MudTabPanel>
            <MudTabPanel Text="@WebStrings.SettingsTabMonitoring" Icon="@Icons.Material.Filled.MonitorHeart">
                <SettingsMonitoring />
            </MudTabPanel>
            <MudTabPanel Text="@WebStrings.SettingsTabIntegrations" Icon="@Icons.Material.Filled.Hub">
                <SettingsIntegrations />
            </MudTabPanel>
            <MudTabPanel Text="@WebStrings.SettingsTabSecurity" Icon="@Icons.Material.Filled.Security">
                <SettingsSecurity />
            </MudTabPanel>
            <MudTabPanel Text="@WebStrings.SettingsTabStorage" Icon="@Icons.Material.Filled.Storage">
                <SettingsStorage />
            </MudTabPanel>
            <MudTabPanel Text="@WebStrings.SettingsTabAbout" Icon="@Icons.Material.Filled.Info">
                <SettingsAbout />
            </MudTabPanel>
        </MudTabs>
    </MudBreakpointProvider>
}

@code {
    private static readonly string[] _sections = ["general", "schedule", "provider", "display", "monitoring", "integrations", "security", "storage", "about"];

    [Parameter] public string? Section { get; set; }

    private int _activeIndex;
    private Position _tabPosition = Position.Left;

    protected override void OnParametersSet()
    {
        var index = Array.IndexOf(_sections, Section?.ToLowerInvariant());
        _activeIndex = index >= 0 ? index : 0;
    }

    private void OnBreakpointChanged(Breakpoint breakpoint) =>
        _tabPosition = breakpoint is Breakpoint.Xs or Breakpoint.Sm ? Position.Top : Position.Left;

    private void OnTabChanged(int index)
    {
        if (index < 0 || index >= _sections.Length) return;

        _activeIndex = index;
        Navigation.NavigateTo($"/settings/{_sections[index]}");
    }

    private void SignIn()
    {
        var returnUrl = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.NavigateTo($"/auth/login?returnUrl={Uri.EscapeDataString(returnUrl)}", forceLoad: true);
    }
}
