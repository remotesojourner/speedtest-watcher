@page "/welcome"
@inject SettingsState Settings
@inject IEnumerable<ISpeedtestTool> Tools
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>@ProjectInfo.Name - @WebStrings.WelcomePageTitle</PageTitle>

<div class="d-flex justify-center mt-6">
    <SurfaceCard FullHeight="false" Class="sw-welcome-card">
        <MudProgressLinear Color="Color.Primary" Value="@ProgressValue" Rounded="true" Class="mb-2" />
        <MudText Typo="Typo.caption" Class="sw-muted d-block mb-5">@WebStrings.Format(WebStrings.WelcomeStep, _step + 1, Steps.Count)</MudText>

        @switch (CurrentStep)
        {
            case WelcomeStep.Greeting:
                <img src="img/logo.svg" alt="" class="sw-welcome-logo mb-4" />
                <MudText Typo="Typo.h5" Class="font-weight-bold mb-1">@WebStrings.Format(WebStrings.WelcomeTitle, ProjectInfo.Name)</MudText>
                <MudText Typo="Typo.body1" Class="sw-muted">@WebStrings.Format(WebStrings.WelcomeIntro, ProjectInfo.Name)</MudText>
                break;

            case WelcomeStep.Provider:
                <MudText Typo="Typo.h5" Class="font-weight-bold mb-1">@WebStrings.WelcomeProviderTitle</MudText>
                <MudText Typo="Typo.body2" Class="sw-muted mb-4">@WebStrings.WelcomeProviderDescription</MudText>
                <div class="sw-option-grid">
                    @foreach (var tool in Tools)
                    {
                        <OptionCard Title="@tool.Title" Description="@tool.Description" Image="@tool.ImagePath()"
                                    Active="@(_provider == tool.Provider)" OnClick="@(() => _provider = tool.Provider)" />
                    }
                </div>
                break;

            case WelcomeStep.OptimalValues:
                <MudText Typo="Typo.h5" Class="font-weight-bold mb-1">@WebStrings.WelcomeTargetsTitle</MudText>
                <MudText Typo="Typo.body2" Class="sw-muted mb-4">@WebStrings.WelcomeTargetsDescription</MudText>
                <MudGrid Spacing="3">
                    <MudItem xs="12" sm="4">
                        <MudNumericField T="double" @bind-Value="_ping" Label="@WebStrings.PingTargetLabel" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudNumericField T="double" @bind-Value="_download" Label="@WebStrings.DownloadTargetLabel" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudNumericField T="double" @bind-Value="_upload" Label="@WebStrings.UploadTargetLabel" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                </MudGrid>
                break;

            case WelcomeStep.License:
                <MudText Typo="Typo.h5" Class="font-weight-bold mb-1">@WebStrings.WelcomeTermsTitle</MudText>
                <MudText Typo="Typo.body2" Class="sw-muted mb-4">@WebStrings.Format(WebStrings.WelcomeTermsDescription, ProjectInfo.Name)</MudText>
                <div class="sw-option-list mb-4">
                    @foreach (var document in LicenseDocuments)
                    {
                        <MudLink Href="@document.Url" Target="_blank" Class="sw-option" Underline="Underline.None">
                            <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" Class="sw-option-icon" />
                            <span class="sw-option-text">@document.Title</span>
                            <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" Class="sw-option-icon" />
                        </MudLink>
                    }
                </div>
                <MudCheckBox T="bool" @bind-Value="_acceptedTerms" Color="Color.Primary" Label="@WebStrings.WelcomeAcceptTerms" />
                break;
        }

        <div class="d-flex justify-space-between align-center mt-6">
            <MudButton Variant="Variant.Text" Disabled="@(_step == 0 || _saving)" OnClick="@(() => _step--)">@WebStrings.WelcomeBack</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!CanContinue)" OnClick="ContinueAsync">
                @(IsLastStep ? (_saving ? WebStrings.Saving : WebStrings.WelcomeDone) : WebStrings.WelcomeContinue)
            </MudButton>
        </div>
    </SurfaceCard>
</div>

@code {
    private enum WelcomeStep { Greeting, Provider, OptimalValues, License }

    private static (string Title, string Url)[] LicenseDocuments =>
    [
        (WebStrings.OoklaTermsOfService, OoklaTerms.TermsOfServiceUrl),
        (WebStrings.OoklaEula, OoklaTerms.EulaUrl),
        (WebStrings.OoklaPrivacyPolicy, OoklaTerms.PrivacyPolicyUrl)
    ];

    private int _step;
    private SpeedtestProvider _provider = SpeedtestProvider.Ookla;
    private double _ping;
    private double _download;
    private double _upload;
    private bool _acceptedTerms;
    private bool _saving;

    private List<WelcomeStep> Steps => _provider == SpeedtestProvider.Ookla
        ? [WelcomeStep.Greeting, WelcomeStep.Provider, WelcomeStep.OptimalValues, WelcomeStep.License]
        : [WelcomeStep.Greeting, WelcomeStep.Provider, WelcomeStep.OptimalValues];

    private WelcomeStep CurrentStep => Steps[Math.Min(_step, Steps.Count - 1)];

    private bool IsLastStep => _step >= Steps.Count - 1;

    private double ProgressValue => (_step + 1) * 100.0 / Steps.Count;

    private bool CanContinue => !_saving && (CurrentStep != WelcomeStep.License || _acceptedTerms);

    protected override void OnInitialized()
    {
        var saved = Settings.Current;
        if (saved.Provider.Selected != SpeedtestProvider.None) _provider = saved.Provider.Selected;
        _ping = saved.Targets.Ping ?? 0;
        _download = saved.Targets.Download ?? 0;
        _upload = saved.Targets.Upload ?? 0;
    }

    private async Task ContinueAsync()
    {
        if (!IsLastStep)
        {
            _step++;
            return;
        }

        _saving = true;
        var result = await Settings.SaveAsync(
            ("provider", _provider.ToName()),
            ("ping", SettingNumber.Format(_ping)),
            ("download", SettingNumber.Format(_download)),
            ("upload", SettingNumber.Format(_upload)));
        _saving = false;

        if (!result.Succeeded)
        {
            Snackbar.Add(result.Message ?? SettingsState.SaveFailed, Severity.Error);
            return;
        }

        Snackbar.Add(WebStrings.Format(WebStrings.WelcomeFinished, ProjectInfo.Name), Severity.Success);
        Navigation.NavigateTo("/");
    }
}
