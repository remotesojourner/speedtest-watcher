@inject HttpClient Http
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="font-weight-bold mb-2">Results</MudText>
        <div class="sw-option-list mb-4">
            <OptionCard Title="Shown results" Description="@ShownDescription" Icon="@Icons.Material.Filled.FilterList"
                        Active="@(_scope == ExportScope.Shown)" OnClick="@(() => _scope = ExportScope.Shown)" />
            <OptionCard Title="Selected results" Description="@SelectedDescription" Icon="@Icons.Material.Filled.Checklist"
                        Active="@(_scope == ExportScope.Selected)" Disabled="@(SelectedIds.Count == 0)"
                        OnClick="@(() => _scope = ExportScope.Selected)" />
            <OptionCard Title="All results" Description="@AllDescription" Icon="@Icons.Material.Filled.AllInclusive"
                        Active="@(_scope == ExportScope.All)" OnClick="@(() => _scope = ExportScope.All)" />
        </div>

        <MudText Typo="Typo.body2" Class="font-weight-bold mb-2">Format</MudText>
        <div class="sw-option-grid">
            <OptionCard Title="CSV" Description="Opens in a spreadsheet" Icon="@Icons.Material.Filled.TableChart"
                        Active="@(_format == "csv")" OnClick="@(() => _format = "csv")" />
            <OptionCard Title="JSON" Description="Can be imported again" Icon="@Icons.Material.Filled.DataObject"
                        Active="@(_format == "json")" OnClick="@(() => _format = "json")" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Download"
                   Disabled="@(_exporting || ExportCount == 0)" OnClick="ExportAsync">
            @(_exporting ? "Exporting..." : "Export")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private enum ExportScope { Shown, Selected, All }

    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    // The History filters as the API takes them; null means that filter isn't applied.
    [Parameter] public string? Status { get; set; }
    [Parameter] public string? Type { get; set; }
    [Parameter] public bool? Healthy { get; set; }
    [Parameter] public IReadOnlyCollection<int> SelectedIds { get; set; } = [];

    private ExportScope _scope = ExportScope.Shown;
    private string _format = "csv";
    private int? _shownCount;
    private int? _allCount;
    private bool _exporting;

    private bool FiltersActive => Status != null || Type != null || Healthy != null;

    private string ShownDescription => _shownCount is not { } count
        ? "Counting..."
        : FiltersActive ? $"{Results(count)} matching the current filters" : $"No filters applied, so all {Results(count)}";

    private string SelectedDescription => SelectedIds.Count == 0
        ? "Select results in the list first"
        : $"{SelectedIds.Count} selected";

    private string AllDescription => _allCount is { } count ? Results(count) : "Counting...";

    private int? ExportCount => _scope switch
    {
        ExportScope.Selected => SelectedIds.Count,
        ExportScope.All => _allCount,
        _ => _shownCount
    };

    protected override async Task OnInitializedAsync()
    {
        if (SelectedIds.Count > 0) _scope = ExportScope.Selected;

        _shownCount = await CountAsync(Status, Type, Healthy);
        _allCount = FiltersActive ? await CountAsync(null, null, null) : _shownCount;
    }

    private async Task<int?> CountAsync(string? status, string? type, bool? healthy)
    {
        var query = new List<string>();
        if (status != null) query.Add($"status={Uri.EscapeDataString(status)}");
        if (type != null) query.Add($"type={Uri.EscapeDataString(type)}");
        if (healthy != null) query.Add($"healthy={(healthy.Value ? "true" : "false")}");

        try
        {
            var result = await Http.GetFromJsonAsync<CountResult>($"/api/speedtests/count?{string.Join("&", query)}");
            return result?.Count;
        }
        catch
        {
            return null;
        }
    }

    private async Task ExportAsync()
    {
        var request = _scope switch
        {
            ExportScope.Selected => new ExportRequest { Format = _format, Ids = SelectedIds.ToList() },
            ExportScope.All => new ExportRequest { Format = _format },
            _ => new ExportRequest { Format = _format, Status = Status, Type = Type, Healthy = Healthy }
        };

        _exporting = true;
        try
        {
            using var response = await Http.PostAsJsonAsync("/api/speedtests/export", request);
            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add("Could not export the results", Severity.Error);
                return;
            }

            var scopeName = _scope.ToString().ToLowerInvariant();
            var fileName = $"speedtests-{scopeName}-{DateTime.Now:yyyyMMdd-HHmm}.{_format}";
            await using var stream = await response.Content.ReadAsStreamAsync();
            using var streamReference = new DotNetStreamReference(stream);
            await JS.InvokeVoidAsync("speedtestWatcherInterop.downloadFileFromStream", fileName, streamReference);

            Snackbar.Add($"Exported {Results(ExportCount ?? 0)}", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch
        {
            Snackbar.Add("Could not export the results", Severity.Error);
        }
        finally
        {
            _exporting = false;
        }
    }

    private static string Results(int count) => count == 1 ? "1 result" : $"{count} results";

    private sealed record CountResult(int Count);
}
