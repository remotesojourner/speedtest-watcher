@inject ProviderOptionsService ProviderOptions
@inject SpeedtestRunService Runs
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="sw-muted mb-3">
            Runs one test against the server you pick here. Your saved server settings aren't changed.
        </MudText>

        <MudSelect T="string" @bind-Value="_serverId" Label="Server" Variant="Variant.Outlined" Margin="Margin.Dense"
                   Disabled="_loading" HelperText="@ServerListHelp">
            @foreach (var server in _servers)
            {
                <MudSelectItem T="string" Value="@server.Id">@server.OptionLabel</MudSelectItem>
            }
        </MudSelect>

        <MudTextField T="string" @bind-Value="_serverId" Label="Server ID" Placeholder="e.g. 12345"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Class="mt-3"
                      Error="@(!ServerIdValid)" ErrorText="Server IDs are numbers"
                      HelperText="Or type an ID that isn't listed" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!CanRun)" OnClick="RunAsync">Run test</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public SpeedtestProvider Provider { get; set; } = SpeedtestProvider.Ookla;

    private sealed record ServerOption(string Id, string OptionLabel);

    private List<ServerOption> _servers = [];
    private string _serverId = "";
    private bool _loading = true;
    private bool _running;
    private bool _serversUnavailable;

    private string ServerListHelp => _loading
        ? "Loading servers..."
        : _serversUnavailable ? "Couldn't load the server list. Enter a server ID below." : "Nearest servers are listed first";

    private bool ServerIdValid => string.IsNullOrWhiteSpace(_serverId) || _serverId.Trim().All(char.IsDigit);

    private bool CanRun => !_running && !string.IsNullOrWhiteSpace(_serverId) && ServerIdValid;

    protected override async Task OnInitializedAsync()
    {
        var result = await ProviderOptions.GetServersAsync(Provider.ToName());
        _serversUnavailable = result.Value == null;
        _servers = ServerLabels.NearestFirst(result.Value ?? []).Select(server => new ServerOption(server.Id, ServerLabels.For(server))).ToList();
        _loading = false;
    }

    private async Task RunAsync()
    {
        _running = true;
        var result = await Runs.StartManualRunAsync(_serverId.Trim());
        _running = false;

        if (!result.Succeeded)
        {
            Snackbar.Add(result.Message ?? "Could not start the speedtest", Severity.Error);
            return;
        }

        Snackbar.Add("Speedtest started", Severity.Success);
        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Cancel() => MudDialog.Cancel();
}
