@page "/settings"
@page "/settings/{Section}"
@using SpeedtestWatcher.Web.Components.Pages.Settings
@inject NavigationManager Navigation
@inject ConfigStateService ConfigService

<PageTitle>Speedtest Watcher - Settings</PageTitle>

@if (ConfigService.CurrentConfig.ViewMode)
{
    <PageHeader Title="Settings" Subtitle="This instance is read-only. Display preferences are saved in this browser." />

    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-6">
        <div class="d-flex flex-wrap align-center justify-space-between gap-3">
            <span>Sign in to change the schedule, provider, integrations and storage.</span>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Login" OnClick="SignIn">
                Sign in
            </MudButton>
        </div>
    </MudAlert>

    <SettingsDisplay />
}
else
{
    <PageHeader Title="Settings" Subtitle="Schedule, provider, display, integrations, security, storage and app info." />

    <MudBreakpointProvider OnBreakpointChanged="OnBreakpointChanged">
        <MudTabs Position="@_tabPosition" Rounded="true" ApplyEffectsToContainer="true"
                 Class="sw-settings-tabs" TabPanelsClass="sw-settings-panels"
                 ActivePanelIndex="_activeIndex" ActivePanelIndexChanged="OnTabChanged">
            <MudTabPanel Text="General" Icon="@Icons.Material.Filled.Tune">
                <SettingsGeneral />
            </MudTabPanel>
            <MudTabPanel Text="Schedule" Icon="@Icons.Material.Filled.Schedule">
                <SettingsSchedule />
            </MudTabPanel>
            <MudTabPanel Text="Provider" Icon="@Icons.Material.Filled.Speed">
                <SettingsProvider />
            </MudTabPanel>
            <MudTabPanel Text="Display" Icon="@Icons.Material.Filled.DisplaySettings">
                <SettingsDisplay />
            </MudTabPanel>
            <MudTabPanel Text="Integrations" Icon="@Icons.Material.Filled.Hub">
                <SettingsIntegrations />
            </MudTabPanel>
            <MudTabPanel Text="Security" Icon="@Icons.Material.Filled.Security">
                <SettingsSecurity />
            </MudTabPanel>
            <MudTabPanel Text="Storage" Icon="@Icons.Material.Filled.Storage">
                <SettingsStorage />
            </MudTabPanel>
            <MudTabPanel Text="About" Icon="@Icons.Material.Filled.Info">
                <SettingsAbout />
            </MudTabPanel>
        </MudTabs>
    </MudBreakpointProvider>
}

@code {
    private static readonly string[] Sections = ["general", "schedule", "provider", "display", "integrations", "security", "storage", "about"];

    [Parameter] public string? Section { get; set; }

    private int _activeIndex;
    private Position _tabPosition = Position.Left;

    protected override void OnParametersSet()
    {
        var index = Array.IndexOf(Sections, Section?.ToLowerInvariant());
        _activeIndex = index >= 0 ? index : 0;
    }

    private void OnBreakpointChanged(Breakpoint breakpoint) =>
        _tabPosition = breakpoint is Breakpoint.Xs or Breakpoint.Sm ? Position.Top : Position.Left;

    private void OnTabChanged(int index)
    {
        _activeIndex = index;
        Navigation.NavigateTo($"/settings/{Sections[index]}");
    }

    private void SignIn()
    {
        var returnUrl = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.NavigateTo($"/auth/login?returnUrl={Uri.EscapeDataString(returnUrl)}", forceLoad: true);
    }
}
