@using System.Globalization
@using System.Text
@using System.Text.Json
@inject HttpClient Http
@inject ConfigStateService ConfigService
@inject SpeedtestStateService SpeedtestService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudGrid Spacing="4">
    <MudItem xs="12" md="6">
        <SurfaceCard Icon="@Icons.Material.Filled.Storage" Title="Database">
            @if (_storageInfo != null)
            {
                <DataRow Label="Stored tests" Value="@_storageInfo.TestCount.ToString("N0", CultureInfo.CurrentCulture)" />
                <DataRow Label="Database size" Value="@FormatSize(_storageInfo.Size)" />
            }
            else
            {
                <StateView Loading="true" Compact="true" />
            }
        </SurfaceCard>
    </MudItem>

    <MudItem xs="12" md="6">
        <SurfaceCard Icon="@Icons.Material.Filled.History" Title="Data Retention"
                     Description="How long results are kept before they're deleted automatically.">
            <MudSelect T="string" @bind-Value="_retentionChoice" Label="Keep speedtests for" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3">
                @foreach (var preset in RetentionPresets)
                {
                    <MudSelectItem T="string" Value="@preset.Days.ToString(CultureInfo.InvariantCulture)">@preset.Label</MudSelectItem>
                }
                <MudSelectItem T="string" Value="@CustomChoice">Custom...</MudSelectItem>
            </MudSelect>
            @if (_retentionChoice == CustomChoice)
            {
                <MudNumericField T="int" @bind-Value="_customDays" Label="Days" Min="0" Max="10000" Variant="Variant.Outlined" Margin="Margin.Dense"
                                 Immediate="true" HelperText="0 keeps results forever"
                                 Error="@(SelectedRetentionDays == null)" ErrorText="Enter 0 to 10000 days" Class="mb-3" />
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!RetentionDirty)" OnClick="SaveRetentionAsync">
                Save Retention
            </MudButton>
        </SurfaceCard>
    </MudItem>

    <MudItem xs="12" md="6">
        <SurfaceCard Icon="@Icons.Material.Filled.Speed" Title="Speedtest Results"
                     Description="Export your results, or import results exported from Speedtest Watcher.">
            <div class="d-flex flex-wrap gap-2">
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.TableChart" OnClick="@(() => ExportTestsAsync("csv"))">
                    Export CSV
                </MudButton>
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.DataObject" OnClick="@(() => ExportTestsAsync("json"))">
                    Export JSON
                </MudButton>
                <MudFileUpload T="IBrowserFile" @ref="_testsUpload" Accept=".json" MaxFileSize="MaxImportBytes" FilesChanged="ImportTestsAsync">
                    <SelectedTemplate />
                    <CustomContent>
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.UploadFile" Disabled="_importing"
                                   OnClick="@(() => _testsUpload!.OpenFilePickerAsync())">
                            Import JSON
                        </MudButton>
                    </CustomContent>
                </MudFileUpload>
            </div>
        </SurfaceCard>
    </MudItem>

    <MudItem xs="12" md="6">
        <SurfaceCard Icon="@Icons.Material.Filled.Backup" Title="Settings Backup"
                     Description="Settings, integrations and recommendations as a JSON file.">
            <div class="d-flex flex-wrap gap-2">
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download" OnClick="ExportConfigAsync">
                    Export settings
                </MudButton>
                <MudFileUpload T="IBrowserFile" @ref="_configUpload" Accept=".json" MaxFileSize="MaxImportBytes" FilesChanged="ImportConfigAsync">
                    <SelectedTemplate />
                    <CustomContent>
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.UploadFile" Disabled="_importing"
                                   OnClick="@(() => _configUpload!.OpenFilePickerAsync())">
                            Import settings
                        </MudButton>
                    </CustomContent>
                </MudFileUpload>
            </div>
        </SurfaceCard>
    </MudItem>

    <MudItem xs="12">
        <SurfaceCard Icon="@Icons.Material.Filled.Warning" Title="Danger Zone" Danger="true" FullHeight="false"
                     Description="Permanent operations. They cannot be undone.">
            <div class="d-flex flex-wrap gap-3">
                <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.DeleteForever" OnClick="ClearHistoryAsync">
                    Clear history
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.RestartAlt" OnClick="FactoryResetAsync">
                    Factory reset
                </MudButton>
            </div>
        </SurfaceCard>
    </MudItem>
</MudGrid>

@code {
    private const string CustomChoice = "custom";
    private const long MaxImportBytes = 50 * 1024 * 1024;

    private static readonly (int Days, string Label)[] RetentionPresets =
    [
        (7, "7 days"),
        (30, "30 days"),
        (90, "90 days"),
        (180, "180 days"),
        (365, "1 year (default)"),
        (0, "Keep forever")
    ];

    private StorageInfoDto? _storageInfo;
    private MudFileUpload<IBrowserFile>? _testsUpload;
    private MudFileUpload<IBrowserFile>? _configUpload;
    private string _retentionChoice = "365";
    private int _customDays = 365;
    private bool _importing;

    private int SavedRetentionDays =>
        int.TryParse(ConfigService.CurrentConfig.RetentionDays, NumberStyles.Integer, CultureInfo.InvariantCulture, out var days) ? days : 365;

    private int? SelectedRetentionDays => _retentionChoice == CustomChoice
        ? (_customDays is >= 0 and <= 10000 ? _customDays : null)
        : int.Parse(_retentionChoice, CultureInfo.InvariantCulture);

    private bool RetentionDirty => SelectedRetentionDays is { } days && days != SavedRetentionDays;

    protected override async Task OnInitializedAsync()
    {
        ResetRetentionFromConfig();
        await LoadStorageInfoAsync();
    }

    private void ResetRetentionFromConfig()
    {
        var days = SavedRetentionDays;
        _retentionChoice = RetentionPresets.Any(p => p.Days == days) ? days.ToString(CultureInfo.InvariantCulture) : CustomChoice;
        _customDays = days;
    }

    private async Task LoadStorageInfoAsync()
    {
        try
        {
            _storageInfo = await Http.GetFromJsonAsync<StorageInfoDto>("/api/storage");
        }
        catch { }
    }

    private async Task SaveRetentionAsync()
    {
        if (SelectedRetentionDays is not { } days) return;

        var value = days.ToString(CultureInfo.InvariantCulture);
        try
        {
            var response = await Http.PatchAsJsonAsync("/api/config/retentionDays", new UpdateConfigKeyRequest { Value = value });
            if (response.IsSuccessStatusCode)
            {
                ConfigService.CurrentConfig["retentionDays"] = value;
                Snackbar.Add("Retention period updated", Severity.Success);
                return;
            }
        }
        catch { }

        Snackbar.Add("Your changes were not applied. Check your input.", Severity.Error);
    }

    private Task ExportTestsAsync(string format) =>
        DownloadAsync($"/api/storage/tests/history/{format}", $"speedtests.{format}", format == "json" ? "application/json" : "text/csv");

    private Task ExportConfigAsync() =>
        DownloadAsync("/api/storage/config", "speedtest-watcher-settings.json", "application/json");

    private async Task DownloadAsync(string url, string fileName, string contentType)
    {
        try
        {
            var bytes = await Http.GetByteArrayAsync(url);
            await JS.InvokeVoidAsync("speedtestWatcherInterop.downloadFileFromBytes", fileName, contentType, Convert.ToBase64String(bytes));
            Snackbar.Add($"Exported {fileName}", Severity.Success);
        }
        catch
        {
            Snackbar.Add("Export failed", Severity.Error);
        }
    }

    private async Task ImportTestsAsync(IBrowserFile? file)
    {
        var json = await ReadJsonAsync(file, JsonValueKind.Array);
        if (json == null)
        {
            Snackbar.Add("That file isn't a Speedtest Watcher test export", Severity.Error);
            return;
        }

        if (await PutJsonAsync("/api/storage/tests/history", json))
        {
            Snackbar.Add("The tests have been imported", Severity.Success);
            await LoadStorageInfoAsync();
            await ReloadTestListAsync();
        }
        else
        {
            Snackbar.Add("An error occurred while importing the tests", Severity.Error);
        }
    }

    private async Task ImportConfigAsync(IBrowserFile? file)
    {
        var json = await ReadJsonAsync(file, JsonValueKind.Object);
        if (json == null)
        {
            Snackbar.Add("That file isn't a Speedtest Watcher settings export", Severity.Error);
            return;
        }

        if (await PutJsonAsync("/api/storage/config", json))
        {
            try
            {
                var cfg = await Http.GetFromJsonAsync<ConfigDto>("/api/config");
                if (cfg != null) ConfigService.SetConfig(cfg);
            }
            catch { }

            ResetRetentionFromConfig();
            Snackbar.Add("The settings have been imported", Severity.Success);
        }
        else
        {
            Snackbar.Add("An error occurred while importing the configuration", Severity.Error);
        }
    }

    private async Task<string?> ReadJsonAsync(IBrowserFile? file, JsonValueKind expectedRoot)
    {
        if (file == null) return null;

        _importing = true;
        try
        {
            await using var stream = file.OpenReadStream(MaxImportBytes);
            using var reader = new StreamReader(stream, Encoding.UTF8);
            var text = await reader.ReadToEndAsync();
            using var document = JsonDocument.Parse(text);
            return document.RootElement.ValueKind == expectedRoot ? text : null;
        }
        catch
        {
            return null;
        }
        finally
        {
            _importing = false;
        }
    }

    private async Task<bool> PutJsonAsync(string url, string json)
    {
        try
        {
            using var content = new StringContent(json, Encoding.UTF8, "application/json");
            var response = await Http.PutAsync(url, content);
            return response.IsSuccessStatusCode;
        }
        catch
        {
            return false;
        }
    }

    private async Task ReloadTestListAsync()
    {
        try
        {
            var tests = await Http.GetFromJsonAsync<List<SpeedtestDto>>("/api/speedtests?limit=30");
            if (tests != null) SpeedtestService.SetTests(tests, tests.Count >= 30);
        }
        catch { }
    }

    private async Task ClearHistoryAsync()
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Clear history",
            "Delete all stored speedtest results? This cannot be undone.",
            yesText: "Delete all", cancelText: "Cancel");
        if (confirmed != true) return;

        try
        {
            var response = await Http.DeleteAsync("/api/storage/tests/history");
            if (response.IsSuccessStatusCode)
            {
                SpeedtestService.SetTests([], false);
                await LoadStorageInfoAsync();
                Snackbar.Add("The history has been cleared", Severity.Success);
                return;
            }
        }
        catch { }

        Snackbar.Add("Could not clear the history", Severity.Error);
    }

    private async Task FactoryResetAsync()
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Factory reset",
            "Reset all settings (including the password) and remove every integration? Your speedtest results are kept.",
            yesText: "Reset", cancelText: "Cancel");
        if (confirmed != true) return;

        try
        {
            var response = await Http.DeleteAsync("/api/storage/config");
            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/", forceLoad: true);
                return;
            }
        }
        catch { }

        Snackbar.Add("Could not reset the settings", Severity.Error);
    }

    private static string FormatSize(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:F1} KB",
        _ => $"{bytes / (1024.0 * 1024.0):F1} MB"
    };
}
