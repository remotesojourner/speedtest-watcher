@inject ApiClient Api
@inject IConfiguration Configuration

<MudGrid Spacing="4">
    <MudItem xs="12" md="@(RepositoryUrl != null ? 6 : 12)">
        <SurfaceCard>
            <div class="d-flex align-center gap-3 mb-3">
                <img src="img/logo.svg" style="width:48px;height:48px;object-fit:contain;" alt="" />
                <div>
                    <MudText Typo="Typo.h6" Class="font-weight-bold">Speedtest Watcher</MudText>
                    <MudText Typo="Typo.body2" Class="sw-muted">v@(ProjectInfo.Version)</MudText>
                </div>
            </div>
            @if (RepositoryUrl != null && _version != null && _version.Remote != "0" && _version.Remote != _version.Local)
            {
                <MudAlert Severity="Severity.Success" Class="mb-3">
                    Update available: v@_version.Remote
                    <MudLink Href="@($"{RepositoryUrl}/releases")" Target="_blank" Class="ml-2">Changelog</MudLink>
                </MudAlert>
            }
            else if (RepositoryUrl != null && _versionChecked && (_version == null || _version.Remote == "0"))
            {
                <MudText Typo="Typo.caption" Class="sw-muted d-block mb-3">Couldn't check for updates.</MudText>
            }
            <MudText Typo="Typo.body2" Class="sw-muted">
                A self-hosted speed test manager that periodically tests your internet connection and logs results to monitor your ISP performance.
            </MudText>
        </SurfaceCard>
    </MudItem>

    @if (RepositoryUrl != null)
    {
        <MudItem xs="12" md="6">
            <SurfaceCard Icon="@Icons.Material.Filled.Link" Title="Links">
                <div class="d-flex flex-wrap gap-2">
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Code" Href="@RepositoryUrl" Target="_blank">GitHub</MudButton>
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.NewReleases" Href="@($"{RepositoryUrl}/releases")" Target="_blank">Releases</MudButton>
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.BugReport" Href="@($"{RepositoryUrl}/issues")" Target="_blank">Report an issue</MudButton>
                </div>
            </SurfaceCard>
        </MudItem>
    }
</MudGrid>

@code {
    private VersionInfoDto? _version;
    private bool _versionChecked;

    private string? RepositoryUrl => ProjectInfo.RepositoryUrl(Configuration);

    protected override async Task OnInitializedAsync()
    {
        _version = (await Api.GetAsync<VersionInfoDto>("/api/info/version")).Value;
        _versionChecked = true;
    }
}
